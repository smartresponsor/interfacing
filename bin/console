#!/usr/bin/env php
<?php

declare(strict_types=1);

/* Copyright (c) 2025 Oleksandr Tishchenko / Marketing America Corp */

use App\Interfacing\InterfaceKernel;
use Symfony\Bundle\FrameworkBundle\Console\Application;

require dirname(__DIR__).'/config/bootstrap.php';

$environment = $_SERVER['APP_ENV'] ?? $_ENV['APP_ENV'] ?? 'dev';
$debugRaw = $_SERVER['APP_DEBUG'] ?? $_ENV['APP_DEBUG'] ?? '1';
$debug = !in_array(strtolower((string) $debugRaw), ['0', 'false', 'off', 'no'], true);

$kernel = new InterfaceKernel((string) $environment, $debug);
$application = new Application($kernel);
$application->run();
