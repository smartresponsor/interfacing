{% extends 'interfacing/crud/workbench_base.html.twig' %}

{% block title %}{{ workbench.title }}{% endblock %}

{% block crud_workbench_body %}
  {% include 'interfacing/admin/body/mount.html.twig' with {
    workbench: workbench,
    provider: 'antd-pro',
    secondaryProvider: 'primereact',
    resourceName: workbench.routeContext.resourcePath,
    resourceLabel: workbench.routeContext.resourceLabel,
    operation: workbench.routeContext.operation,
    surface: workbench.routeContext.surface,
    defaultView: 'table',
    viewModes: ['table', 'cards']
  } only %}
{% endblock %}
