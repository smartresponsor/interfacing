{% set fallbackQuickMenuGroup = [
  {'title': 'My account', 'item': [
    {'id': 'quick.profile', 'title': 'My profile', 'url': '/profile/'},
    {'id': 'quick.security', 'title': 'My security', 'url': '/security/'},
    {'id': 'quick.notifications', 'title': 'Notifications', 'url': '/interfacing/message.notifications.inbox'},
    {'id': 'quick.locale', 'title': 'Locale selector', 'url': '/interfacing/localizing.locale.selector'},
    {'id': 'quick.switch-account', 'title': 'Switch account', 'url': '/switch-account'},
    {'id': 'quick.sign-out', 'title': 'Sign out', 'url': '/sign-out'}
  ]},
  {'title': 'My commerce', 'item': [
    {'id': 'quick.cart', 'title': 'My cart', 'url': '/cart/'},
    {'id': 'quick.orders', 'title': 'My orders', 'url': '/order/'},
    {'id': 'quick.subscription', 'title': 'My subscription', 'url': '/subscription/'},
    {'id': 'quick.payments', 'title': 'Payments', 'url': '/payment/'}
  ]},
  {'title': 'System shortcuts', 'item': [
    {'id': 'quick.applications', 'title': 'Applications', 'url': '/interfacing/applications'},
    {'id': 'quick.components', 'title': 'Components', 'url': '/interfacing/components'},
    {'id': 'quick.crud', 'title': 'CRUD Explorer', 'url': '/interfacing/crud/explorer'},
    {'id': 'quick.shell', 'title': 'Shell Map', 'url': '/interfacing/shell/navigation'}
  ]}
] %}
{% set shellQuickMenuGroup = shellQuickMenuGroup|default(shell.quickMenuGroup|default(fallbackQuickMenuGroup)) %}
<details data-sr-shell-slot="quick-menu" data-sr-shell-contract="wave20.2" style="position:relative; display:inline-block;">
  <summary style="list-style:none; cursor:pointer; text-decoration:none; color:#fff; border:1px solid #111827; background:#111827; border-radius:10px; padding:7px 10px; font-size:12px; font-weight:800; user-select:none;">Menu ▾</summary>
  <div style="position:absolute; right:0; top:34px; width:310px; max-width:calc(100vw - 24px); background:#fff; border:1px solid #d7dde5; border-radius:14px; box-shadow:0 18px 45px rgba(15,23,42,.18); padding:10px; z-index:80; display:grid; gap:9px;">
    {% for g in shellQuickMenuGroup %}
      <section style="border:1px solid #edf0f3; border-radius:12px; padding:8px; background:#fcfcfd;">
        <div style="font-size:11px; letter-spacing:.04em; text-transform:uppercase; opacity:.68; margin-bottom:6px; font-weight:800;">{{ g.title }}</div>
        <div style="display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:6px;">
          {% for it in g.item %}
            {% if app.user and it.id in ['quick.switch-account', 'quick.sign-out'] %}
              <form method="post" action="{{ it.url }}" style="margin:0;">
                <button type="submit" style="width:100%; text-decoration:none; color:{{ it.id == 'quick.sign-out' ? '#b91c1c' : '#111827' }}; background:#fff; border:1px solid {{ it.id == 'quick.sign-out' ? '#fecaca' : '#e5e7eb' }}; border-radius:9px; padding:7px 8px; font-size:12px; font-weight:650; cursor:pointer;">{{ it.title }}</button>
              </form>
            {% else %}
              <a href="{{ it.url }}" style="text-decoration:none; color:#111827; background:#fff; border:1px solid #e5e7eb; border-radius:9px; padding:7px 8px; font-size:12px; font-weight:650;">{{ it.title }}</a>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endfor %}
  </div>
</details>
