{% set shellFooterGroup = shellFooterGroup|default(shell.footerGroup|default(fallbackFooterGroup)) %}
<footer data-sr-shell-slot="footer" data-sr-shell-contract="wave20.2" style="border-top:1px solid #dbe1e8; background:#fff;">
  <div style="max-width:1680px; margin:0 auto; display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:18px; padding:12px 14px;">
    {% for g in shellFooterGroup %}
      <section>
        <div style="font-size:11px; letter-spacing:.04em; text-transform:uppercase; opacity:.68; margin-bottom:6px; font-weight:800;">{{ g.title }}</div>
        <ul style="display:flex; flex-wrap:wrap; gap:8px 12px; list-style:none; margin:0; padding:0;">
          {% for link in g.link %}
            <li style="margin:0; padding:0;">
              <a href="{{ link.url }}" style="text-decoration:none; color:#111827; opacity:.82; font-size:12px;">{{ link.title }}</a>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endfor %}
  </div>
</footer>
