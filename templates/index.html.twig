{% extends '@Interfacing/base.html.twig' %}

{% set viewPayload = view is defined and view is iterable ? view : {} %}
{% set interfacePayload = interface is defined and interface is iterable ? interface : {} %}
{% set fallbackTitle = fallbackTitle|default(viewPayload.view|default('Interfacing')|replace({'.': ' ', '_': ' '})|title ~ ' interface') %}
{% set fallbackDescription = fallbackDescription|default('Root Interfacing fallback for a normalized Viewing payload. Add a concrete view template to replace this generic page.') %}
{% set fallbackPayload = fallbackPayload|default({
  view: viewPayload,
  interface: interfacePayload,
  data: data|default({}),
  meta: meta|default({}),
  viewing: viewing|default({})
}) %}

{% block title %}{{ fallbackTitle }}{% endblock %}

{% block page_content %}
  {% include '@Interfacing/partial/viewing_payload.html.twig' with {
    viewTitle: fallbackTitle,
    viewSummary: fallbackDescription,
    viewLocations: interfacePayload.locations|default(locations|default({})),
    interfaceSlotMap: data.slotMap|default(slotMap|default({})),
    view: viewPayload,
    interface: interfacePayload,
    data: data|default({}),
    meta: meta|default({}),
    viewing: viewing|default({})
  } only %}
{% endblock %}
