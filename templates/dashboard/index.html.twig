{% extends '@Interfacing/base.html.twig' %}

{% block title %}{{ title|default('Dashboard') }}{% endblock %}

{% block body %}
<section class="surface surface-dashboard"
         data-provider-primary="{{ primaryProvider|default('ant-design-procomponents') }}"
         data-provider-secondary="{{ secondaryProvider|default('primereact') }}"
         data-shell-mode="{{ shellMode|default('provider-page') }}">
    <header class="surface-header">
        <h1>{{ title|default('Dashboard') }}</h1>
        {% if paginationLabel is defined and paginationLabel %}
            <p class="surface-meta">{{ paginationLabel }}</p>
        {% endif %}
    </header>

    {% if headerActions is defined and headerActions is not empty %}
        <nav class="surface-actions" aria-label="Dashboard actions">
            {% for action in headerActions %}
                <a class="surface-action surface-action-{{ action.variant|default('default') }}"
                   href="{{ action.href|default('#') }}">
                    {{ action.label|default('Action') }}
                </a>
            {% endfor %}
        </nav>
    {% endif %}

    {% if rows is defined and rows is not empty %}
        <div class="surface-grid">
            {% for row in rows %}
                <article class="surface-card">
                    <h2>{{ row.title|default('Untitled') }}</h2>
                    <dl>
                        <div><dt>Route</dt><dd><code>{{ row.code|default('n/a') }}</code></dd></div>
                        <div><dt>Owner</dt><dd>{{ row.owner|default('n/a') }}</dd></div>
                        <div><dt>Status</dt><dd><span class="status">{{ row.status|default('unknown') }}</span></dd></div>
                        <div><dt>Locale</dt><dd>{{ row.locale|default(app.request.locale|default('en')) }}</dd></div>
                    </dl>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <p class="surface-empty">No dashboard rows are available.</p>
    {% endif %}
</section>

<style>
    .surface-dashboard {
        --bg: #f5f7fb;
        --fg: #101828;
        --muted: #475467;
        --card: #ffffff;
        --line: #d0d5dd;
        --accent: #155eef;
        --success: #067647;
        background:
            radial-gradient(120% 100% at 0% 0%, #e9efff 0%, transparent 60%),
            radial-gradient(100% 90% at 100% 0%, #f0f9ff 0%, transparent 55%),
            var(--bg);
        color: var(--fg);
        padding: 1.5rem;
        border-radius: 1rem;
        border: 1px solid var(--line);
    }

    .surface-header h1 {
        margin: 0;
        font-size: 1.6rem;
        letter-spacing: .01em;
    }

    .surface-meta {
        margin: .45rem 0 0;
        color: var(--muted);
    }

    .surface-actions {
        display: flex;
        flex-wrap: wrap;
        gap: .6rem;
        margin: 1rem 0 1.2rem;
    }

    .surface-action {
        display: inline-block;
        border: 1px solid var(--line);
        border-radius: .55rem;
        padding: .5rem .75rem;
        font-size: .92rem;
        text-decoration: none;
        color: var(--fg);
        background: var(--card);
    }

    .surface-action-primary {
        border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
        color: var(--accent);
    }

    .surface-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: .85rem;
    }

    .surface-card {
        background: var(--card);
        border: 1px solid var(--line);
        border-radius: .8rem;
        padding: .9rem;
    }

    .surface-card h2 {
        margin: 0 0 .6rem;
        font-size: 1.02rem;
    }

    .surface-card dl {
        margin: 0;
        display: grid;
        gap: .4rem;
    }

    .surface-card dl div {
        display: grid;
        gap: .15rem;
    }

    .surface-card dt {
        color: var(--muted);
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .03em;
    }

    .surface-card dd {
        margin: 0;
        font-size: .93rem;
    }

    .status {
        color: var(--success);
        font-weight: 600;
    }

    .surface-empty {
        margin: 1rem 0 0;
        color: var(--muted);
    }
</style>
{% endblock %}
