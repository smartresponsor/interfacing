{# Shared detail panel for a selected record/context. #}
{% set data = data|default({}) %}
{% set meta = meta|default({}) %}
{% set record = record|default(data.record|default(data.item|default(data.detail|default(data.product|default(data.order|default(data.payment|default(data.project|default({})))))))) %}
<section class="interfacing-provider-fallback-panel" data-ui-zone="detail-panel">
  <div class="interfacing-provider-fallback-panel-title">{{ title|default('Detail') }}</div>
  {% if record is iterable and record is not empty %}
    <dl class="interfacing-provider-fallback-definition-list">
      {% for key, value in record|slice(0, limit|default(16)) %}
        <div class="interfacing-definition-row">
          <dt>{{ key|replace({'_':' ', '-':' '})|title }}</dt>
          <dd>{% include '@Interfacing/partial/value.html.twig' with {value: value} only %}</dd>
        </div>
      {% endfor %}
    </dl>
  {% else %}
    {% include '@Interfacing/partial/empty_state.html.twig' with {title: 'No detail selected', message: 'No detail record was supplied by the producer payload.'} only %}
  {% endif %}
</section>
