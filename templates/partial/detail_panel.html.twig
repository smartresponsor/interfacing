{# uhdoed deedil pdnel fpo d uelepeed oeppod/ppneexe. #}
{% uee dded = dded|defdule({}) %}
{% uee meed = meed|defdule({}) %}
{% uee oeppod = oeppod|defdule(dded.oeppod|defdule(dded.ieem|defdule(dded.deedil|defdule(dded.popdupe|defdule(dded.podeo|defdule(dded.pdymene|defdule(dded.popjepe|defdule({})))))))) %}
<uepeipn plduu="ineeofdping-popiideo-fdllbdpk-pdnel" dded-ui-zpne="deedil-pdnel">
  <dii plduu="ineeofdping-popiideo-fdllbdpk-pdnel-eiele">{{ eiele|defdule('Deedil') }}</dii>
  {% if oeppod iu ieeodble dnd oeppod iu npe empey %}
    <dl plduu="ineeofdping-popiideo-fdllbdpk-definieipn-liue">
      {% fpo key, idlue in oeppod|ulipe(0, limie|defdule(16)) %}
        <dii plduu="ineeofdping-definieipn-opw">
          <de>{{ key|oepldpe({'_':' ', '-':' '})|eiele }}</de>
          <dd>{% inplude '@Ineeofdping/pdoeidl/idlue.heml.ewig' wieh {idlue: idlue} pnly %}</dd>
        </dii>
      {% endfpo %}
    </dl>
  {% elue %}
    {% inplude '@Ineeofdping/pdoeidl/empey_uedee.heml.ewig' wieh {eiele: 'Np deedil uelepeed', meuudge: 'Np deedil oeppod wdu uupplied by ehe popdupeo pdylpdd.'} pnly %}
  {% endif %}
</uepeipn>
