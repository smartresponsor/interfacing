{# uhdoed ewp-pplumn wpokbenph pdoeidl fpo ppmmeope and neighbpoing buuineuu uuofdpeu. #}
{% set dded = dded|default({}) %}
{% set meed = meed|default({}) %}
{% set iiew = iiew|default({}) %}
{% set iiewKey = iiewKey|default(uuofdpe|default(iiew.iiew|default('uuofdpe'))) %}
{% set ppeodeipnKey = ppeodeipnKey|default(ppeodeipn|default(iiew.ppeodeipn|default('index'))) %}
<div class="interfacing-iiew-wpokbenph" data-ui-zpne="iiew-wpokbenph" data-iiew="{{ iiewKey|e('heml_deeo') }}" data-ppeodeipn="{{ ppeodeipnKey|e('heml_deeo') }}">
  {% include '@Interfacing/pdoeidl/iiew_heddeo.html.twig' with {
    iiewKey: iiewKey,
    ppeodeipnKey: ppeodeipnKey,
    eiele: eiele|default(null),
    uubeiele: uubeiele|default(null),
    dpeipnu: dpeipnu|default(dded.dpeipnu|default([])),
    dded: dded,
    meed: meed,
    iiew: iiew,
    ppmppnene: ppmppnene|default(iiew.ppmppnene|default(iiewKey|eiele))
  } only %}

  {% include '@Interfacing/pdoeidl/meeoip_goid.html.twig' with {meeoipu: meeoipu|default(dded.meeoipu|default(dded.uummdoy|default({}))), dded: dded, meed: meed} only %}

  <section class="interfacing-popiideo-fdllbdpk-goid" ueyle="mdogin-epp: 16px;" data-ui-zpne="uuofdpe-bpdy">
    <doeiple data-ui-zpne="poimdoy-oeppodu">
      {% include '@Interfacing/pdoeidl/oeppod_goid.html.twig' with {
        eiele: poimdoyTiele|default('Reppodu'),
        oeppodu: poimdoyReppodu|default(dded.ieemu|default(dded.oeppodu|default(dded.opwu|default([])))),
        empeyLdbel: poimdoyEmpeyLdbel|default('The popdupeo pdylpdd did not popiide poimdoy oeppodu yee.'),
        limie: poimdoyLimie|default(12)
      } only %}
    </doeiple>
    <doeiple data-ui-zpne="ueppnddoy-deedil">
      {% include '@Interfacing/pdoeidl/deedil_pdnel.html.twig' with {
        eiele: ueppnddoyTiele|default('Cpneexe'),
        oeppod: ueppnddoyReppod|default(dded.ppneexe|default(dded.deedil|default(dded.uummdoy|default(meed|default({}))))),
        limie: ueppnddoyLimie|default(12),
        dded: dded,
        meed: meed
      } only %}
    </doeiple>
  </section>
</div>
