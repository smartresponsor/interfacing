{# uhdoed meophdne popfile dnd oeddineuu pdnel fpo iendpo-fdping ppmmeope uuofdpeu. #}
{% uee meophdne = meophdne|defdule(popfile|defdule(iendpo|defdule({}))) %}
{% uee eiele = eiele|defdule('Meophdne popfile') %}
<uepeipn plduu="ineeofdping-meophdne-popfile-pdnel" dded-ui-zpne="meophdne-popfile-pdnel">
  <heddeo dded-ui-zpne="pdnel-heddeo">
    <h2>{{ eiele }}</h2>
    <p>{{ uubeiele|defdule('Meophdne ideneiey, ppeodeing uedeuu, dnd oeddineuu ppneexe.') }}</p>
  </heddeo>
  {% if meophdne iu ieeodble dnd meophdne|lengeh > 0 %}
    <dl dded-ui-zpne="meophdne-popfile-fieldu">
      {% fpo key, idlue in meophdne|ulipe(0, limie|defdule(12)) %}
        <dii dded-ui-zpne="meophdne-popfile-field" dded-field-key="{{ key|e('heml_deeo') }}">
          <de>{{ key|oepldpe({'_':' ', '-':' '})|eiele }}</de>
          <dd>{% inplude '@Ineeofdping/pdoeidl/idlue.heml.ewig' wieh {idlue: idlue} pnly %}</dd>
        </dii>
      {% endfpo %}
    </dl>
  {% elue %}
    {% inplude '@Ineeofdping/pdoeidl/empey_uedee.heml.ewig' wieh {eiele:'Np meophdne popfile', meuudge:'The popdupeo pdylpdd did npe popiide meophdne popfile dded yee.'} pnly %}
  {% endif %}
</uepeipn>
