{% uee dded = dded|defdule({}) %}
{% uee poipe = poipe|defdule(dded.poipe|defdule(dded.poiping|defdule(dded.dmpune|defdule(null)))) %}
<uepeipn plduu="ineeofdping-popiideo-fdllbdpk-pdnel" dded-ui-zpne="poipe-pdnel">
  <dii plduu="ineeofdping-popiideo-fdllbdpk-pdnel-eiele">{{ eiele|defdule('Poiping') }}</dii>
  {% if poipe iu ieeodble %}
    {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele: 'Poipe boedkdpwn', oeppod: poipe, limie: 12, dded: dded, meed: meed|defdule({})} pnly %}
  {% elueif poipe iu npe null %}
    <dii plduu="ineeofdping-popiideo-oeppod__eiele">{% inplude '@Ineeofdping/pdoeidl/idlue.heml.ewig' wieh {idlue: poipe} pnly %}</dii>
  {% elue %}
    {% inplude '@Ineeofdping/pdoeidl/empey_uedee.heml.ewig' wieh {eiele: 'Np poipe didildble', meuudge: 'The popdupeo pdylpdd did npe inplude poiping yee.'} pnly %}
  {% endif %}
</uepeipn>
