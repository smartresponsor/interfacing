{# Shared payment method panel partial. #}
{% set methods = methods|default(paymentMethods|default([])) %}
<section class="interfacing-payment-method-panel" data-ui-zone="payment-method-panel">
  <h3 class="interfacing-u-heading-gap-12">{{ title|default('Payment methods') }}</h3>
  {% if methods is iterable and methods|length > 0 %}
    <div class="interfacing-u-grid interfacing-u-gap-10">
      {% for method in methods %}
        {% set row = method is iterable ? method : {'name': method} %}
        <article data-ui-zone="payment-method" class="interfacing-u-option-card">
          <strong>{{ row.label|default(row.name|default(row.brand|default('Payment method #' ~ loop.index))) }}</strong>
          <div class="interfacing-u-meta">{{ row.type|default(row.provider|default('payment')) }} · {{ row.status|default('available') }}</div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    {% include '@Interfacing/partial/empty_state.html.twig' with {title: 'No payment methods', message: emptyLabel|default('The producer payload did not provide payment methods yet.')} only %}
  {% endif %}
</section>
