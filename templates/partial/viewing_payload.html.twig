{#
  Generic Viewing payload renderer for Interfacing root fallbacks.
  Keep this renderer shallow and defensive: domain templates remain responsible
  for rendering concrete entities, forms, and business-specific structures.
#}
{% set viewPayload = view is defined and view is iterable ? view : {} %}
{% set viewingPayload = viewing is defined and viewing is iterable ? viewing : {} %}
{% set interfacePayload = interface is defined and interface is iterable ? interface : {} %}
{% set viewName = viewPayload.view|default(viewPayload.name|default('interface')) %}
{% set viewTitle = viewTitle|default(viewName|replace({'.': ' ', '_': ' '})|title) %}
{% set viewSummary = viewSummary|default('Normalized Viewing payload rendered by Interfacing.') %}
{% set viewLocations = viewLocations|default(interfacePayload.locations|default(locations|default({}))) %}
{% set interfaceSlotMap = interfaceSlotMap|default(data.slotMap|default(slotMap|default({}))) %}

<section class="interfacing-view interfacing-view--generic" data-interfacing-view="{{ viewName }}">
  <header class="interfacing-view__header">
    <p class="interfacing-view__eyebrow">{{ viewPayload.component|default('Interfacing') }}</p>
    <h1>{{ viewTitle }}</h1>
    <p>{{ viewSummary }}</p>
  </header>

  {% if viewLocations is iterable and viewLocations is not empty %}
    <section class="interfacing-view__grid">
      {% for slotKey, slotValue in viewLocations %}
        <article class="interfacing-view__panel" data-interfacing-slot="{{ slotKey }}">
          <h2>{{ interfaceSlotMap[slotKey]|default(slotKey|replace({'.': ' ', '_': ' '})|title) }}</h2>

          {% if slotValue is same as(true) %}
            <div class="interfacing-view__meta-block">true</div>
          {% elseif slotValue is same as(false) %}
            <div class="interfacing-view__meta-block">false</div>
          {% elseif slotValue is iterable %}
            <dl class="interfacing-view__values">
              {% for key, value in slotValue %}
                <div>
                  <dt>{{ key|replace({'.': ' ', '_': ' '})|title }}</dt>
                  <dd>
                    {% if value is same as(true) %}
                      true
                    {% elseif value is same as(false) %}
                      false
                    {% elseif value is iterable %}
                      {{ value|length }} item{{ value|length == 1 ? '' : 's' }}
                    {% elseif value is null %}
                      —
                    {% else %}
                      configured
                    {% endif %}
                  </dd>
                </div>
              {% endfor %}
            </dl>
          {% elseif slotValue is null %}
            <div class="interfacing-view__empty">Empty</div>
          {% else %}
            <div class="interfacing-view__meta-block">configured</div>
          {% endif %}
        </article>
      {% endfor %}
    </section>
  {% else %}
    <section class="interfacing-view__panel">
      <h2>No interface locations</h2>
      <p class="interfacing-view__empty">The controller returned a valid normalized Viewing payload, but no location data was provided.</p>
    </section>
  {% endif %}
</section>
