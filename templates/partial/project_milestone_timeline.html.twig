{# Project milestone timeline for funding/project delivery screens. #}
{% set milestones = milestones|default(timeline|default(events|default([]))) %}
<section class="interfacing-project-milestone-timeline interfacing-u-panel-card" data-ui-zone="project-milestone-timeline">
  <h2 class="interfacing-u-section-heading">{{ title|default('Milestones') }}</h2>
  {% if milestones is iterable and milestones|length > 0 %}
    <ol class="interfacing-u-timeline">
      {% for milestone in milestones %}
        <li>
          <strong>{{ milestone.title|default(milestone.name|default('Milestone')) }}</strong>
          <p class="interfacing-u-muted-copy-compact">{{ milestone.summary|default(milestone.status|default(milestone.date|default('Project milestone'))) }}</p>
        </li>
      {% endfor %}
    </ol>
  {% else %}
    {% include '@Interfacing/partial/empty_state.html.twig' with {title: 'No milestones yet', message: emptyLabel|default('Project milestones were not provided yet.')} only %}
  {% endif %}
</section>
