{# Shared payment state panel for payment, order payment, settlement and refund surfaces. #}
{% set payment = payment|default(record|default({})) %}
{% set status = payment.status|default(payment.state|default(status|default('unknown'))) %}
<section class="interfacing-payment-status-panel" data-ui-zone="payment-status-panel" data-payment-status="{{ status|e('html_attr') }}">
  <header class="interfacing-panel-header">
    <h2>{{ title|default('Payment status') }}</h2>
    <span class="interfacing-status-badge">{{ status|replace({'_':' '})|title }}</span>
  </header>
  {% include '@Interfacing/partial/detail_panel.html.twig' with {
    title: detailTitle|default('Payment details'),
    record: payment,
    emptyLabel: emptyLabel|default('No payment details are available yet.'),
    limit: limit|default(10)
  } only %}
</section>
