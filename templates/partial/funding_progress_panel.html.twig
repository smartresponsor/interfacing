{# Funding progress panel for project-commerce surfaces. #}
{% set funding = funding|default({}) %}
{% set raised = funding.raised|default(funding.amountRaised|default(funding.current|default(0))) %}
{% set goal = funding.goal|default(funding.target|default(funding.amountGoal|default(null))) %}
{% set currency = funding.currency|default('$') %}
{% set percent = funding.percent|default(goal ? ((raised / goal) * 100)|round(0, 'floor') : null) %}
<section class="interfacing-funding-progress" data-ui-zone="funding-progress" style="border: 1px solid #d9d9d9; border-radius: 14px; padding: {{ compact|default(false) ? '10px' : '16px' }}; background: #fff;">
  {% if not compact|default(false) %}<h2 style="margin: 0 0 12px; font-size: 1.1rem;">{{ title|default('Funding progress') }}</h2>{% endif %}
  <div style="display: flex; justify-content: space-between; gap: 12px; align-items: baseline;">
    <strong>{{ currency }}{{ raised }}</strong>
    {% if goal %}<span style="color: #667085;">of {{ currency }}{{ goal }}</span>{% endif %}
  </div>
  {% if percent is not null %}
    <div style="height: 10px; background: #f2f4f7; border-radius: 999px; margin-top: 10px; overflow: hidden;">
      <div style="width: {{ percent > 100 ? 100 : percent }}%; height: 100%; background: #1677ff;"></div>
    </div>
    <p style="margin: 8px 0 0; color: #667085;">{{ percent }}% funded</p>
  {% else %}
    <p style="margin: 8px 0 0; color: #667085;">Funding goal was not provided.</p>
  {% endif %}
</section>
