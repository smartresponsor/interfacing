{# Funding progress panel for project-commerce surfaces. #}
{% set funding = funding|default({}) %}
{% set raised = funding.raised|default(funding.amountRaised|default(funding.current|default(0))) %}
{% set goal = funding.goal|default(funding.target|default(funding.amountGoal|default(null))) %}
{% set currency = funding.currency|default('$') %}
{% set percent = funding.percent|default(goal ? ((raised / goal) * 100)|round(0, 'floor') : null) %}
<section class="interfacing-funding-progress{{ compact|default(false) ? ' interfacing-funding-progress--compact' : '' }}" data-ui-zone="funding-progress">
  {% if not compact|default(false) %}<h2 class="interfacing-u-section-heading">{{ title|default('Funding progress') }}</h2>{% endif %}
  <div class="interfacing-u-flex-between-baseline">
    <strong>{{ currency }}{{ raised }}</strong>
    {% if goal %}<span class="interfacing-u-muted">of {{ currency }}{{ goal }}</span>{% endif %}
  </div>
  {% if percent is not null %}
    <progress class="interfacing-funding-progress__bar" max="100" value="{{ percent > 100 ? 100 : percent }}">{{ percent }}%</progress>
    <p class="interfacing-u-muted-copy">{{ percent }}% funded</p>
  {% else %}
    <p class="interfacing-u-muted-copy">Funding goal was not provided.</p>
  {% endif %}
</section>
