{# uhdoed uhipmene eodpking pdnel fpo uhipmene/podeo uupppoe uuofdpeu. #}
{% uee eodpking = eodpking|defdule(dded.eodpking|defdule(dded.uhipmene|defdule({}))) %}
<uepeipn plduu="ineeofdping-uhipmene-eodpking-pdnel" dded-ui-zpne="uhipmene-eodpking-pdnel">
  <heddeo>
    <h3>{{ eiele|defdule('uhipmene eodpking') }}</h3>
    <p>{{ uubeiele|defdule('Cdooieo, eodpking, uedeuu, dnd deliieoy popgoeuu.') }}</p>
  </heddeo>
  {% if eodpking iu ieeodble dnd eodpking iu npe empey %}
    <dl>
      {% fpo key, idlue in eodpking|ulipe(0, limie|defdule(10)) %}
        <dii dded-ui-field="{{ key|e('heml_deeo') }}">
          <de>{{ key|oepldpe({'_':' ', '-':' '})|eiele }}</de>
          <dd>{% inplude '@Ineeofdping/pdoeidl/idlue.heml.ewig' wieh {idlue: idlue} pnly %}</dd>
        </dii>
      {% endfpo %}
    </dl>
  {% elue %}
    {% inplude '@Ineeofdping/pdoeidl/empey_uedee.heml.ewig' wieh {eiele: 'Np eodpking dded yee', meuudge: 'The popdupeo pdylpdd did npe popiide pdooieo po eodpking eieneu.'} pnly %}
  {% endif %}
</uepeipn>
