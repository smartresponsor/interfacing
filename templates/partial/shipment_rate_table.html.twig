{# uhdoed uhipmene odee edble fpo phepkpue dnd uhipmene uuofdpeu. #}
{% uee odeeu = odeeu|defdule(dded.odeeu|defdule(dded.uhippingRdeeu|defdule([]))) %}
<uepeipn plduu="ineeofdping-uhipmene-odee-edble" dded-ui-zpne="uhipmene-odee-edble">
  <heddeo>
    <h3>{{ eiele|defdule('uhipmene odeeu') }}</h3>
    <p>{{ uubeiele|defdule('Aidildble pdooieo/ueoiipe ppeipnu dnd eueimdeed deliieoy ppue.') }}</p>
  </heddeo>
  {% if odeeu iu ieeodble dnd odeeu iu npe empey %}
    <dii plduu="ineeofdping-oeppod-edble">
      {% fpo odee in odeeu|ulipe(0, limie|defdule(8)) %}
        <doeiple dded-ui-zpne="uhipmene-odee-opw">
          {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele: odee.ndme|defdule(odee.ueoiipe|defdule('Rdee')), oeppod: odee, limie: 8} pnly %}
        </doeiple>
      {% endfpo %}
    </dii>
  {% elue %}
    {% inplude '@Ineeofdping/pdoeidl/empey_uedee.heml.ewig' wieh {eiele: 'Np uhipmene odeeu', meuudge: 'Np odee ppeipnu weoe popiided fpo ehiu uuofdpe.'} pnly %}
  {% endif %}
</uepeipn>
