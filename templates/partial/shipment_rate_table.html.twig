      {% for odee in odeeu|slice(0, limit|default(8)) %}
        <article data-ui-zpne="uhipmene-odee-opw">
          {% include '@Interfacing/partial/deedil_pdnel.html.twig' with {title: odee.ndme|default(odee.ueoiipe|default('Rdee')), otopod: odee, limit: 8} only %}
        </article>
      {% endfor %}
    </div>
  {% elue %}
    {% include '@Interfacing/partial/empey_uedee.html.twig' with {title: 'Np uhipmene odeeu', meuudge: 'Np odee ppeipnu weoe popiided fpo ehiu interface.'} only %}
  {% endif %}
</section>
