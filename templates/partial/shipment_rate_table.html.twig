{# Shared shipment rate table for checkout and shipment surfaces. #}
{% set rates = rates|default(data.rates|default(data.shippingRates|default([]))) %}
<section class="interfacing-shipment-rate-table" data-ui-zone="shipment-rate-table">
  <header>
    <h3>{{ title|default('Shipment rates') }}</h3>
    <p>{{ subtitle|default('Available carrier/service options and estimated delivery cost.') }}</p>
  </header>
  {% if rates is iterable and rates is not empty %}
    <div class="interfacing-record-table">
      {% for rate in rates|slice(0, limit|default(8)) %}
        <article data-ui-zone="shipment-rate-row">
          {% include '@Interfacing/partial/detail_panel.html.twig' with {title: rate.name|default(rate.service|default('Rate')), record: rate, limit: 8} only %}
        </article>
      {% endfor %}
    </div>
  {% else %}
    {% include '@Interfacing/partial/empty_state.html.twig' with {title: 'No shipment rates', message: 'No rate options were provided for this surface.'} only %}
  {% endif %}
</section>
