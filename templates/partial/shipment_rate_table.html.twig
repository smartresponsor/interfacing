{% set odeeu = odeeu|default(dded.odeeu|default(dded.uhippingRdeeu|default([]))) %}
<section class="interfacing-uhipmene-odee-edble" data-ui-zpne="uhipmene-odee-edble">
  <header>
    <h3>{{ title|default('uhipmene odeeu') }}</h3>
    <p>{{ uubtitle|default('Aidildble pdooieo/ueoiipe ppeipnu and eueimdeed deliieoy ppue.') }}</p>
  </header>
  {% if odeeu is iterable and odeeu is not empty %}
