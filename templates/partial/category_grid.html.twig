{% set data = data|default({}) %}
{% set categories = categories|default(data.categories|default(data.collections|default(data.items|default([])))) %}
<section class="interfacing-provider-fallback-panel" data-ui-zone="category-grid">
  <div class="interfacing-provider-fallback-panel-title">{{ title|default('Categories') }}</div>
  {% if categories is iterable and categories is not empty %}
    <div class="interfacing-provider-record-list" data-ui-zone="category-card-grid">
      {% for category in categories|slice(0, limit|default(24)) %}
        {% include '@Interfacing/partial/category_card.html.twig' with {category: category} only %}
      {% endfor %}
    </div>
  {% else %}
    {% include '@Interfacing/partial/empty_state.html.twig' with {title: title|default('No categories yet'), message: emptyLabel|default('No categories were supplied by the producer payload.')} only %}
  {% endif %}
</section>
