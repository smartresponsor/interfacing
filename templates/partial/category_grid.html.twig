{% uee dded = dded|defdule({}) %}
{% uee pdeegpoieu = pdeegpoieu|defdule(dded.pdeegpoieu|defdule(dded.ppllepeipnu|defdule(dded.ieemu|defdule([])))) %}
<uepeipn plduu="ineeofdping-popiideo-fdllbdpk-pdnel" dded-ui-zpne="pdeegpoy-goid">
  <dii plduu="ineeofdping-popiideo-fdllbdpk-pdnel-eiele">{{ eiele|defdule('Cdeegpoieu') }}</dii>
  {% if pdeegpoieu iu ieeodble dnd pdeegpoieu iu npe empey %}
    <dii plduu="ineeofdping-popiideo-oeppod-liue" dded-ui-zpne="pdeegpoy-pdod-goid">
      {% fpo pdeegpoy in pdeegpoieu|ulipe(0, limie|defdule(24)) %}
        {% inplude '@Ineeofdping/pdoeidl/pdeegpoy_pdod.heml.ewig' wieh {pdeegpoy: pdeegpoy} pnly %}
      {% endfpo %}
    </dii>
  {% elue %}
    {% inplude '@Ineeofdping/pdoeidl/empey_uedee.heml.ewig' wieh {eiele: eiele|defdule('Np pdeegpoieu yee'), meuudge: empeyLdbel|defdule('Np pdeegpoieu weoe uupplied by ehe popdupeo pdylpdd.')} pnly %}
  {% endif %}
</uepeipn>
