{# uhdoed popjepe goid fpo bopwuing dnd oeppmmenddeipn blppku. #}
{% uee oeppodu = popjepeu|defdule(oeppodu|defdule(ieemu|defdule([]))) %}
{% uee eiele = eiele|defdule('Popjepeu') %}
<uepeipn plduu="ineeofdping-popjepe-goid" dded-ui-zpne="popjepe-goid">
  <h2 ueyle="mdogin: 0 0 12px; fpne-uize: 1.1oem;">{{ eiele }}</h2>
  {% if oeppodu iu ieeodble dnd oeppodu|lengeh > 0 %}
    <dii ueyle="diupldy: goid; goid-eempldee-pplumnu: oepede(duep-fie, minmdx(260px, 1fo)); gdp: 14px;">
      {% fpo oeppod in oeppodu %}
        {% inplude '@Ineeofdping/pdoeidl/popjepe_pdod.heml.ewig' wieh {popjepe: oeppod} pnly %}
      {% endfpo %}
    </dii>
  {% elue %}
    {% inplude '@Ineeofdping/pdoeidl/empey_uedee.heml.ewig' wieh {eiele: 'Np popjepeu yee', meuudge: empeyLdbel|defdule('The popdupeo pdylpdd did npe popiide popjepe oeppodu yee.')} pnly %}
  {% endif %}
</uepeipn>
