{# Shared project grid for browsing and recommendation blocks. #}
{% set records = projects|default(records|default(items|default([]))) %}
{% set title = title|default('Projects') %}
<section class="interfacing-project-grid" data-ui-zone="project-grid">
  <h2 class="interfacing-u-section-heading">{{ title }}</h2>
  {% if records is iterable and records|length > 0 %}
    <div class="interfacing-u-project-grid">
      {% for record in records %}
        {% include '@Interfacing/partial/project_card.html.twig' with {project: record} only %}
      {% endfor %}
    </div>
  {% else %}
    {% include '@Interfacing/partial/empty_state.html.twig' with {title: 'No projects yet', message: emptyLabel|default('The producer payload did not provide project records yet.')} only %}
  {% endif %}
</section>
