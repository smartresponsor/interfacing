{# Producer-owned CRUD route grammar. This partial is intentionally UI-only and data-free. #}
<section id="crud-pattern" class="interfacing-provider-fallback-panel interfacing-crud-route-grammar">
  <div class="interfacing-panel-eyebrow interfacing-panel-eyebrow--flush">Producer-owned CRUD grammar</div>
  <div class="interfacing-block-muted">Interfacing only displays expected CRUD semantics. Real CRUD routes, controllers, mutations, identifiers, and persistence belong to Cruding or to the host producer component.</div>
  <div class="interfacing-crud-route-grammar__list">
    <div><strong>Index</strong> · <code>/{resourcePath}/</code></div>
    <div><strong>New</strong> · <code>/{resourcePath}/new/</code></div>
    <div><strong>Show</strong> · <code>/{resourcePath}/{id}</code></div>
    <div><strong>Edit</strong> · <code>/{resourcePath}/edit/{id}</code></div>
    <div><strong>Delete</strong> · <code>/{resourcePath}/delete/{id}</code></div>
  </div>
  <div class="interfacing-crud-route-grammar__meta">Interfacing does not register these routes. Host route names are diagnostic placeholders only.</div>
</section>
