{# Shared checkout progress partial. #}
{% set steps = steps|default(['cart', 'shipping', 'payment', 'review', 'success']) %}
{% set current = current|default(operation|default('cart')) %}
<nav class="interfacing-checkout-stepper" data-ui-zone="checkout-stepper" aria-label="Checkout progress">
  <ol class="interfacing-u-step-grid">
    {% for step in steps %}
      {% set active = step == current %}
      <li class="interfacing-checkout-step" data-ui-zone="checkout-step" data-step="{{ step|e('html_attr') }}" data-active="{{ active ? 'true' : 'false' }}">
        <span class="interfacing-u-step-label">Step {{ loop.index }}</span>
        <strong>{{ step|replace({'-':' '})|title }}</strong>
      </li>
    {% endfor %}
  </ol>
</nav>
