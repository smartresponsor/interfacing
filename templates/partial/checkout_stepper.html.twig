{# Shared checkout progress partial. #}
{% set steps = steps|default(['cart', 'shipping', 'payment', 'review', 'success']) %}
{% set current = current|default(operation|default('cart')) %}
<nav class="interfacing-checkout-stepper" data-ui-zone="checkout-stepper" aria-label="Checkout progress">
  <ol style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;padding:0;margin:0;list-style:none;">
    {% for step in steps %}
      {% set active = step == current %}
      <li data-ui-zone="checkout-step" data-step="{{ step|e('html_attr') }}" data-active="{{ active ? 'true' : 'false' }}" style="border:1px solid {{ active ? '#111827' : '#e5e7eb' }};border-radius:14px;padding:10px 12px;background:{{ active ? '#f9fafb' : '#fff' }};">
        <span style="display:block;font-size:12px;color:#6b7280;">Step {{ loop.index }}</span>
        <strong>{{ step|replace({'-':' '})|title }}</strong>
      </li>
    {% endfor %}
  </ol>
</nav>
