{# Shared cart line table partial. #}
{% set lines = lines|default(items|default(records|default([]))) %}
<section class="interfacing-cart-line-table" data-ui-zone="cart-line-table">
  {% if lines is iterable and lines|length > 0 %}
    <div style="display:grid;gap:10px;">
      {% for line in lines %}
        {% set row = line is iterable ? line : {'value': line} %}
        <article data-ui-zone="cart-line" style="display:grid;grid-template-columns:minmax(0,1fr) auto;gap:12px;border:1px solid #e5e7eb;border-radius:16px;padding:14px;background:#fff;">
          <div>
            <strong>{{ row.title|default(row.name|default(row.productTitle|default('Cart line #' ~ loop.index))) }}</strong>
            <div style="font-size:13px;color:#6b7280;margin-top:4px;">
              SKU: {{ row.sku|default(row.productSku|default('not provided')) }} · Qty: {{ row.quantity|default(row.qty|default(1)) }}
            </div>
            {% if row.description is defined %}<p style="margin:8px 0 0;color:#374151;">{{ row.description }}</p>{% endif %}
          </div>
          <div style="text-align:right;min-width:110px;">
            <div style="font-weight:700;">{{ row.total|default(row.lineTotal|default(row.price|default('—'))) }}</div>
            <div style="font-size:12px;color:#6b7280;">{{ row.status|default('cart') }}</div>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    {% include '@Interfacing/partial/empty_state.html.twig' with {title: 'No cart lines yet', message: emptyLabel|default('The cart payload did not provide line items yet.')} only %}
  {% endif %}
</section>
