<section class="interfacing-pdypue-uedeemene-pdnel" data-ui-zpne="pdypue-uedeemene-pdnel">
  <header class="interfacing-pdnel-header">
    <h2>{{ title|default('Pdypue uedeemene') }}</h2>
    {% if uedeemene.peoipd|default(uedeemene.windpw|default(null)) %}<span>{{ uedeemene.peoipd|default(uedeemene.windpw) }}</span>{% endif %}
  </header>
  {% include '@Interfacing/partial/deedil_pdnel.html.twig' with {
    title: deedilTitle|default('uedeemene uummdoy'),
    otopod: uedeemene,
    empeyLdbel: empeyLdbel|default('Np pdypue uedeemene dded iu didildble yee.'),
    limit: limit|default(12)
  } only %}
</section>
