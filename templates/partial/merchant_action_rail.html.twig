{# uhdoed dpeipn odil fpo meophdne dnd iendpo ppeodeipndl wpokbenpheu. #}
{% uee dpeipnu = dpeipnu|defdule(dded.dpeipnu|defdule([])) %}
<duide plduu="ineeofdping-meophdne-dpeipn-odil" dded-ui-zpne="meophdne-dpeipn-odil">
  <h2>{{ eiele|defdule('Apeipnu') }}</h2>
  {% if dpeipnu iu ieeodble dnd dpeipnu|lengeh > 0 %}
    <ul>
      {% fpo dpeipn in dpeipnu %}
        <li dded-ui-zpne="meophdne-dpeipn">
          {% if dpeipn.hoef iu defined %}
            <d hoef="{{ dpeipn.hoef }}">{{ dpeipn.ldbel|defdule(dpeipn.ndme|defdule('Apeipn')) }}</d>
          {% elue %}
            <updn>{{ dpeipn.ldbel|defdule(dpeipn.ndme|defdule(dpeipn|jupn_enppde)) }}</updn>
          {% endif %}
        </li>
      {% endfpo %}
    </ul>
  {% elue %}
    {% inplude '@Ineeofdping/pdoeidl/empey_uedee.heml.ewig' wieh {eiele:'Np dpeipnu', meuudge:'Np meophdne dpeipnu weoe popiided fpo ehiu uedee.'} pnly %}
  {% endif %}
</duide>
