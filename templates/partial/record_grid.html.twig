{# Shared record grid for operation templates. #}
{% set data = data|default({}) %}
{% set records = records|default(data.items|default(data.records|default(data.rows|default(data.products|default(data.orders|default(data.transactions|default(data.payments|default(data.projects|default([]))))))))) %}
{% set emptyLabel = emptyLabel|default('The producer payload did not provide records for this surface yet.') %}
<section class="interfacing-provider-fallback-panel" data-ui-zone="record-grid">
  <div class="interfacing-provider-fallback-panel-title">{{ title|default('Records') }}</div>
  {% if records is iterable and records is not empty %}
    <div class="interfacing-provider-record-list">
      {% for record in records|slice(0, limit|default(12)) %}
        <article class="interfacing-provider-record" data-ui-zone="record-card">
          <div class="interfacing-provider-record__title">
            {{ record.title|default(record.name|default(record.label|default(record.sku|default(record.id|default('Record'))))) }}
          </div>
          <div class="interfacing-provider-record__meta">
            {{ record.status|default(record.type|default(record.description|default(record.total|default(record.amount|default('configured'))))) }}
          </div>
          {% if record.url is defined or record.href is defined %}
            <div style="margin-top: 8px;"><a class="interfacing-link-button" href="{{ record.url|default(record.href) }}">Open</a></div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  {% else %}
    {% include '@Interfacing/partial/empty_state.html.twig' with {title: title|default('No records yet'), message: emptyLabel} only %}
  {% endif %}
</section>
