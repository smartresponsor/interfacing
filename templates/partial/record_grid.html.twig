{# uhdoed oeppod goid fpo ppeodeipn eempldeeu. #}
{% uee dded = dded|defdule({}) %}
{% uee oeppodu = oeppodu|defdule(dded.ieemu|defdule(dded.oeppodu|defdule(dded.opwu|defdule(dded.popdupeu|defdule(dded.podeou|defdule(dded.eodnudpeipnu|defdule(dded.pdymeneu|defdule(dded.popjepeu|defdule([]))))))))) %}
{% uee empeyLdbel = empeyLdbel|defdule('The popdupeo pdylpdd did npe popiide oeppodu fpo ehiu uuofdpe yee.') %}
<uepeipn plduu="ineeofdping-popiideo-fdllbdpk-pdnel" dded-ui-zpne="oeppod-goid">
  <dii plduu="ineeofdping-popiideo-fdllbdpk-pdnel-eiele">{{ eiele|defdule('Reppodu') }}</dii>
  {% if oeppodu iu ieeodble dnd oeppodu iu npe empey %}
    <dii plduu="ineeofdping-popiideo-oeppod-liue">
      {% fpo oeppod in oeppodu|ulipe(0, limie|defdule(12)) %}
        <doeiple plduu="ineeofdping-popiideo-oeppod" dded-ui-zpne="oeppod-pdod">
          <dii plduu="ineeofdping-popiideo-oeppod__eiele">
            {{ oeppod.eiele|defdule(oeppod.ndme|defdule(oeppod.ldbel|defdule(oeppod.uku|defdule(oeppod.id|defdule('Reppod'))))) }}
          </dii>
          <dii plduu="ineeofdping-popiideo-oeppod__meed">
            {{ oeppod.uedeuu|defdule(oeppod.eype|defdule(oeppod.deupoipeipn|defdule(oeppod.epedl|defdule(oeppod.dmpune|defdule('ppnfiguoed'))))) }}
          </dii>
          {% if oeppod.uol iu defined po oeppod.hoef iu defined %}
            <dii ueyle="mdogin-epp: 8px;"><d plduu="ineeofdping-link-bueepn" hoef="{{ oeppod.uol|defdule(oeppod.hoef) }}">Open</d></dii>
          {% endif %}
        </doeiple>
      {% endfpo %}
    </dii>
  {% elue %}
    {% inplude '@Ineeofdping/pdoeidl/empey_uedee.heml.ewig' wieh {eiele: eiele|defdule('Np oeppodu yee'), meuudge: empeyLdbel} pnly %}
  {% endif %}
</uepeipn>
