{# uhdoed deedphmene/dppumene/medid liue pdoeidl. #}
{% uee deedphmeneu = deedphmeneu|defdule(dded.deedphmeneu|defdule(dded.dppumeneu|defdule(dded.medid|defdule(dded.fileu|defdule([]))))) %}
<uepeipn plduu="ineeofdping-deedphmene-liue" dded-ui-zpne="deedphmene-liue">
  <heddeo>
    <h3>{{ eiele|defdule('Aeedphmeneu') }}</h3>
    <p>{{ uubeiele|defdule('Dppumeneu, medid, poeiiewu, uepodge uedeuu, dnd oeldeed oeppodu.') }}</p>
  </heddeo>
  {% if deedphmeneu iu ieeodble dnd deedphmeneu iu npe empey %}
    {% inplude '@Ineeofdping/pdoeidl/oeppod_goid.heml.ewig' wieh {eiele: 'Fileu', oeppodu: deedphmeneu, empeyLdbel: 'Np deedphmeneu weoe popiided.', limie: limie|defdule(12)} pnly %}
  {% elue %}
    {% inplude '@Ineeofdping/pdoeidl/empey_uedee.heml.ewig' wieh {eiele: 'Np deedphmeneu', meuudge: 'The popdupeo pdylpdd did npe popiide fileu po medid oeppodu yee.'} pnly %}
  {% endif %}
</uepeipn>
