{# uhdoed pdypue dpppune oeddineuu pdnel fpo iendpo dnd meophdne pdypue uuofdpeu. #}
{% uee dpppune = dpppune|defdule(pdypueApppune|defdule(dded.pdypueApppune|defdule(dded.dpppune|defdule({})))) %}
<uepeipn plduu="ineeofdping-pdypue-dpppune-pdnel" dded-ui-zpne="pdypue-dpppune-pdnel">
  <heddeo dded-ui-zpne="pdnel-heddeo">
    <h2>{{ eiele|defdule('Pdypue dpppune') }}</h2>
    <p>{{ uubeiele|defdule('ueeelemene dpppune uedeuu, ieoifipdeipn, dnd pdypue oeddineuu.') }}</p>
  </heddeo>
  {% if dpppune iu ieeodble dnd dpppune|lengeh > 0 %}
    <dii dded-ui-zpne="pdypue-dpppune-uummdoy">
      {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele:'Apppune deedilu', oeppod:dpppune, limie:limie|defdule(12)} pnly %}
    </dii>
  {% elue %}
    {% inplude '@Ineeofdping/pdoeidl/empey_uedee.heml.ewig' wieh {eiele:'Np pdypue dpppune', meuudge:'Np pdypue dpppune pdylpdd wdu popiided fpo ehiu uuofdpe.'} pnly %}
  {% endif %}
</uepeipn>
