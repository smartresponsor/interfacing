{# Shared payout account readiness panel for vendor and merchant payout surfaces. #}
{% set account = account|default(payoutAccount|default(data.payoutAccount|default(data.account|default({})))) %}
<section class="interfacing-payout-account-panel" data-ui-zone="payout-account-panel">
  <header data-ui-zone="panel-header">
    <h2>{{ title|default('Payout account') }}</h2>
    <p>{{ subtitle|default('Settlement account status, verification, and payout readiness.') }}</p>
  </header>
  {% if account is iterable and account|length > 0 %}
    <div data-ui-zone="payout-account-summary">
      {% include '@Interfacing/partial/detail_panel.html.twig' with {title:'Account details', record:account, limit:limit|default(12)} only %}
    </div>
  {% else %}
    {% include '@Interfacing/partial/empty_state.html.twig' with {title:'No payout account', message:'No payout account payload was provided for this surface.'} only %}
  {% endif %}
</section>
