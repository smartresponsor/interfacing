{# Shared product card. Keeps Twig-only markup ready for later UI-provider enrichment. #}
{% set product = product|default(record|default({})) %}
{% set title = product.title|default(product.name|default(product.label|default(product.sku|default('Product')))) %}
{% set price = product.price|default(product.formattedPrice|default(product.amount|default(product.total|default(null)))) %}
<article class="interfacing-provider-record" data-ui-zone="product-card" data-product-id="{{ product.id|default('')|e('html_attr') }}">
  {% if product.image is defined or product.imageUrl is defined or product.thumbnail is defined %}
    <div data-ui-zone="product-card-media" style="margin-bottom: 10px;">
      <img src="{{ product.imageUrl|default(product.image|default(product.thumbnail)) }}" alt="{{ title|e('html_attr') }}" style="max-width: 100%; border-radius: 12px;">
    </div>
  {% endif %}
  <div class="interfacing-provider-record__title">{{ title }}</div>
  <div class="interfacing-provider-record__meta">{{ product.summary|default(product.description|default(product.status|default(product.sku|default('Commerce item')))) }}</div>
  {% if price is not null %}
    <div class="interfacing-provider-record__title" data-ui-zone="product-card-price" style="margin-top: 8px;">{% include '@Interfacing/partial/value.html.twig' with {value: price} only %}</div>
  {% endif %}
  <div style="margin-top: 10px; display: flex; gap: 8px; flex-wrap: wrap;" data-ui-zone="product-card-actions">
    {% if product.url is defined or product.href is defined %}
      <a class="interfacing-link-button" href="{{ product.url|default(product.href) }}">Open</a>
    {% endif %}
    {% if product.cartUrl is defined or product.addToCartUrl is defined %}
      <a class="interfacing-link-button" href="{{ product.addToCartUrl|default(product.cartUrl) }}">Add to cart</a>
    {% endif %}
  </div>
</article>
