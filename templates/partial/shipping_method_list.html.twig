{# Shared shipping method list partial. #}
{% set methods = methods|default(shippingMethods|default([])) %}
<section class="interfacing-shipping-method-list" data-ui-zone="shipping-method-list">
  <h3 class="interfacing-u-heading-gap-12">{{ title|default('Shipping options') }}</h3>
  {% if methods is iterable and methods|length > 0 %}
    <div class="interfacing-u-grid interfacing-u-gap-10">
      {% for method in methods %}
        {% set row = method is iterable ? method : {'name': method} %}
        <article data-ui-zone="shipping-method" class="interfacing-u-option-card">
          <strong>{{ row.name|default(row.title|default('Shipping method #' ~ loop.index)) }}</strong>
          <div class="interfacing-u-meta">{{ row.eta|default(row.deliveryWindow|default('Delivery window not provided')) }} · {{ row.price|default(row.amount|default('rate pending')) }}</div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    {% include '@Interfacing/partial/empty_state.html.twig' with {title: 'No shipping methods', message: emptyLabel|default('The producer payload did not provide shipping methods yet.')} only %}
  {% endif %}
</section>
