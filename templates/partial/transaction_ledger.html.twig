{# Shared transaction ledger for vendor, payment and commerce history surfaces. #}
{% set records = records|default(transactions|default([])) %}
<section class="interfacing-transaction-ledger" data-ui-zone="transaction-ledger">
  <header class="interfacing-panel-header">
    <h2>{{ title|default('Transaction ledger') }}</h2>
    {% if subtitle|default(null) %}<p>{{ subtitle }}</p>{% endif %}
  </header>
  {% include '@Interfacing/partial/record_grid.html.twig' with {
    title: recordTitle|default('Transactions'),
    records: records,
    emptyLabel: emptyLabel|default('No transaction records are available yet.'),
    limit: limit|default(12)
  } only %}
</section>
