{# Shared billing account summary panel. #}
{% set account = account|default(data.account|default(data.billingAccount|default(data.customer|default({})))) %}
<section class="interfacing-billing-account-panel" data-ui-zone="billing-account-panel">
  <header>
    <h3>{{ title|default('Billing account') }}</h3>
    <p>{{ subtitle|default('Account status, balance, plan, invoice and payment context.') }}</p>
  </header>
  {% include '@Interfacing/partial/detail_panel.html.twig' with {title: 'Account context', record: account, limit: limit|default(10), data: data|default({}), meta: meta|default({})} only %}
</section>
