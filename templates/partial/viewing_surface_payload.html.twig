{#
  Generic Viewing payload renderer for Interfacing noun surfaces.
  This partial intentionally renders shallow, defensive summaries only. Producer
  objects/forms may be present in payloads; do not stringify arbitrary objects.
#}
{% set surfaceTitle = surfaceTitle|default(view.surface|default(word|default('Surface'))|title) %}
{% set surfaceSummary = surfaceSummary|default('Neutral Viewing payload rendered by Interfacing.') %}
{% set surfaceSlots = surfaceSlots|default(slots|default(locations|default({}))) %}
{% set surfaceSlotMap = surfaceSlotMap|default(slotMap|default({})) %}

<section class="interfacing-surface interfacing-surface--generic" data-interfacing-surface="{{ view.surface|default(word|default('surface')) }}">
  <header class="interfacing-surface__header">
    <p class="interfacing-surface__eyebrow">{{ view.component|default('Interfacing') }}</p>
    <h1>{{ surfaceTitle }}</h1>
    <p>{{ surfaceSummary }}</p>
  </header>

  {% if surfaceSlots is iterable and surfaceSlots is not empty %}
    <section class="interfacing-surface__grid">
      {% for slotKey, slotValue in surfaceSlots %}
        <article class="interfacing-surface__panel" data-interfacing-slot="{{ slotKey }}">
          <h2>{{ surfaceSlotMap[slotKey]|default(slotKey|replace({'.': ' ', '_': ' '})|title) }}</h2>

          {% if slotValue is same as(true) %}
            <div class="interfacing-surface__meta-block">true</div>
          {% elseif slotValue is same as(false) %}
            <div class="interfacing-surface__meta-block">false</div>
          {% elseif slotValue is iterable %}
            <dl class="interfacing-surface__stats">
              {% for key, value in slotValue %}
                <div>
                  <dt>{{ key|replace({'.': ' ', '_': ' '})|title }}</dt>
                  <dd>
                    {% if value is same as(true) %}
                      true
                    {% elseif value is same as(false) %}
                      false
                    {% elseif value is iterable %}
                      {{ value|length }} item{{ value|length == 1 ? '' : 's' }}
                    {% elseif value is null %}
                      —
                    {% else %}
                      configured
                    {% endif %}
                  </dd>
                </div>
              {% endfor %}
            </dl>
          {% elseif slotValue is null %}
            <div class="interfacing-surface__empty">Empty</div>
          {% else %}
            <div class="interfacing-surface__meta-block">configured</div>
          {% endif %}
        </article>
      {% endfor %}
    </section>
  {% else %}
    <section class="interfacing-surface__panel">
      <h2>No surface slots</h2>
      <p class="interfacing-surface__empty">The controller returned a valid Viewing payload, but no location/slot data was provided.</p>
    </section>
  {% endif %}
</section>
