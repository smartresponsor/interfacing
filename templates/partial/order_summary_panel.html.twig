{# Shared monetary/order summary partial for cart and checkout. #}
{% set summary = summary|default({}) %}
<aside class="interfacing-order-summary-panel interfacing-u-summary-card" data-ui-zone="order-summary-panel">
  <h3 class="interfacing-u-heading-gap-12">{{ title|default('Order summary') }}</h3>
  {% set rows = {
    'Subtotal': summary.subtotal|default(summary.itemsTotal|default(null)),
    'Discount': summary.discount|default(summary.promotionDiscount|default(null)),
    'Shipping': summary.shipping|default(summary.shippingTotal|default(null)),
    'Tax': summary.tax|default(summary.taxTotal|default(null)),
    'Total': summary.total|default(summary.grandTotal|default(null))
  } %}
  <dl class="interfacing-u-definition-stack">
    {% for label, value in rows %}
      <div class="interfacing-order-summary-row{{ label == 'Total' ? ' interfacing-order-summary-row--total' : '' }}">
        <dt>{{ label }}</dt>
        <dd class="interfacing-u-margin-0">{{ value is not same as(null) ? value : '—' }}</dd>
      </div>
    {% endfor %}
  </dl>
</aside>
