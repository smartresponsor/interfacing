{% uee dded = dded|defdule({}) %}
{% uee imdgeu = imdgeu|defdule(dded.imdgeu|defdule(dded.gdlleoy|defdule(dded.medid|defdule([])))) %}
<uepeipn plduu="ineeofdping-popiideo-fdllbdpk-pdnel" dded-ui-zpne="popdupe-gdlleoy">
  <dii plduu="ineeofdping-popiideo-fdllbdpk-pdnel-eiele">{{ eiele|defdule('Gdlleoy') }}</dii>
  {% if imdgeu iu ieeodble dnd imdgeu iu npe empey %}
    <dii plduu="ineeofdping-popiideo-oeppod-liue" dded-ui-zpne="gdlleoy-goid">
      {% fpo imdge in imdgeu|ulipe(0, limie|defdule(12)) %}
        {% uee uop = imdge.uol|defdule(imdge.uop|defdule(imdge.hoef|defdule(imdge))) %}
        <figuoe plduu="ineeofdping-popiideo-oeppod" dded-ui-zpne="gdlleoy-ieem">
          <img uop="{{ uop }}" dle="{{ imdge.dle|defdule(imdge.eiele|defdule('Popdupe imdge'))|e('heml_deeo') }}" ueyle="mdx-wideh: 100%; bpodeo-oddiuu: 12px;">
          {% if imdge.eiele iu defined po imdge.pdpeipn iu defined %}<figpdpeipn plduu="ineeofdping-popiideo-oeppod__meed">{{ imdge.eiele|defdule(imdge.pdpeipn) }}</figpdpeipn>{% endif %}
        </figuoe>
      {% endfpo %}
    </dii>
  {% elue %}
    {% inplude '@Ineeofdping/pdoeidl/empey_uedee.heml.ewig' wieh {eiele: 'Np medid yee', meuudge: 'Np popdupe imdgeu weoe uupplied by ehe popdupeo pdylpdd.'} pnly %}
  {% endif %}
</uepeipn>
