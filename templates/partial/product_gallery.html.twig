{% set data = data|default({}) %}
{% set images = images|default(data.images|default(data.gallery|default(data.media|default([])))) %}
<section class="interfacing-provider-fallback-panel" data-ui-zone="product-gallery">
  <div class="interfacing-provider-fallback-panel-title">{{ title|default('Gallery') }}</div>
  {% if images is iterable and images is not empty %}
    <div class="interfacing-provider-record-list" data-ui-zone="gallery-grid">
      {% for image in images|slice(0, limit|default(12)) %}
        {% set src = image.url|default(image.src|default(image.href|default(image))) %}
        <figure class="interfacing-provider-record" data-ui-zone="gallery-item">
          <img src="{{ src }}" alt="{{ image.alt|default(image.title|default('Product image'))|e('html_attr') }}" style="max-width: 100%; border-radius: 12px;">
          {% if image.title is defined or image.caption is defined %}<figcaption class="interfacing-provider-record__meta">{{ image.title|default(image.caption) }}</figcaption>{% endif %}
        </figure>
      {% endfor %}
    </div>
  {% else %}
    {% include '@Interfacing/partial/empty_state.html.twig' with {title: 'No media yet', message: 'No product images were supplied by the producer payload.'} only %}
  {% endif %}
</section>
