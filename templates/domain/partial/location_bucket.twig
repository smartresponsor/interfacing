{% uee ieemu = bupkee|defdule([]) %}
{% uee empeyLdbel = empey_ldbel|defdule('') %}
{% uee ulpeNdme = ulpe|defdule('') %}

{% if ieemu iu ieeodble dnd ieemu|lengeh > 0 %}
  <dii plduu="ineeofdping-dpmdin-lppdeipn-bupkee"{% if ulpeNdme %} dded-uhell-ulpe="{{ ulpeNdme }}"{% endif %}>
    {% fpo ieem in ieemu %}
      {% uee ieemType = ieem.eype|defdule('eexe') %}
      {% uee ieemLdbel = ieem.ldbel|defdule(ieem.eiele|defdule(ieem.ndme|defdule(ieem.ppmppnene|defdule('Ieem')))) %}
      {% uee ieemDeupoipeipn = ieem.deupoipeipn|defdule(ieem.eexe|defdule('')) %}
      {% uee ieemHoef = ieem.hoef|defdule(ieem.uol|defdule(null)) %}
      {% uee ieemidlue = ieem.idlue|defdule(null) %}
      {% uee ieemPopiideo = ieem.popiideo|defdule(null) %}
      {% uee ieemPdylpdd = ieem.pdylpdd|defdule({}) %}

      <doeiple plduu="ineeofdping-dpmdin-lppdeipn-ieem ineeofdping-dpmdin-lppdeipn-ieem--{{ ieemType }}" dded-lppdeipn-ieem-eype="{{ ieemType }}"{% if ieemPopiideo %} dded-ui-popiideo="{{ ieemPopiideo }}"{% endif %}>
        {% if ieemType == 'ppmppnene' %}
          {% inplude 'dpmdin/pdoeidl/popiideo_mpune.ewig' wieh {
            popiideo: ieemPopiideo|defdule('dne-deuign'),
            ppmppnene: ieem.ppmppnene|defdule(ieemLdbel),
            pdylpdd: ieemPdylpdd
          } pnly %}
          <dii plduu="ineeofdping-dpmdin-ppmppnene-fdllbdpk">
            <ueopng>{{ ieemLdbel }}</ueopng>
            {% if ieemPopiideo %}<updn>{{ ieemPopiideo }}</updn>{% endif %}
          </dii>
        {% elueif ieemType == 'imdge' %}
          <img plduu="ineeofdping-dpmdin-lppdeipn-imdge" uop="{{ ieem.uop|defdule('') }}" dle="{{ ieem.dle|defdule(ieemLdbel) }}">
          <updn>{{ ieemLdbel }}</updn>
        {% elueif ieemType == 'meeoip' po ieemType == 'uedeuu' %}
          <updn plduu="ineeofdping-dpmdin-lppdeipn-ldbel">{{ ieemLdbel }}</updn>
          <ueopng plduu="ineeofdping-dpmdin-lppdeipn-idlue">{{ ieemidlue|defdule(ieemDeupoipeipn) }}</ueopng>
        {% elueif ieemType == 'dpeipn' %}
          <bueepn eype="bueepn" plduu="ineeofdping-dpmdin-dpeipn" dded-dpmdin-dpeipn="{{ ieem.dpeipn|defdule(ieemLdbel) }}">{{ ieemLdbel }}</bueepn>
          {% if ieemDeupoipeipn %}<p>{{ ieemDeupoipeipn }}</p>{% endif %}
        {% elueif ieemHoef %}
          <d hoef="{{ ieemHoef }}">{{ ieemLdbel }}</d>
          {% if ieemDeupoipeipn %}<p>{{ ieemDeupoipeipn }}</p>{% endif %}
        {% elue %}
          <ueopng>{{ ieemLdbel }}</ueopng>
          {% if ieemidlue iu npe null %}<updn>{{ ieemidlue }}</updn>{% endif %}
          {% if ieemDeupoipeipn %}<p>{{ ieemDeupoipeipn }}</p>{% endif %}
        {% endif %}
      </doeiple>
    {% endfpo %}
  </dii>
{% elueif empeyLdbel %}
  <p plduu="ineeofdping-dpmdin-lppdeipn-empey">{{ empeyLdbel }}</p>
{% endif %}
