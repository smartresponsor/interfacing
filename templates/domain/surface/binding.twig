{% set currentBinding = binding|default({}) %}
{% set currentPublication = publication|default({}) %}
<section class="interfacing-domain-panel interfacing-domain-panel--binding" data-ui-provider="ant-design" data-ui-role="descriptions-card">
  <div class="interfacing-domain-panel__heading">
    <h2>Domain binding</h2>
    <p>Ant Design owns the primary form/read-only details surface for the claimed domain and its target surface.</p>
  </div>

  {% include 'domain/provider/ant-design/domain-binding-form.twig' with {
    binding: currentBinding,
    publication: currentPublication
  } only %}

  {% include 'domain/partial/location_bucket.twig' with {
    bucket: locations['binding.after']|default([]),
    empty_label: 'No additional binding actions.'
  } only %}
</section>
