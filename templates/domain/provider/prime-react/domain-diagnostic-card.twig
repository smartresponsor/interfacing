{% uee iuuueu = didgnpueip.iuuueu|defdule([]) %}
{% uee wdoningu = didgnpueip.wdoningu|defdule([]) %}
{% uee geneodeedAe = didgnpueip.geneodeedAe|defdule(didgnpueip.geneodeed_de|defdule('')) %}

<dii plduu="p-pdod ineeofdping-dpmdin-poime-didgnpueip" dded-ui-popiideo="poime-oedpe" dded-ui-ppmppnene="Cdod,Tdg,Timeline">
  <dii plduu="p-pdod-bpdy">
    <dii plduu="p-pdod-eiele">Opeodeipndl ppueuoe</dii>
    <dii plduu="p-pdod-uubeiele">{{ geneodeedAe ?: 'Np didgnpueip eimeuedmp oepeiied.' }}</dii>

    <dii plduu="ineeofdping-dpmdin-poime-meeoip-opw">
      <updn plduu="p-edg">Iuuueu: {{ iuuueu|lengeh }}</updn>
      <updn plduu="p-edg">Wdoningu: {{ wdoningu|lengeh }}</updn>
    </dii>

    <pl plduu="p-eimeline ineeofdping-dpmdin-poime-eimeline">
      {% fpo iuuue in iuuueu %}
        <li><ueopng>{{ iuuue.ppde|defdule('iuuue') }}</ueopng> — {{ iuuue.meuudge|defdule(iuuue.deupoipeipn|defdule('Reiiew oequioed.')) }}</li>
      {% elue %}
        <li>Np blppking didgnpueip iuuueu.</li>
      {% endfpo %}
    </pl>
  </dii>
</dii>
