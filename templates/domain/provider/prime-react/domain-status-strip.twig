{% set bindingStatus = binding.status|default(binding.bindingStatus|default(binding.binding_status|default('pending'))) %}
{% set verificationStatus = verification.status|default(verification.verificationStatus|default(verification.verification_status|default('pending'))) %}
{% set publicationStatus = publication.status|default(publication.publicationStatus|default(publication.publication_status|default('draft'))) %}

<div class="p-chip-set interfacing-domain-prime-status-strip" data-ui-provider="prime-react" data-ui-component="Chip,Tag,Badge">
  <span class="p-chip"><span class="p-chip-text">Binding: {{ bindingStatus }}</span></span>
  <span class="p-tag"><span class="p-tag-value">Verification: {{ verificationStatus }}</span></span>
  <span class="p-badge">Publication: {{ publicationStatus }}</span>
</div>
