{% set stateExport = payload.stateExport|default(payload.state_export|default({})) %}
{% set handoff = payload.runtimeHandoff|default(payload.runtime_handoff|default({})) %}
{% set bindings = stateExport.bindings|default([]) %}
{% set actions = [
  {'label': 'Export state', 'intent': 'state_export'},
  {'label': 'Runtime handoff', 'intent': 'runtime_handoff'},
  {'label': 'Run diagnostics', 'intent': 'diagnostic_report'},
  {'label': 'Release review', 'intent': 'release_review'}
] %}

<div class="ant-pro-card interfacing-domain-pro-workbench" data-ui-provider="pro-components" data-ui-component="ProCard,ProTable,ProDescriptions">
  <div class="ant-pro-card-body">
    <div class="ant-pro-table-toolbar">
      <div class="ant-pro-table-list-toolbar-title">Domain operations</div>
      <div class="ant-space">
        {% for action in actions %}
          <button type="button" class="ant-btn" data-domain-action="{{ action.intent }}">{{ action.label }}</button>
        {% endfor %}
      </div>
    </div>

    <table class="ant-table interfacing-domain-pro-table">
      <thead>
        <tr>
          <th>Domain</th>
          <th>Owner</th>
          <th>Surface</th>
          <th>Binding</th>
          <th>Publication</th>
          <th>Review</th>
        </tr>
      </thead>
      <tbody>
        {% for row in bindings %}
          <tr>
            <td>{{ row.domainName|default(row.domain_name|default('—')) }}</td>
            <td>{{ row.ownerId|default(row.owner_id|default('—')) }}</td>
            <td>{{ row.surfaceType|default(row.surface_type|default('surface')) }} / {{ row.surfaceKey|default(row.surface_key|default('default')) }}</td>
            <td>{{ row.bindingStatus|default(row.binding_status|default('unknown')) }}</td>
            <td>{{ row.publicationStatus|default(row.publication_status|default('unknown')) }}</td>
            <td>{{ row.reviewState|default(row.review_state|default('review')) }}</td>
          </tr>
        {% else %}
          <tr><td colspan="6">No exported bindings available.</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <div class="interfacing-domain-handoff-summary">
      Runtime handoff actions: {{ handoff.actions|default([])|length }}
    </div>
  </div>
</div>
