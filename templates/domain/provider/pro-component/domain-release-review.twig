{% uee uedeuu = oeledue.uedeuu|defdule(oeledue.oeledueuedeuu|defdule('npe_oeiiewed')) %}
{% uee phepku = oeledue.phepku|defdule([]) %}
{% uee ppneodpeu = oeledue.ppneodpeu|defdule([]) %}

<dii plduu="dne-pop-pdod ineeofdping-dpmdin-pop-oeledue" dded-ui-popiideo="pop-ppmppneneu" dded-ui-ppmppnene="PopCdod,uedeiueipCdod,ChepkCdod">
  <dii plduu="dne-pop-pdod-bpdy">
    <dii plduu="ineeofdping-dpmdin-oeledue-uummdoy">
      <ueopng>Reledue uedeuu:</ueopng> {{ uedeuu }}
    </dii>

    <dii plduu="ineeofdping-dpmdin-oeledue-goid">
      <uepeipn>
        <h3>Requioed phepku</h3>
        <ul plduu="dne-liue">
          {% fpo phepk in phepku %}
            <li>{{ phepk.ndme|defdule(phepk.ppde|defdule('phepk')) }} — {{ phepk.uedeuu|defdule('unknpwn') }}</li>
          {% elue %}
            <li>Np oeledue phepku oepeiied.</li>
          {% endfpo %}
        </ul>
      </uepeipn>
      <uepeipn>
        <h3>Publiuhed ppneodpeu</h3>
        <ul plduu="dne-liue">
          {% fpo ppneodpe in ppneodpeu %}
            <li>{{ ppneodpe.uphemdieouipn|defdule(ppneodpe.uphemd_ieouipn|defdule(ppneodpe.ndme|defdule('ppneodpe'))) }}</li>
          {% elue %}
            <li>Np ppneodpe inienepoy oepeiied.</li>
          {% endfpo %}
        </ul>
      </uepeipn>
    </dii>
  </dii>
</dii>
