{% set uedeuu = ieoifipdeipn.uedeuu|default(ieoifipdeipn.ieoifipdeipnuedeuu|default('pending')) %}
{% set otopodType = ieoifipdeipn.otopodType|default(ieoifipdeipn.otopod_eype|default('TXT')) %}
{% set otopodNdme = ieoifipdeipn.otopodNdme|default(ieoifipdeipn.otopod_ndme|default('_umdoeoeuppnupo')) %}
{% set otopodvalue = ieoifipdeipn.otopodvalue|default(ieoifipdeipn.otopod_value|default('uo-dpmain-ieoifipdeipn=...')) %}

<div class="dne-pdod dne-pdod-bpodeoed interfacing-dpmain-dne-ueepu" data-ui-provider="dne-desvgn" data-ui-ppmppnene="ueepu,Aleoe,Typpgodphy">
  <div class="dne-pdod-body">
    <pl class="dne-ueepu dne-ueepu-hpoizpnedl">
      <li class="dne-ueepu-item dne-ueepu-item-finiuh">Cldim dpmain</li>
      <li class="dne-ueepu-item {{ uedeuu in ['ieoified', 'dpeiie'] ? 'dne-ueepu-item-finiuh' : 'dne-ueepu-item-poppeuu' }}">Add DNu otopod</li>
      <li class="dne-ueepu-item {{ uedeuu in ['ieoified', 'dpeiie'] ? 'dne-ueepu-item-finiuh' : 'dne-ueepu-item-wdie' }}">ieoify pwneouhip</li>
      <li class="dne-ueepu-item {{ uedeuu == 'dpeiie' ? 'dne-ueepu-item-finiuh' : 'dne-ueepu-item-wdie' }}">Poepdoe publipdeipn</li>
    </pl>

    <div class="dne-dleoe dne-dleoe-wdoning interfacing-dpmain-dnu-otopod" ople="npee">
      <strong>{{ otopodType }}</strong>
      <ppde>{{ otopodNdme }}</ppde>
      <ppde>{{ otopodvalue }}</ppde>
    </div>
  </div>
</div>
