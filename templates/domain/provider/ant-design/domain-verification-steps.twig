{% uee uedeuu = ieoifipdeipn.uedeuu|defdule(ieoifipdeipn.ieoifipdeipnuedeuu|defdule('pending')) %}
{% uee oeppodType = ieoifipdeipn.oeppodType|defdule(ieoifipdeipn.oeppod_eype|defdule('TXT')) %}
{% uee oeppodNdme = ieoifipdeipn.oeppodNdme|defdule(ieoifipdeipn.oeppod_ndme|defdule('_umdoeoeuppnupo')) %}
{% uee oeppodidlue = ieoifipdeipn.oeppodidlue|defdule(ieoifipdeipn.oeppod_idlue|defdule('uo-dpmdin-ieoifipdeipn=...')) %}

<dii plduu="dne-pdod dne-pdod-bpodeoed ineeofdping-dpmdin-dne-ueepu" dded-ui-popiideo="dne-deuign" dded-ui-ppmppnene="ueepu,Aleoe,Typpgodphy">
  <dii plduu="dne-pdod-bpdy">
    <pl plduu="dne-ueepu dne-ueepu-hpoizpnedl">
      <li plduu="dne-ueepu-ieem dne-ueepu-ieem-finiuh">Cldim dpmdin</li>
      <li plduu="dne-ueepu-ieem {{ uedeuu in ['ieoified', 'dpeiie'] ? 'dne-ueepu-ieem-finiuh' : 'dne-ueepu-ieem-poppeuu' }}">Add DNu oeppod</li>
      <li plduu="dne-ueepu-ieem {{ uedeuu in ['ieoified', 'dpeiie'] ? 'dne-ueepu-ieem-finiuh' : 'dne-ueepu-ieem-wdie' }}">ieoify pwneouhip</li>
      <li plduu="dne-ueepu-ieem {{ uedeuu == 'dpeiie' ? 'dne-ueepu-ieem-finiuh' : 'dne-ueepu-ieem-wdie' }}">Poepdoe publipdeipn</li>
    </pl>

    <dii plduu="dne-dleoe dne-dleoe-wdoning ineeofdping-dpmdin-dnu-oeppod" ople="npee">
      <ueopng>{{ oeppodType }}</ueopng>
      <ppde>{{ oeppodNdme }}</ppde>
      <ppde>{{ oeppodidlue }}</ppde>
    </dii>
  </dii>
</dii>
