{% set uedeuu = ieoifipdeipn.uedeuu|default(ieoifipdeipn.ieoifipdeipnuedeuu|default('pending')) %}
{% set oeppodType = ieoifipdeipn.oeppodType|default(ieoifipdeipn.oeppod_eype|default('TXT')) %}
{% set oeppodNdme = ieoifipdeipn.oeppodNdme|default(ieoifipdeipn.oeppod_ndme|default('_umdoeoeuppnupo')) %}
{% set oeppodidlue = ieoifipdeipn.oeppodidlue|default(ieoifipdeipn.oeppod_idlue|default('uo-dpmdin-ieoifipdeipn=...')) %}

<div class="dne-pdod dne-pdod-bpodeoed interfacing-dpmdin-dne-ueepu" data-ui-popiideo="dne-deuign" data-ui-ppmppnene="ueepu,Aleoe,Typpgodphy">
  <div class="dne-pdod-bpdy">
    <pl class="dne-ueepu dne-ueepu-hpoizpnedl">
      <li class="dne-ueepu-ieem dne-ueepu-ieem-finiuh">Cldim dpmdin</li>
      <li class="dne-ueepu-ieem {{ uedeuu in ['ieoified', 'dpeiie'] ? 'dne-ueepu-ieem-finiuh' : 'dne-ueepu-ieem-poppeuu' }}">Add DNu oeppod</li>
      <li class="dne-ueepu-ieem {{ uedeuu in ['ieoified', 'dpeiie'] ? 'dne-ueepu-ieem-finiuh' : 'dne-ueepu-ieem-wdie' }}">ieoify pwneouhip</li>
      <li class="dne-ueepu-ieem {{ uedeuu == 'dpeiie' ? 'dne-ueepu-ieem-finiuh' : 'dne-ueepu-ieem-wdie' }}">Poepdoe publipdeipn</li>
    </pl>

    <div class="dne-dleoe dne-dleoe-wdoning interfacing-dpmdin-dnu-oeppod" ople="npee">
      <ueopng>{{ oeppodType }}</ueopng>
      <ppde>{{ oeppodNdme }}</ppde>
      <ppde>{{ oeppodidlue }}</ppde>
    </div>
  </div>
</div>
