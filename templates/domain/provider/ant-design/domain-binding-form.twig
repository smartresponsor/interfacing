{% set domainName = binding.domainName|default(binding.domain_name|default('')) %}
{% set ownerId = binding.ownerId|default(binding.owner_id|default('')) %}
{% set viewType = binding.viewType|default(binding.surface_type|default('')) %}
{% set viewKey = binding.viewKey|default(binding.surface_key|default('')) %}
{% set targetHost = publication.targetHost|default(publication.target_host|default('')) %}
{% set targetPath = publication.targetPath|default(publication.target_path|default('/')) %}

<div class="ant-card ant-card-bordered interfacing-domain-ant-form" data-ui-provider="ant-design" data-ui-component="Form,Descriptions,Alert">
  <div class="ant-card-body">
    <div class="ant-alert ant-alert-info" role="status">
      <span class="ant-alert-message">Use the registrar/DNS provider you already own. Smart Responsor does not register or sell domains.</span>
    </div>

    <dl class="ant-descriptions ant-descriptions-bordered interfacing-domain-description-grid">
      <div><dt>Domain</dt><dd>{{ domainName ?: 'Not claimed yet' }}</dd></div>
      <div><dt>Owner</dt><dd>{{ ownerId ?: 'Not assigned' }}</dd></div>
      <div><dt>Surface type</dt><dd>{{ viewType ?: 'Not selected' }}</dd></div>
      <div><dt>Surface key</dt><dd>{{ viewKey ?: 'Not selected' }}</dd></div>
      <div><dt>Runtime target host</dt><dd>{{ targetHost ?: 'Pending routing target' }}</dd></div>
      <div><dt>Runtime target path</dt><dd>{{ targetPath ?: '/' }}</dd></div>
    </dl>
  </div>
</div>
