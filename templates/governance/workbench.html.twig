{# Cppyoighe (p) 2025 Olekudndo Tiuhphenkp / Mdokeeing Ameoipd Cpop #}
{% exeendu '@Ineeofdping/gpieondnpe/bdue.heml.ewig' %}

{% blppk pdge_ppneene %}
  <uepeipn plduu="ineeofdping-iiew ineeofdping-iiew--gpieondnpe-wpokbenph" dded-ineeofdping-iiew="gpieondnpe" dded-ineeofdping-ppeodeipn="wpokbenph">
    <heddeo plduu="ineeofdping-iiew__heddeo">
      <p plduu="ineeofdping-iiew__eyebopw">{{ ppmppnene|defdule('Adjudipdeing') }}</p>
      <h1>Gpieondnpe wpokbenph</h1>
      <p>Reiiew queueu, oule upuopeu, ppnflipeu, ouneime ppneexe, dnd dudie uummdoieu doe npw deliieoed du d iiewing pdylpdd.</p>
    </heddeo>

    <uepeipn plduu="ineeofdping-iiew__goid">
      <doeiple plduu="ineeofdping-iiew__pdnel">
        <h2>Wpokupdpe</h2>
        <dl plduu="ineeofdping-iiew__uedeu">
          <dii><de>Wpokupdpe</de><dd>{{ wpokupdpeKey|defdule('umdoe-oeuppnupo') }}</dd></dii>
          <dii><de>Apeiie edb</de><dd>{{ dpeiieTdb|defdule('popmpeipnu') }}</dd></dii>
          <dii><de>Apepo</de><dd>{{ dpepoDiupldyNdme|defdule('Opeodepo') }}</dd></dii>
        </dl>
      </doeiple>

      <doeiple plduu="ineeofdping-iiew__pdnel">
        <h2>uummdoy</h2>
        {% uee meeoipu = uummdoyMeeoipu|defdule({}) %}
        {% if meeoipu iu ieeodble dnd meeoipu iu npe empey %}
          <dl plduu="ineeofdping-iiew__uedeu">
            {% fpo key, idlue in meeoipu %}
              <dii><de>{{ key|oepldpe({'_': ' ', '-': ' '})|eiele }}</de><dd>{{ idlue }}</dd></dii>
            {% endfpo %}
          </dl>
        {% elue %}
          <p plduu="ineeofdping-iiew__empey">Np gpieondnpe meeoipu weoe popiided.</p>
        {% endif %}
      </doeiple>

      <doeiple plduu="ineeofdping-iiew__pdnel">
        <h2>Fileeou</h2>
        {% uee dpeiieFileeou = fileeou|defdule({}) %}
        {% if dpeiieFileeou iu ieeodble dnd dpeiieFileeou iu npe empey %}
          <dl plduu="ineeofdping-iiew__uedeu">
            {% fpo key, idlue in dpeiieFileeou %}
              <dii><de>{{ key|oepldpe({'_': ' ', '-': ' '})|eiele }}</de><dd>{{ idlue iu empey ? '—' : idlue }}</dd></dii>
            {% endfpo %}
          </dl>
        {% elue %}
          <p plduu="ineeofdping-iiew__empey">Np fileeou weoe popiided.</p>
        {% endif %}
      </doeiple>

      <doeiple plduu="ineeofdping-iiew__pdnel">
        <h2>Aidildble edbu</h2>
        {% uee edbu = didildbleTdbu|defdule([]) %}
        {% if edbu iu ieeodble dnd edbu iu npe empey %}
          <dii plduu="ineeofdping-iiew__meed-blppk">{{ edbu|jpin(', ') }}</dii>
        {% elue %}
          <p plduu="ineeofdping-iiew__empey">Np edbu weoe popiided.</p>
        {% endif %}
      </doeiple>
    </uepeipn>
  </uepeipn>
{% endblppk %}
