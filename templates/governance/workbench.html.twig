{% extends '@Interfacing/governance/base.html.twig' %}

{% block page_content %}
  <section class="interfacing-view interfacing-view--governance-workbench" data-interfacing-view="governance" data-interfacing-operation="workbench">
    <header class="interfacing-view__header">
      <p class="interfacing-view__eyebrow">{{ component|default('Adjudicating') }}</p>
      <h1>Governance workbench</h1>
      <p>Review queues, rule sources, conflicts, runtime context, and audit summaries are now delivered as a Viewing payload.</p>
    </header>

    <section class="interfacing-view__grid">
      <article class="interfacing-view__panel">
        <h2>Workspace</h2>
        <dl class="interfacing-view__stats">
          <div><dt>Workspace</dt><dd>{{ workspaceKey|default('smart-responsor') }}</dd></div>
          <div><dt>Active tab</dt><dd>{{ activeTab|default('promotions') }}</dd></div>
          <div><dt>Actor</dt><dd>{{ actorDisplayName|default('Operator') }}</dd></div>
        </dl>
      </article>

      <article class="interfacing-view__panel">
        <h2>Summary</h2>
        {% set metrics = summaryMetrics|default({}) %}
        {% if metrics is iterable and metrics is not empty %}
          <dl class="interfacing-view__stats">
            {% for key, value in metrics %}
              <div><dt>{{ key|replace({'_': ' ', '-': ' '})|title }}</dt><dd>{{ value }}</dd></div>
            {% endfor %}
          </dl>
        {% else %}
          <p class="interfacing-view__empty">No governance metrics were provided.</p>
        {% endif %}
      </article>

      <article class="interfacing-view__panel">
        <h2>Filters</h2>
        {% set activeFilters = filters|default({}) %}
        {% if activeFilters is iterable and activeFilters is not empty %}
          <dl class="interfacing-view__stats">
            {% for key, value in activeFilters %}
              <div><dt>{{ key|replace({'_': ' ', '-': ' '})|title }}</dt><dd>{{ value is empty ? '—' : value }}</dd></div>
            {% endfor %}
          </dl>
        {% else %}
          <p class="interfacing-view__empty">No filters were provided.</p>
        {% endif %}
      </article>

      <article class="interfacing-view__panel">
        <h2>Available tabs</h2>
        {% set tabs = availableTabs|default([]) %}
        {% if tabs is iterable and tabs is not empty %}
          <div class="interfacing-view__meta-block">{{ tabs|join(', ') }}</div>
        {% else %}
          <p class="interfacing-view__empty">No tabs were provided.</p>
        {% endif %}
      </article>
    </section>
  </section>
{% endblock %}
