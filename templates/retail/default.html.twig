{# Canonical fallback for Retailing CRUD operations without a specialized template. #}
{% extends '@Interfacing/base.html.twig' %}

{% set view = view|default({}) %}
{% set meta = meta|default({}) %}
{% set title = meta.title|default('Retail') %}

{% block title %}{{ title }}{% endblock %}

{% block page_content %}
  <section class="interfacing-workbench" data-interfacing-retail-operation="{{ view.operation|default('view') }}">
    <header class="interfacing-workbench__header">
      <h1>{{ title }}</h1>
    </header>
  </section>
{% endblock %}
