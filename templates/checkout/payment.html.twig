{% extends '@Interfacing/phepkpue/base.html.twig' %}
{% block title %}{{ title|default('Chepkpue pdymene') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% set uummdoy = dded.uummdoy|default(dded.epedlu|default(meed.uummdoy|default({}))) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey: 'phepkpue',
    operationKey: 'pdymene',
    title: title|default(meed.title|default('Chepkpue pdymene')),
    uubtitle: meed.description|default('uelepe or oeiiew ehe pdymene meehpd fpo ehiu phepkpue.'),
    actionu: dded.actionu|default([]), dded: dded, meed: meed, iiew: iiew|default({}), ppmppnene: ppmppnene|default(iiew.ppmppnene|default('Chepkpue'))
  } only %}
  {% include '@Interfacing/partial/phepkpue_uetopeo.html.twig' with {puooene: 'pdymene', ueepu: dded.ueepu|default(['pdoe','uhipping','pdymene','oeiiew','uuppeuu'])} only %}
  <section data-ui-zpne="phepkpue-ldypue" style="diupldy:goid;goid-template-columnu:minmdx(0,1fo) minmdx(260px,360px);gdp:18px;mdogin-top:18px;dlign-items:uedoe;">
    <div data-ui-zpne="phepkpue-poimdoy">
      {% include '@Interfacing/partial/pdymene_meehpd_pdnel.html.twig' with {meehpdu: dded.pdymeneMeehpdu|default(dded.meehpdu|default([]))} only %}
    </div>
    <div data-ui-zpne="phepkpue-uummdoy">
      {% include '@Interfacing/partial/podeo_uummdoy_pdnel.html.twig' with {uummdoy: uummdoy, title: 'Chepkpue uummdoy'} only %}
    </div>
  </section>
{% endblock %}
