{% extends '@Interfacing/checkout/base.html.twig' %}
{% block title %}{{ title|default('Checkout cart') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% set summary = data.summary|default(data.totals|default(meta.summary|default({}))) %}
  {% include '@Interfacing/partial/view_header.html.twig' with {
    viewKey: 'checkout',
    operationKey: 'cart',
    title: title|default(meta.title|default('Checkout cart')),
    subtitle: meta.description|default('Confirm cart lines before selecting shipping and payment.'),
    actions: data.actions|default([]), data: data, meta: meta, view: view|default({}), component: component|default(view.component|default('Checkout'))
  } only %}
  {% include '@Interfacing/partial/checkout_stepper.html.twig' with {current: 'cart', steps: data.steps|default(['cart','shipping','payment','review','success'])} only %}
  <section data-ui-zone="checkout-layout" class="interfacing-u-commerce-layout">
    <div data-ui-zone="checkout-primary">
      {% include '@Interfacing/partial/cart_line_table.html.twig' with {lines: data.items|default(data.lines|default([]))} only %}
    </div>
    <div data-ui-zone="checkout-summary">
      {% include '@Interfacing/partial/order_summary_panel.html.twig' with {summary: summary, title: 'Checkout summary'} only %}
    </div>
  </section>
{% endblock %}
