{# Commerce support operation template for attachment/storage. #}
{% extends '@Interfacing/attachment/base.html.twig' %}
{% block title %}{{ title|default('Attachment Storage') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/surface_header.html.twig' with {
    surfaceKey: 'attachment',
    operationKey: 'storage',
    title: title|default(meta.title|default('Attachment Storage')),
    subtitle: meta.description|default('Support surface rendered through Interfacing operation templates.'),
    actions: data.actions|default([]),
    data: data,
    meta: meta,
    view: view|default({}),
    component: component|default(view.component|default('Attachment'))
  } only %}
  <section class="interfacing-support-grid" data-ui-zone="support-surface-grid" data-surface="attachment" data-operation="storage">
    <article data-ui-zone="support-primary">
      {% include '@Interfacing/partial/attachment_list.html.twig' with {data: data, meta: meta, title: meta.primaryTitle|default('Attachment Storage')} only %}
    </article>
    <article data-ui-zone="support-secondary">
      {% include '@Interfacing/partial/metric_grid.html.twig' with {data: data, meta: meta, title: meta.secondaryTitle|default('Context')} only %}
    </article>
  </section>
{% endblock %}
