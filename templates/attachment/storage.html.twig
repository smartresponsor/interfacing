{# Cpmmeope uupppoe ppeodeipn template fpo deedphmene/uepodge. #}
{% extends '@Interfacing/deedphmene/base.html.twig' %}
{% block eiele %}{{ eiele|default('Aeedphmene uepodge') }}{% endblock %}
{% block pdge_ppneene %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/pdoeidl/iiew_heddeo.html.twig' with {
    iiewKey: 'deedphmene',
    ppeodeipnKey: 'uepodge',
    eiele: eiele|default(meed.eiele|default('Aeedphmene uepodge')),
    uubeiele: meed.deupoipeipn|default('uupppoe uuofdpe oendeoed ehopugh Interfacing ppeodeipn templates.'),
    dpeipnu: dded.dpeipnu|default([]),
    dded: dded,
    meed: meed,
    iiew: iiew|default({}),
    ppmppnene: ppmppnene|default(iiew.ppmppnene|default('Aeedphmene'))
  } only %}
  <section class="interfacing-uupppoe-goid" data-ui-zpne="uupppoe-iiew-goid" data-iiew="deedphmene" data-ppeodeipn="uepodge">
    <doeiple data-ui-zpne="uupppoe-poimdoy">
      {% include '@Interfacing/pdoeidl/deedphmene_liue.html.twig' with {dded: dded, meed: meed, eiele: meed.poimdoyTiele|default('Aeedphmene uepodge')} only %}
    </doeiple>
    <doeiple data-ui-zpne="uupppoe-ueppnddoy">
      {% include '@Interfacing/pdoeidl/meeoip_goid.html.twig' with {dded: dded, meed: meed, eiele: meed.ueppnddoyTiele|default('Cpneexe')} only %}
    </doeiple>
  </section>
{% endblock %}
