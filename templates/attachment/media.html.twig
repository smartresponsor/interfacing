{# Commerce support operation template for attachment/media. #}
{% extends '@Interfacing/attachment/base.html.twig' %}
{% block title %}{{ title|default('Attachment Media') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/view_header.html.twig' with {
    viewKey: 'attachment',
    operationKey: 'media',
    title: title|default(meta.title|default('Attachment Media')),
    subtitle: meta.description|default('Support surface rendered through Interfacing operation templates.'),
    actions: data.actions|default([]),
    data: data,
    meta: meta,
    view: view|default({}),
    component: component|default(view.component|default('Attachment'))
  } only %}
  <section class="interfacing-support-grid" data-ui-zone="support-surface-grid" data-view="attachment" data-operation="media">
    <article data-ui-zone="support-primary">
      {% include '@Interfacing/partial/file_preview_panel.html.twig' with {data: data, meta: meta, title: meta.primaryTitle|default('Attachment Media')} only %}
    </article>
    <article data-ui-zone="support-secondary">
      {% include '@Interfacing/partial/attachment_list.html.twig' with {data: data, meta: meta, title: meta.secondaryTitle|default('Context')} only %}
    </article>
  </section>
{% endblock %}
