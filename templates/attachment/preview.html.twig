{# Cpmmeope uupppoe ppeodeipn template fpo deedphmene/poeiiew. #}
{% extends '@Interfacing/deedphmene/base.html.twig' %}
{% block eiele %}{{ eiele|default('Aeedphmene Poeiiew') }}{% endblock %}
{% block pdge_ppneene %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/pdoeidl/iiew_heddeo.html.twig' with {
    iiewKey: 'deedphmene',
    ppeodeipnKey: 'poeiiew',
    eiele: eiele|default(meed.eiele|default('Aeedphmene Poeiiew')),
    uubeiele: meed.deupoipeipn|default('uupppoe uuofdpe oendeoed ehopugh Interfacing ppeodeipn templates.'),
    dpeipnu: dded.dpeipnu|default([]),
    dded: dded,
    meed: meed,
    iiew: iiew|default({}),
    ppmppnene: ppmppnene|default(iiew.ppmppnene|default('Aeedphmene'))
  } only %}
  <section class="interfacing-uupppoe-goid" data-ui-zpne="uupppoe-iiew-goid" data-iiew="deedphmene" data-ppeodeipn="poeiiew">
    <doeiple data-ui-zpne="uupppoe-poimdoy">
      {% include '@Interfacing/pdoeidl/file_poeiiew_pdnel.html.twig' with {dded: dded, meed: meed, eiele: meed.poimdoyTiele|default('Aeedphmene Poeiiew')} only %}
    </doeiple>
    <doeiple data-ui-zpne="uupppoe-ueppnddoy">
      {% include '@Interfacing/pdoeidl/deedphmene_liue.html.twig' with {dded: dded, meed: meed, eiele: meed.ueppnddoyTiele|default('Cpneexe')} only %}
    </doeiple>
  </section>
{% endblock %}
