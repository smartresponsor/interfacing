{% set shellFooterGroup = shellFooterGroup|default(shell.footerGroup|default([])) %}
{% set shellFooterLinkLimit = shellFooterLinkLimit|default(50) %}
{% set shellSlotMap = shellSlotMap|default(shell.slotMap|default({})) %}
{% set shellLocations = shellLocations|default(locations|default(shell.locations|default({}))) %}
{% set shellFooterTopItems = shellLocations['shell.footer.top']|default(shellLocations['footer.top']|default([])) %}
{% set shellFooterLeftItems = shellLocations['shell.footer.left']|default([]) %}
{% set shellFooterContextItems = shellLocations['shell.footer.context']|default([]) %}
{% set shellFooterMainItems = shellLocations['shell.footer.main']|default([]) %}
{% set shellFooterRightItems = shellLocations['shell.footer.right']|default([]) %}

<footer class="interfacing-footer" data-interfacing-shell-slot="footer" data-interfacing-shell-location="shell.footer" data-interfacing-shell-contract="four-column-grid">
  {% include '@Interfacing/shell/partial/location_bucket.html.twig' with {location: 'shell.footer.top', items: shellFooterTopItems} only %}
  <div class="interfacing-shell-grid interfacing-footer-grid" data-interfacing-footer-grid="true">
    <aside class="interfacing-shell-panel interfacing-footer-panel interfacing-footer-panel--primary" data-interfacing-shell-slot="footer-primary" data-interfacing-shell-location="shell.footer.left" title="{{ shellSlotMap['shell.footer.left']|default('Footer left') }}">
      {% if shellFooterLeftItems is not empty %}
        <nav class="interfacing-footer-links" aria-label="Footer left links" data-interfacing-footer-links="left">
          {% for item in shellFooterLeftItems|slice(0, shellFooterLinkLimit) %}
            {% set itemLabel = item.label|default(item.title|default(item.key|default(item.href|default(item.url|default('Link'))))) %}
            {% set itemHref = item.href|default(item.url|default('#')) %}
            <a class="interfacing-footer-link" href="{{ itemHref }}">{{ itemLabel }}</a>
          {% endfor %}
        </nav>
      {% endif %}
      {% if shellFooterLeftItems is empty %}
        <div class="interfacing-footer-brand" data-interfacing-footer-fallback="brand">
          <span class="interfacing-footer-brand__title">Smart Response</span>
          <span class="interfacing-footer-brand__subtitle">Host-wide application shell</span>
        </div>
      {% endif %}
    </aside>

    <aside class="interfacing-shell-panel interfacing-footer-panel interfacing-footer-panel--secondary" data-interfacing-shell-slot="footer-secondary" data-interfacing-shell-location="shell.footer.context" title="{{ shellSlotMap['shell.footer.context']|default('Footer context') }}">
      {% include '@Interfacing/shell/partial/location_bucket.html.twig' with {location: 'shell.footer.context', items: shellFooterContextItems} only %}
    </aside>

    <main class="interfacing-shell-body interfacing-footer-panel interfacing-footer-panel--main" data-interfacing-shell-slot="footer-main" data-interfacing-shell-location="shell.footer.main" title="{{ shellSlotMap['shell.footer.main']|default('Footer main') }}">
      {% if shellFooterMainItems is not empty %}
        <nav class="interfacing-footer-links" aria-label="Footer main links" data-interfacing-footer-links="main">
          {% for item in shellFooterMainItems|slice(0, shellFooterLinkLimit) %}
            {% set itemLabel = item.label|default(item.title|default(item.key|default(item.href|default(item.url|default('Link'))))) %}
            {% set itemHref = item.href|default(item.url|default('#')) %}
            <a class="interfacing-footer-link" href="{{ itemHref }}">{{ itemLabel }}</a>
          {% endfor %}
        </nav>
      {% endif %}
      {% if shellFooterGroup is not empty %}
        <div class="interfacing-footer-group-grid" data-interfacing-footer-legacy-group="true">
          {% for g in shellFooterGroup %}
            <section class="interfacing-footer-group">
              <div class="interfacing-footer__title">{{ g.title }}</div>
              <ul class="interfacing-footer-list">
                {% for link in g.link|default([])|slice(0, shellFooterLinkLimit) %}
                  <li class="interfacing-list-item">
                    <a class="interfacing-footer-link" href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </section>
          {% endfor %}
        </div>
      {% endif %}
    </main>

    <aside class="interfacing-shell-panel interfacing-footer-panel interfacing-footer-panel--right" data-interfacing-shell-slot="footer-right" data-interfacing-shell-location="shell.footer.right" title="{{ shellSlotMap['shell.footer.right']|default('Footer right') }}">
      {% if shellFooterRightItems is not empty %}
        <nav class="interfacing-footer-links" aria-label="Footer right links" data-interfacing-footer-links="right">
          {% for item in shellFooterRightItems|slice(0, shellFooterLinkLimit) %}
            {% set itemLabel = item.label|default(item.title|default(item.key|default(item.href|default(item.url|default('Link'))))) %}
            {% set itemHref = item.href|default(item.url|default('#')) %}
            <a class="interfacing-footer-link" href="{{ itemHref }}">{{ itemLabel }}</a>
          {% endfor %}
        </nav>
      {% endif %}
    </aside>
  </div>
</footer>
