{% set shellFooterGroup = shellFooterGroup|default(shell.footerGroup|default([])) %}
{% set shellFooterLinkLimit = shellFooterLinkLimit|default(50) %}
{% set shellSlotMap = shellSlotMap|default(shell.slotMap|default({})) %}
{% set shellLocations = shellLocations|default(locations|default(shell.locations|default({}))) %}
{% set footerAttributes = footerAttributes|default('') %}
{% set shellFooterTopItems = shellLocations['shell.footer.top']|default(shellLocations['footer.top']|default([])) %}
{% set shellFooterLeftItems = shellLocations['shell.footer.left']|default([]) %}
{% set shellFooterContextItems = shellLocations['shell.footer.context']|default([]) %}
{% set shellFooterMainItems = shellLocations['shell.footer.main']|default([]) %}
{% set shellFooterRightItems = shellLocations['shell.footer.right']|default([]) %}
{% set footerLocaleSelector = locale_selector() %}
{% set footerSupportItems = [] %}
{% set footerFeaturedLocaleItems = [] %}
{% for item in shellFooterMainItems %}
  {% if item.metadata.locale_featured|default(false) and item.metadata.locale_code|default('') is not empty %}
    {% set footerFeaturedLocaleItems = footerFeaturedLocaleItems|merge([item]) %}
  {% else %}
    {% set footerSupportItems = footerSupportItems|merge([item]) %}
  {% endif %}
{% endfor %}
{% if footerFeaturedLocaleItems is empty %}
  {% set featuredLocaleLabels = {'en': 'English', 'ru': 'Русский', 'uk': 'Українська', 'fr': 'Français'} %}
  {% for localeCode, localeLabel in featuredLocaleLabels %}
    {% set footerFeaturedLocaleItems = footerFeaturedLocaleItems|merge([{
      key: 'locale_' ~ localeCode,
      label: localeLabel,
      href: footerLocaleSelector.action ~ '?locale=' ~ localeCode,
      metadata: {locale_code: localeCode, locale_featured: true}
    }]) %}
  {% endfor %}
{% endif %}
{% set featuredLocaleCodes = [] %}
{% for item in footerFeaturedLocaleItems %}
  {% set featuredLocaleCodes = featuredLocaleCodes|merge([item.metadata.locale_code]) %}
{% endfor %}
{% set footerOtherLocaleOptions = [] %}
{% for option in footerLocaleSelector.options %}
  {% if option.code not in featuredLocaleCodes %}
    {% set footerOtherLocaleOptions = footerOtherLocaleOptions|merge([option]) %}
  {% endif %}
{% endfor %}
{% if footerOtherLocaleOptions is empty %}
  {% set fallbackOtherLocales = {
    'es': 'Español',
    'de': 'Deutsch',
    'pl': 'Polski',
    'pt': 'Português',
    'it': 'Italiano',
    'nl': 'Nederlands',
    'tr': 'Türkçe',
    'ar': 'العربية'
  } %}
  {% for localeCode, nativeName in fallbackOtherLocales %}
    {% set footerOtherLocaleOptions = footerOtherLocaleOptions|merge([{
      code: localeCode,
      nativeName: nativeName,
      current: footerLocaleSelector.currentLocale == localeCode
    }]) %}
  {% endfor %}
{% endif %}

<footer class="interfacing-footer" data-interfacing-shell-slot="footer" data-interfacing-shell-location="shell.footer" data-interfacing-shell-contract="four-column-grid" {{ footerAttributes|raw }}>
  {% include '@Interfacing/shell/partial/location_bucket.html.twig' with {
    location: 'shell.footer.top',
    items: shellFooterTopItems,
    interfaceStyleProvider: interfaceStyleProvider
  } only %}
  <div class="interfacing-shell-grid interfacing-footer-grid" data-interfacing-footer-grid="true">
    <aside class="interfacing-shell-panel interfacing-footer-panel interfacing-footer-panel--primary" data-interfacing-shell-slot="footer-primary" data-interfacing-shell-location="shell.footer.left" title="Download mobile applications">
      <div class="interfacing-footer-store-badges interfacing-location-bucket {{ interfaceStyleProvider.location_class }}" aria-label="Mobile applications" data-interfacing-location="shell.footer.left.downloads" data-interfacing-style-provider="{{ interfaceStyleProvider.key }}">
        <div class="interfacing-location-item interfacing-location-item--action" data-interfacing-location-item="action">
          <button class="interfacing-footer-store-badge interfacing-footer-store-badge--apple interfacing-location-link" type="button" data-interfacing-store-badge="apple" aria-label="Download on the App Store">
            <img src="https://developer.apple.com/assets/elements/badges/download-on-the-app-store.svg" alt="Download on the App Store" loading="lazy">
          </button>
        </div>
        <div class="interfacing-location-item interfacing-location-item--action" data-interfacing-location-item="action">
          <button class="interfacing-footer-store-badge interfacing-footer-store-badge--google interfacing-location-link" type="button" data-interfacing-store-badge="google" aria-label="Get it on Google Play">
            <img src="https://play.google.com/intl/en_us/badges/static/images/badges/en_badge_web_generic.png" alt="Get it on Google Play" loading="lazy">
          </button>
        </div>
        <div class="interfacing-location-item interfacing-location-item--link" data-interfacing-location-item="link">
          <a class="interfacing-location-link" href="https://github.com/smartresponsor" target="_blank" rel="noopener noreferrer" aria-label="Smartresponsor on GitHub">
            <span class="interfacing-location-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <path d="M12 .7a11.3 11.3 0 0 0-3.6 22c.6.1.8-.3.8-.6v-2.2c-3.4.7-4.1-1.4-4.1-1.4-.6-1.4-1.4-1.8-1.4-1.8-1.1-.8.1-.8.1-.8 1.2.1 1.9 1.3 1.9 1.3 1.1 1.9 2.9 1.4 3.6 1.1.1-.8.4-1.4.8-1.7-2.7-.3-5.5-1.4-5.5-6a4.7 4.7 0 0 1 1.3-3.3 4.4 4.4 0 0 1 .1-3.3s1-.3 3.4 1.3a11.8 11.8 0 0 1 6.2 0c2.4-1.6 3.4-1.3 3.4-1.3a4.4 4.4 0 0 1 .1 3.3 4.7 4.7 0 0 1 1.3 3.3c0 4.6-2.8 5.7-5.5 6 .4.4.8 1.1.8 2.2V22c0 .3.2.7.8.6A11.3 11.3 0 0 0 12 .7Z"/>
              </svg>
            </span>
          </a>
        </div>
      </div>
    </aside>

    <aside class="interfacing-shell-panel interfacing-footer-panel interfacing-footer-panel--secondary" data-interfacing-shell-slot="footer-secondary" data-interfacing-shell-location="shell.footer.context" title="{{ shellSlotMap['shell.footer.context']|default('Footer context') }}">
      {% if shellFooterLeftItems is not empty %}
        <nav class="interfacing-footer-links" aria-label="System links" data-interfacing-footer-links="left-moved">
          {% for item in shellFooterLeftItems|slice(0, shellFooterLinkLimit) %}
            {% set itemLabel = item.label|default(item.title|default(item.key|default(item.href|default(item.url|default('Link'))))) %}
            {% set itemHref = item.href|default(item.url|default('#')) %}
            <a class="interfacing-footer-link" href="{{ itemHref }}">{{ itemLabel }}</a>
          {% endfor %}
        </nav>
      {% endif %}
      {% include '@Interfacing/shell/partial/location_bucket.html.twig' with {
        location: 'shell.footer.context',
        items: shellFooterContextItems,
        interfaceStyleProvider: interfaceStyleProvider
      } only %}
    </aside>

    <main class="interfacing-shell-body interfacing-footer-panel interfacing-footer-panel--main ant-row" data-interfacing-shell-slot="footer-main" data-interfacing-shell-location="shell.footer.main" title="{{ shellSlotMap['shell.footer.main']|default('Footer main') }}">
      {% if footerSupportItems is not empty %}
        <nav class="interfacing-footer-links ant-col ant-col-8 ant-space ant-space-vertical" aria-label="Footer support links" data-interfacing-footer-links="support">
          {% for item in footerSupportItems|slice(0, shellFooterLinkLimit) %}
            {% set itemLabel = item.label|default(item.title|default(item.key|default(item.href|default(item.url|default('Link'))))) %}
            {% set itemHref = item.href|default(item.url|default('#')) %}
            <a class="interfacing-footer-link" href="{{ itemHref }}">{{ itemLabel }}</a>
          {% endfor %}
        </nav>
      {% endif %}
      {% if footerFeaturedLocaleItems is not empty %}
        <nav class="interfacing-footer-links ant-col ant-col-8 ant-space ant-space-vertical" aria-label="Featured languages" data-interfacing-footer-links="main">
          {% for item in footerFeaturedLocaleItems|slice(0, shellFooterLinkLimit) %}
            {% set itemLabel = item.label|default(item.title|default(item.key|default(item.href|default(item.url|default('Link'))))) %}
            {% set itemHref = item.href|default(item.url|default('#')) %}
            <a class="interfacing-footer-link" href="{{ itemHref }}">{{ itemLabel }}</a>
          {% endfor %}
        </nav>
      {% endif %}
      {% if footerOtherLocaleOptions is not empty %}
        <form class="interfacing-footer-locale-selector ant-col ant-col-8 ant-form ant-form-vertical" action="{{ footerLocaleSelector.action }}" method="get" data-interfacing-locale-selector="footer">
          {% for key, value in footerLocaleSelector.query %}
            <input type="hidden" name="{{ key }}" value="{{ value }}">
          {% endfor %}
          <div class="interfacing-footer-locale-selector__label-row">
            <label class="interfacing-footer-locale-selector__label" for="interfacing-footer-locale">Other languages</label>
          </div>
          <div class="interfacing-footer-locale-selector__control-row">
            <select id="interfacing-footer-locale" class="interfacing-footer-locale-selector__select ant-select ant-select-single" name="locale" onchange="this.form.submit()">
              <option value="">Select language</option>
              {% for option in footerOtherLocaleOptions %}
                <option value="{{ option.code }}"{% if option.current %} selected{% endif %}>{{ option.nativeName }}</option>
              {% endfor %}
            </select>
          </div>
        </form>
      {% endif %}
      {% if shellFooterGroup is not empty %}
        <div class="interfacing-footer-group-grid" data-interfacing-footer-legacy-group="true">
          {% for g in shellFooterGroup %}
            <section class="interfacing-footer-group">
              <div class="interfacing-footer__title">{{ g.title }}</div>
              <ul class="interfacing-footer-list">
                {% for link in g.link|default([])|slice(0, shellFooterLinkLimit) %}
                  <li class="interfacing-list-item">
                    <a class="interfacing-footer-link" href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </section>
          {% endfor %}
        </div>
      {% endif %}
    </main>

    <aside class="interfacing-shell-panel interfacing-footer-panel interfacing-footer-panel--right" data-interfacing-shell-slot="footer-right" data-interfacing-shell-location="shell.footer.right" title="{{ shellSlotMap['shell.footer.right']|default('Footer right') }}">
      {% if shellFooterRightItems is not empty %}
        <nav class="interfacing-footer-links" aria-label="Footer right links" data-interfacing-footer-links="right">
          {% for item in shellFooterRightItems|slice(0, shellFooterLinkLimit) %}
            {% set itemLabel = item.label|default(item.title|default(item.key|default(item.href|default(item.url|default('Link'))))) %}
            {% set itemHref = item.href|default(item.url|default('#')) %}
            <a class="interfacing-footer-link" href="{{ itemHref }}">{{ itemLabel }}</a>
          {% endfor %}
        </nav>
      {% endif %}
    </aside>
  </div>
  <div class="interfacing-footer-coming-soon" role="status" aria-live="polite" aria-atomic="true" hidden data-interfacing-footer-coming-soon>
    <strong>Mobile apps are coming soon</strong>
    <span>We’re preparing the App Store and Google Play releases.</span>
  </div>
  <script>
    (() => {
      const footer = document.currentScript.closest('.interfacing-footer');
      if (!footer || footer.dataset.storeBadgesReady === 'true') {
        return;
      }

      footer.dataset.storeBadgesReady = 'true';
      const toast = footer.querySelector('[data-interfacing-footer-coming-soon]');
      let hideTimer;

      footer.addEventListener('click', (event) => {
        const badge = event.target.closest('[data-interfacing-store-badge]');
        if (!badge || !toast) {
          return;
        }

        clearTimeout(hideTimer);
        toast.hidden = false;
        requestAnimationFrame(() => toast.classList.add('is-visible'));
        hideTimer = window.setTimeout(() => {
          toast.classList.remove('is-visible');
          window.setTimeout(() => { toast.hidden = true; }, 180);
        }, 2200);
      });
    })();
  </script>
</footer>
