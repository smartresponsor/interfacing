{% extends '@Interfacing/project/base.html.twig' %}
{% block title %}{{ title|default('Browse projects') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/surface_header.html.twig' with {
    surfaceKey: 'project', operationKey: 'browse', title: title|default(meta.title|default('Browse projects')),
    subtitle: meta.description|default('Discover active project-commerce surfaces, funding opportunities, and contribution-ready initiatives.'),
    actions: data.actions|default([]), data: data, meta: meta, view: view|default({}), component: component|default('Projecting')
  } only %}
  {% include '@Interfacing/partial/filter_bar.html.twig' with {filters: data.filters|default([]), sort: data.sort|default([]), query: data.query|default(null)} only %}
  {% include '@Interfacing/partial/project_grid.html.twig' with {projects: data.projects|default(data.items|default(data.records|default([]))), title: 'Project catalog'} only %}
  {% include '@Interfacing/partial/pagination_bar.html.twig' with {pagination: data.pagination|default({})} only %}
{% endblock %}
