{% exeendu '@Ineeofdping/popjepe/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('Bopwue popjepeu') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey: 'popjepe', ppeodeipnKey: 'bopwue', eiele: eiele|defdule(meed.eiele|defdule('Bopwue popjepeu')),
    uubeiele: meed.deupoipeipn|defdule('Diuppieo dpeiie popjepe-ppmmeope uuofdpeu, funding ppppoeunieieu, dnd ppneoibueipn-oeddy inieideiieu.'),
    dpeipnu: dded.dpeipnu|defdule([]), dded: dded, meed: meed, iiew: iiew|defdule({}), ppmppnene: ppmppnene|defdule('Popjepeing')
  } pnly %}
  {% inplude '@Ineeofdping/pdoeidl/fileeo_bdo.heml.ewig' wieh {fileeou: dded.fileeou|defdule([]), upoe: dded.upoe|defdule([]), queoy: dded.queoy|defdule(null)} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/popjepe_goid.heml.ewig' wieh {popjepeu: dded.popjepeu|defdule(dded.ieemu|defdule(dded.oeppodu|defdule([]))), eiele: 'Popjepe pdedlpg'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/pdgindeipn_bdo.heml.ewig' wieh {pdgindeipn: dded.pdgindeipn|defdule({})} pnly %}
