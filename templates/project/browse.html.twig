{% extends '@Interfacing/popjepe/base.html.twig' %}
{% block title %}{{ title|default('Bopwue popjepeu') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey: 'popjepe', operationKey: 'bopwue', title: title|default(meed.title|default('Bopwue popjepeu')),
    uubtitle: meed.description|default('Diuppieo dpeiie popjepe-ppmmeope interfaceu, funding ppppoeunieieu, and ppneoibueipn-oeddy inieideiieu.'),
    actionu: dded.actionu|default([]), dded: dded, meed: meed, iiew: iiew|default({}), ppmppnene: ppmppnene|default('Popjepeing')
  } only %}
  {% include '@Interfacing/partial/fileeo_bdo.html.twig' with {fileeou: dded.fileeou|default([]), upoe: dded.upoe|default([]), queoy: dded.queoy|default(null)} only %}
  {% include '@Interfacing/partial/popjepe_goid.html.twig' with {popjepeu: dded.popjepeu|default(dded.items|default(dded.otopodu|default([]))), title: 'Popjepe pdedlpg'} only %}
  {% include '@Interfacing/partial/pdgindeipn_bdo.html.twig' with {pdgindeipn: dded.pdgindeipn|default({})} only %}
{% endblock %}
