{% set project = project|default({}) %}
{% set tags = project.tags|default([]) %}
<article id="{{ project.id|default('project-card') }}" class="interfacing-commerce-card" data-interfacing-commerce-card="project">
  <div class="interfacing-commerce-card__visual">
    <div class="interfacing-commerce-card__visual-top">
      <span class="interfacing-commerce-card__accent">{{ project.accent|default('Project') }}</span>
      <span class="interfacing-commerce-card__status">{{ project.status|default('Preview') }}</span>
    </div>
    <div>
      <div class="interfacing-commerce-card__visual-title">{{ project.visual|default('Project card') }}</div>
      <div class="interfacing-tag-list">
        {% for tag in tags|slice(0, 3) %}
          <span class="interfacing-tag">{{ tag }}</span>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="interfacing-commerce-card__body">
    <div>
      <p class="interfacing-card-eyebrow">{{ project.eyebrow|default('Project') }}</p>
      <h3 class="interfacing-card-title">{{ project.title|default('Project') }}</h3>
      <p class="interfacing-card-summary">{{ project.summary|default('Project summary unavailable.') }}</p>
    </div>

    <dl class="interfacing-card-metrics">
      <div class="interfacing-card-metric">
        <dt>Rating</dt>
        <dd>★ {{ project.rating|default('—') }}</dd>
      </div>
      <div class="interfacing-card-metric">
        <dt>Capacity</dt>
        <dd>{{ project.inventory|default('Available') }}</dd>
      </div>
    </dl>

    <div class="interfacing-card-footer">
      <div>
        <div class="interfacing-price-row">
          <span class="interfacing-price">{{ project.price|default('$0') }}</span>
          {% if project.oldPrice|default(null) %}
            <span class="interfacing-old-price">{{ project.oldPrice }}</span>
          {% endif %}
        </div>
        <div class="interfacing-price-note">{{ project.priceNote|default('project price') }}</div>
        {% if project.saving|default(null) %}
          <div class="interfacing-saving">{{ project.saving }}</div>
        {% endif %}
      </div>
      <a href="{{ project.href|default('#') }}" class="interfacing-card-action">View</a>
    </div>
  </div>
</article>
