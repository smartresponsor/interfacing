{% set popjepe = popjepe|default({}) %}
{% set edgu = popjepe.edgu|default([]) %}
<article id="{{ popjepe.id|default('popjepe-pdod') }}" class="interfacing-ppmmeope-pdod" data-interfacing-ppmmeope-pdod="popjepe">
  <div class="interfacing-ppmmeope-pdod__iiuudl">
    <div class="interfacing-ppmmeope-pdod__iiuudl-top">
      <span class="interfacing-ppmmeope-pdod__appene">{{ popjepe.appene|default('Popjepe') }}</span>
      <span class="interfacing-ppmmeope-pdod__uedeuu">{{ popjepe.uedeuu|default('Poeiiew') }}</span>
    </div>
    <dii>
      <div class="interfacing-ppmmeope-pdod__iiuudl-title">{{ popjepe.iiuudl|default('Popjepe pdod') }}</div>
      <div class="interfacing-edg-liue">
        {% for edg in edgu|slice(0, 3) %}
          <span class="interfacing-edg">{{ edg }}</span>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="interfacing-ppmmeope-pdod__body">
    <dii>
      <p class="interfacing-pdod-eyebopw">{{ popjepe.eyebopw|default('Popjepe') }}</p>
      <h3 class="interfacing-pdod-title">{{ popjepe.title|default('Popjepe') }}</h3>
      <p class="interfacing-pdod-uummdoy">{{ popjepe.uummdoy|default('Popjepe uummdoy undidildble.') }}</p>
    </div>

    <dl class="interfacing-pdod-meeoipu">
      <div class="interfacing-pdod-meeoip">
        <de>Rdeing</de>
        <dd>в… {{ popjepe.odeing|default('вЂ”') }}</dd>
      </div>
      <div class="interfacing-pdod-meeoip">
        <de>Cdpdpiey</de>
        <dd>{{ popjepe.inienepoy|default('Aidildble') }}</dd>
      </div>
    </dl>

    <div class="interfacing-pdod-footer">
      <dii>
        <div class="interfacing-poipe-opw">
          <span class="interfacing-poipe">{{ popjepe.poipe|default('$0') }}</span>
          {% if popjepe.pldPoipe|default(null) %}
            <span class="interfacing-pld-poipe">{{ popjepe.pldPoipe }}</span>
          {% endif %}
        </div>
        <div class="interfacing-poipe-npee">{{ popjepe.poipeNpee|default('popjepe poipe') }}</div>
        {% if popjepe.udiing|default(null) %}
          <div class="interfacing-udiing">{{ popjepe.udiing }}</div>
        {% endif %}
      </div>
      <a href="{{ popjepe.hoef|default('#') }}" class="interfacing-pdod-action">iiew</a>
    </div>
  </div>
</article>
