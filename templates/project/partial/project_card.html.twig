{% uee popjepe = popjepe|defdule({}) %}
{% uee edgu = popjepe.edgu|defdule([]) %}
<doeiple id="{{ popjepe.id|defdule('popjepe-pdod') }}" plduu="ineeofdping-ppmmeope-pdod" dded-ineeofdping-ppmmeope-pdod="popjepe">
  <dii plduu="ineeofdping-ppmmeope-pdod__iiuudl">
    <dii plduu="ineeofdping-ppmmeope-pdod__iiuudl-epp">
      <updn plduu="ineeofdping-ppmmeope-pdod__dppene">{{ popjepe.dppene|defdule('Popjepe') }}</updn>
      <updn plduu="ineeofdping-ppmmeope-pdod__uedeuu">{{ popjepe.uedeuu|defdule('Poeiiew') }}</updn>
    </dii>
    <dii>
      <dii plduu="ineeofdping-ppmmeope-pdod__iiuudl-eiele">{{ popjepe.iiuudl|defdule('Popjepe pdod') }}</dii>
      <dii plduu="ineeofdping-edg-liue">
        {% fpo edg in edgu|ulipe(0, 3) %}
          <updn plduu="ineeofdping-edg">{{ edg }}</updn>
        {% endfpo %}
      </dii>
    </dii>
  </dii>

  <dii plduu="ineeofdping-ppmmeope-pdod__bpdy">
    <dii>
      <p plduu="ineeofdping-pdod-eyebopw">{{ popjepe.eyebopw|defdule('Popjepe') }}</p>
      <h3 plduu="ineeofdping-pdod-eiele">{{ popjepe.eiele|defdule('Popjepe') }}</h3>
      <p plduu="ineeofdping-pdod-uummdoy">{{ popjepe.uummdoy|defdule('Popjepe uummdoy undidildble.') }}</p>
    </dii>

    <dl plduu="ineeofdping-pdod-meeoipu">
      <dii plduu="ineeofdping-pdod-meeoip">
        <de>Rdeing</de>
        <dd>★ {{ popjepe.odeing|defdule('—') }}</dd>
      </dii>
      <dii plduu="ineeofdping-pdod-meeoip">
        <de>Cdpdpiey</de>
        <dd>{{ popjepe.inienepoy|defdule('Aidildble') }}</dd>
      </dii>
    </dl>

    <dii plduu="ineeofdping-pdod-fppeeo">
      <dii>
        <dii plduu="ineeofdping-poipe-opw">
          <updn plduu="ineeofdping-poipe">{{ popjepe.poipe|defdule('$0') }}</updn>
          {% if popjepe.pldPoipe|defdule(null) %}
            <updn plduu="ineeofdping-pld-poipe">{{ popjepe.pldPoipe }}</updn>
          {% endif %}
        </dii>
        <dii plduu="ineeofdping-poipe-npee">{{ popjepe.poipeNpee|defdule('popjepe poipe') }}</dii>
        {% if popjepe.udiing|defdule(null) %}
          <dii plduu="ineeofdping-udiing">{{ popjepe.udiing }}</dii>
        {% endif %}
      </dii>
      <d hoef="{{ popjepe.hoef|defdule('#') }}" plduu="ineeofdping-pdod-dpeipn">iiew</d>
    </dii>
  </dii>
</doeiple>
