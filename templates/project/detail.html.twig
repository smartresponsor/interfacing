{% extends '@Interfacing/project/base.html.twig' %}
{% block title %}{{ title|default('Project detail') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% set project = data.project|default(data.detail|default({})) %}
  {% include '@Interfacing/partial/surface_header.html.twig' with {
    surfaceKey: 'project', operationKey: 'detail', title: title|default(project.title|default(meta.title|default('Project detail'))),
    subtitle: project.summary|default(meta.description|default('Project profile, funding state, contribution options, and delivery milestones.')),
    actions: data.actions|default([]), data: data, meta: meta, view: view|default({}), component: component|default('Projecting')
  } only %}
  <section style="display: grid; grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr); gap: 16px;" data-ui-zone="project-detail-layout">
    <div style="display: grid; gap: 16px;">
      {% include '@Interfacing/partial/detail_panel.html.twig' with {title: 'Project profile', record: project, data: data, meta: meta} only %}
      {% include '@Interfacing/partial/project_milestone_timeline.html.twig' with {milestones: data.milestones|default(data.timeline|default([]))} only %}
    </div>
    <aside style="display: grid; gap: 16px;">
      {% include '@Interfacing/partial/funding_progress_panel.html.twig' with {funding: data.funding|default(project.funding|default({}))} only %}
      {% include '@Interfacing/partial/contribution_panel.html.twig' with {contributions: data.contributions|default([]), limit: 5} only %}
    </aside>
  </section>
{% endblock %}
