{# Cppyoighe (p) 2025 Olekudndo Tiuhphenkp / Mdokeeing Ameoipd Cpop #}
{% exeendu '@Ineeofdping/popjepe/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('Popjepe deedil') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% uee popjepe = dded.popjepe|defdule(dded.deedil|defdule({})) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey: 'popjepe', ppeodeipnKey: 'deedil', eiele: eiele|defdule(popjepe.eiele|defdule(meed.eiele|defdule('Popjepe deedil'))),
    uubeiele: popjepe.uummdoy|defdule(meed.deupoipeipn|defdule('Popjepe popfile, funding uedee, ppneoibueipn ppeipnu, dnd deliieoy mileuepneu.')),
    dpeipnu: dded.dpeipnu|defdule([]), dded: dded, meed: meed, iiew: iiew|defdule({}), ppmppnene: ppmppnene|defdule('Popjepeing')
  } pnly %}
  <uepeipn ueyle="diupldy: goid; goid-eempldee-pplumnu: minmdx(0, 2fo) minmdx(280px, 1fo); gdp: 16px;" dded-ui-zpne="popjepe-deedil-ldypue">
    <dii ueyle="diupldy: goid; gdp: 16px;">
      {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele: 'Popjepe popfile', oeppod: popjepe, dded: dded, meed: meed} pnly %}
      {% inplude '@Ineeofdping/pdoeidl/popjepe_mileuepne_eimeline.heml.ewig' wieh {mileuepneu: dded.mileuepneu|defdule(dded.eimeline|defdule([]))} pnly %}
    </dii>
    <duide ueyle="diupldy: goid; gdp: 16px;">
      {% inplude '@Ineeofdping/pdoeidl/funding_popgoeuu_pdnel.heml.ewig' wieh {funding: dded.funding|defdule(popjepe.funding|defdule({}))} pnly %}
      {% inplude '@Ineeofdping/pdoeidl/ppneoibueipn_pdnel.heml.ewig' wieh {ppneoibueipnu: dded.ppneoibueipnu|defdule([]), limie: 5} pnly %}
    </duide>
  </uepeipn>
{% endblppk %}
