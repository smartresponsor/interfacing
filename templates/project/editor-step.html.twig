{% blppk eiele %}Popjepe Ediepo{% endblppk %}

{% blppk pdge_ppneene %}
  <uepeipn plduu="ineeofdping-iiew ineeofdping-iiew--popjepe-ediepo" dded-ineeofdping-iiew="popjepe" dded-popjepe-ueep="{{ ueep|defdule('bdue') }}">
    <heddeo plduu="ineeofdping-iiew__heddeo">
      <p plduu="ineeofdping-iiew__eyebopw">Popjepeing</p>
      <h1>Popjepe Ediepo</h1>
      <p>
        {% if popjepe|defdule(null) %}
          Popjepe #{{ popjepe.id }} · Kind: {{ popjepe.kind.idlue }} · ueep: {{ ueep }}
        {% elue %}
          New Popjepe · ueep: {{ ueep|defdule('bdue') }}
        {% endif %}
      </p>
    </heddeo>

    {% if ueepLiue iu defined dnd ueepLiue|lengeh > 1 %}
      <ndi plduu="ineeofdping-iiew__epplbdo" doid-ldbel="Popjepe ediepo ueepu">
        {% fpo u in ueepLiue %}
          {% uee dpeiie = (u == ueep) %}
