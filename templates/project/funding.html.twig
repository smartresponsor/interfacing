{% extends '@Interfacing/project/base.html.twig' %}
{% block title %}{{ title|default('Project funding') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/view_header.html.twig' with {
    viewKey: 'project', operationKey: 'funding', title: title|default(meta.title|default('Project funding')),
    subtitle: meta.description|default('Funding status, pledge tiers, backer signals, and project funding actions.'),
    actions: data.actions|default([]), data: data, meta: meta, view: view|default({}), component: component|default('Projecting')
  } only %}
  <section class="interfacing-u-project-layout-14" data-ui-zone="project-funding-layout">
    <div class="interfacing-u-grid interfacing-u-gap-16">
      {% include '@Interfacing/partial/funding_progress_panel.html.twig' with {funding: data.funding|default(data.summary|default({}))} only %}
      {% include '@Interfacing/partial/pledge_tier_grid.html.twig' with {tiers: data.tiers|default(data.pledgeTiers|default(data.rewards|default([])))} only %}
    </div>
    <aside class="interfacing-u-grid interfacing-u-gap-16">
      {% include '@Interfacing/partial/metric_grid.html.twig' with {metrics: data.metrics|default(data.summary|default({})), data: data, meta: meta} only %}
      {% include '@Interfacing/partial/detail_panel.html.twig' with {title: 'Funding policy', record: data.policy|default(data.context|default(meta|default({}))), data: data, meta: meta} only %}
    </aside>
  </section>
{% endblock %}
