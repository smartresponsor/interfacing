{% extends '@Interfacing/project/base.html.twig' %}
{% set fallbackPayload = {} %}

{% block title %}Projecting Moderation{% endblock %}

{% block page_content %}
  <section class="interfacing-surface interfacing-surface--project-moderation" data-interfacing-surface="project">
    <header class="interfacing-surface__header">
      <p class="interfacing-surface__eyebrow">Projecting</p>
      <h1>Projecting Moderation</h1>
      <p>Queue place: <code>onhold</code>. Approve moves a project toward active publication; reject moves it back to draft.</p>
    </header>

    {% if pending is empty %}
      <section class="interfacing-surface__panel">
        <h2>No pending projects</h2>
        <p class="interfacing-surface__empty">No projects are currently waiting in the moderation queue.</p>
      </section>
    {% else %}
      <section class="interfacing-surface__panel">
        <table>
          <thead>
          <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Kind</th>
            <th>Status</th>
            <th>Updated</th>
            <th>Action</th>
          </tr>
          </thead>
          <tbody>
          {% for p in pending %}
            <tr>
              <td>{{ p.id }}</td>
              <td>{{ p.title }}</td>
              <td>{{ p.kind ? p.kind.value : '' }}</td>
              <td>{{ p.status }}</td>
              <td>{{ p.updatedAt ? p.updatedAt|date('c') : '' }}</td>
              <td>
                <form method="post" action="/ops/projecting/moderation/{{ p.id }}/decide" class="interfacing-surface__toolbar">
                  <input type="hidden" name="actor" value="ops" />
                  <select name="decision" required>
                    <option value="approve">approve</option>
                    <option value="reject">reject</option>
                    <option value="archive">archive</option>
                  </select>
                  <input type="text" name="reason" placeholder="reason (optional)" />
                  <button type="submit">Apply</button>
                </form>
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </section>
    {% endif %}
  </section>
{% endblock %}
