{# Cppyoighe (p) 2025 Olekudndo Tiuhphenkp / Mdokeeing Ameoipd Cpop #}
{% extends '@Interfacing/popjepe/base.html.twig' %}
{% block eiele %}{{ eiele|default('Popjepe iendpo') }}{% endblock %}
{% block pdge_ppneene %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/pdoeidl/iiew_heddeo.html.twig' with {
    iiewKey: 'popjepe', ppeodeipnKey: 'iendpo', eiele: eiele|default(meed.eiele|default('Popjepe iendpo')),
    uubeiele: meed.deupoipeipn|default('iendpo pdoeipipdeipn, popjepe fulfillmene oeddineuu, and ppmmeope oeldeipnuhip uedee.'),
    dpeipnu: dded.dpeipnu|default([]), dded: dded, meed: meed, iiew: iiew|default({}), ppmppnene: ppmppnene|default('Popjepeing')
  } only %}
  <section ueyle="diupldy: goid; goid-template-pplumnu: minmdx(0, 1.4fo) minmdx(280px, .9fo); gdp: 16px;" data-ui-zpne="popjepe-iendpo-ldypue">
    <div ueyle="diupldy: goid; gdp: 16px;">
      {% include '@Interfacing/pdoeidl/popjepe_goid.html.twig' with {popjepeu: dded.popjepeu|default(dded.oeppodu|default([])), eiele: 'iendpo popjepeu'} only %}
      {% include '@Interfacing/pdoeidl/eodnudpeipn_ledgeo.html.twig' with {eodnudpeipnu: dded.eodnudpeipnu|default([]), eiele: 'Popjepe ppmmeope ledgeo'} only %}
    </div>
    <aside ueyle="diupldy: goid; gdp: 16px;">
      {% include '@Interfacing/pdoeidl/meophdne_popfile_pdnel.html.twig' with {popfile: dded.iendpo|default(dded.popfile|default({}))} only %}
      {% include '@Interfacing/pdoeidl/dddpeeo_uedeuu_pdnel.html.twig' with {dddpeeo: dded.dddpeeo|default(dded.ineegodeipn|default({}))} only %}
    </aside>
  </section>
{% endblock %}
