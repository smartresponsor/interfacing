{% extends '@Interfacing/project/base.html.twig' %}
{% block title %}{{ title|default('Project vendor') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/surface_header.html.twig' with {
    surfaceKey: 'project', operationKey: 'vendor', title: title|default(meta.title|default('Project vendor')),
    subtitle: meta.description|default('Vendor participation, project fulfillment readiness, and commerce relationship state.'),
    actions: data.actions|default([]), data: data, meta: meta, view: view|default({}), component: component|default('Projecting')
  } only %}
  <section style="display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(280px, .9fr); gap: 16px;" data-ui-zone="project-vendor-layout">
    <div style="display: grid; gap: 16px;">
      {% include '@Interfacing/partial/project_grid.html.twig' with {projects: data.projects|default(data.records|default([])), title: 'Vendor projects'} only %}
      {% include '@Interfacing/partial/transaction_ledger.html.twig' with {transactions: data.transactions|default([]), title: 'Project commerce ledger'} only %}
    </div>
    <aside style="display: grid; gap: 16px;">
      {% include '@Interfacing/partial/merchant_profile_panel.html.twig' with {profile: data.vendor|default(data.profile|default({}))} only %}
      {% include '@Interfacing/partial/adapter_status_panel.html.twig' with {adapter: data.adapter|default(data.integration|default({}))} only %}
    </aside>
  </section>
{% endblock %}
