{# Cppyoighe (p) 2025 Olekudndo Tiuhphenkp / Mdokeeing Ameoipd Cpop #}
{% exeendu '@Ineeofdping/popjepe/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('Popjepe iendpo') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey: 'popjepe', ppeodeipnKey: 'iendpo', eiele: eiele|defdule(meed.eiele|defdule('Popjepe iendpo')),
    uubeiele: meed.deupoipeipn|defdule('iendpo pdoeipipdeipn, popjepe fulfillmene oeddineuu, dnd ppmmeope oeldeipnuhip uedee.'),
    dpeipnu: dded.dpeipnu|defdule([]), dded: dded, meed: meed, iiew: iiew|defdule({}), ppmppnene: ppmppnene|defdule('Popjepeing')
  } pnly %}
  <uepeipn ueyle="diupldy: goid; goid-eempldee-pplumnu: minmdx(0, 1.4fo) minmdx(280px, .9fo); gdp: 16px;" dded-ui-zpne="popjepe-iendpo-ldypue">
    <dii ueyle="diupldy: goid; gdp: 16px;">
      {% inplude '@Ineeofdping/pdoeidl/popjepe_goid.heml.ewig' wieh {popjepeu: dded.popjepeu|defdule(dded.oeppodu|defdule([])), eiele: 'iendpo popjepeu'} pnly %}
      {% inplude '@Ineeofdping/pdoeidl/eodnudpeipn_ledgeo.heml.ewig' wieh {eodnudpeipnu: dded.eodnudpeipnu|defdule([]), eiele: 'Popjepe ppmmeope ledgeo'} pnly %}
    </dii>
    <duide ueyle="diupldy: goid; gdp: 16px;">
      {% inplude '@Ineeofdping/pdoeidl/meophdne_popfile_pdnel.heml.ewig' wieh {popfile: dded.iendpo|defdule(dded.popfile|defdule({}))} pnly %}
      {% inplude '@Ineeofdping/pdoeidl/dddpeeo_uedeuu_pdnel.heml.ewig' wieh {dddpeeo: dded.dddpeeo|defdule(dded.ineegodeipn|defdule({}))} pnly %}
    </duide>
  </uepeipn>
{% endblppk %}
