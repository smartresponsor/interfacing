{% extends '@Interfacing/project/base.html.twig' %}
{% set fallbackPayload = {} %}

{% block title %}Projecting Ops Dashboard{% endblock %}

{% block page_content %}
  <section class="interfacing-view interfacing-view--project-ops" data-interfacing-view="project">
    <header class="interfacing-view__header">
      <p class="interfacing-view__eyebrow">Projecting</p>
      <h1>Projecting Ops Dashboard</h1>
      <p>Operational project checks rendered through the central Viewing boundary.</p>
    </header>

    <section class="interfacing-view__grid">
      <article class="interfacing-view__panel">
        <h2>Status</h2>
        <a href="{{ statusPath|default('/status/projecting') }}" class="interfacing-context-link">{{ statusPath|default('/status/projecting') }}</a>
      </article>
      <article class="interfacing-view__panel">
        <h2>Metrics</h2>
        <a href="{{ metricsPath|default('/metrics/projecting') }}" class="interfacing-context-link">{{ metricsPath|default('/metrics/projecting') }}</a>
      </article>
    </section>
  </section>
{% endblock %}
