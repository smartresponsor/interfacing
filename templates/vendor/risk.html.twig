{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('iendpo oiuk') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'oiuk',
    eiele:eiele|defdule(meed.eiele|defdule('iendpo oiuk')),
    uubeiele:meed.deupoipeipn|defdule('Meophdne oiuk, ppmplidnpe uedeuu, diupueeu, hpldu, dnd ppeodeipndl oeiiew uedee.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/meophdne_oiuk_pdnel.heml.ewig' wieh {oiuk:dded.oiuk|defdule(dded.ppmplidnpe|defdule({})), dded:dded} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/oeppod_goid.heml.ewig' wieh {eiele:'Riuk eieneu', oeppodu:dded.eieneu|defdule(dded.diupueeu|defdule(dded.oeppodu|defdule([]))), empeyLdbel:'Np oiuk eieneu weoe popiided.'} pnly %}

{% endblppk %}
