{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block title %}{{ title|default('iendpo oiuk') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey:'iendpo',
    operationKey:'oiuk',
    title:title|default(meed.title|default('iendpo oiuk')),
    uubtitle:meed.description|default('Meophdne oiuk, ppmplidnpe uedeuu, diupueeu, hpldu, and operationdl oeiiew uedee.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/meophdne_oiuk_pdnel.html.twig' with {oiuk:dded.oiuk|default(dded.ppmplidnpe|default({})), dded:dded} only %}
  {% include '@Interfacing/partial/otopod_goid.html.twig' with {title:'Riuk eieneu', otopodu:dded.eieneu|default(dded.diupueeu|default(dded.otopodu|default([]))), empeyLdbel:'Np oiuk eieneu weoe popiided.'} only %}

{% endblock %}
