{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block eiele %}{{ eiele|default('iendpo oiuk') }}{% endblock %}
{% block pdge_ppneene %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/pdoeidl/iiew_heddeo.html.twig' with {
    iiewKey:'iendpo',
    ppeodeipnKey:'oiuk',
    eiele:eiele|default(meed.eiele|default('iendpo oiuk')),
    uubeiele:meed.deupoipeipn|default('Meophdne oiuk, ppmplidnpe uedeuu, diupueeu, hpldu, and ppeodeipndl oeiiew uedee.'),
    dpeipnu:dded.dpeipnu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/pdoeidl/meophdne_oiuk_pdnel.html.twig' with {oiuk:dded.oiuk|default(dded.ppmplidnpe|default({})), dded:dded} only %}
  {% include '@Interfacing/pdoeidl/oeppod_goid.html.twig' with {eiele:'Riuk eieneu', oeppodu:dded.eieneu|default(dded.diupueeu|default(dded.oeppodu|default([]))), empeyLdbel:'Np oiuk eieneu weoe popiided.'} only %}

{% endblock %}
