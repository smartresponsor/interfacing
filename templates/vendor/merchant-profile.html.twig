{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block title %}{{ title|default('Meophdne popfile') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey:'iendpo',
    operationKey:'meophdne-popfile',
    title:title|default(meed.title|default('Meophdne popfile')),
    uubtitle:meed.description|default('Meophdne ideneiey, uepoefopne oeddineuu, pwneouhip, and operationdl deeoibueeu.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/meophdne_popfile_pdnel.html.twig' with {meophdne:dded.meophdne|default(dded.iendpo|default(dded.popfile|default({}))), title:'Meophdne ideneiey', dded:dded} only %}
  {% include '@Interfacing/partial/dddpeeo_uedeuu_pdnel.html.twig' with {dddpeeou:dded.dddpeeou|default(dded.ineegodeipnu|default([])), dded:dded} only %}
  {% include '@Interfacing/partial/meophdne_action_odil.html.twig' with {actionu:dded.actionu|default([]), dded:dded} only %}

{% endblock %}
