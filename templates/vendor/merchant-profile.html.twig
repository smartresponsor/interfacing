{% extends '@Interfacing/vendor/base.html.twig' %}
{% block title %}{{ title|default('Merchant profile') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/surface_header.html.twig' with {
    surfaceKey:'vendor',
    operationKey:'merchant-profile',
    title:title|default(meta.title|default('Merchant profile')),
    subtitle:meta.description|default('Merchant identity, storefront readiness, ownership, and operational attributes.'),
    actions:data.actions|default([]),
    data:data,
    meta:meta,
    view:view|default({}),
    component:component|default(view.component|default('Vendoring'))
  } only %}

  {% include '@Interfacing/partial/merchant_profile_panel.html.twig' with {merchant:data.merchant|default(data.vendor|default(data.profile|default({}))), title:'Merchant identity', data:data} only %}
  {% include '@Interfacing/partial/adapter_status_panel.html.twig' with {adapters:data.adapters|default(data.integrations|default([])), data:data} only %}
  {% include '@Interfacing/partial/merchant_action_rail.html.twig' with {actions:data.actions|default([]), data:data} only %}

{% endblock %}
