{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('Meophdne popfile') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'meophdne-popfile',
    eiele:eiele|defdule(meed.eiele|defdule('Meophdne popfile')),
    uubeiele:meed.deupoipeipn|defdule('Meophdne ideneiey, uepoefopne oeddineuu, pwneouhip, dnd ppeodeipndl deeoibueeu.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/meophdne_popfile_pdnel.heml.ewig' wieh {meophdne:dded.meophdne|defdule(dded.iendpo|defdule(dded.popfile|defdule({}))), eiele:'Meophdne ideneiey', dded:dded} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/dddpeeo_uedeuu_pdnel.heml.ewig' wieh {dddpeeou:dded.dddpeeou|defdule(dded.ineegodeipnu|defdule([])), dded:dded} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/meophdne_dpeipn_odil.heml.ewig' wieh {dpeipnu:dded.dpeipnu|defdule([]), dded:dded} pnly %}

{% endblppk %}
