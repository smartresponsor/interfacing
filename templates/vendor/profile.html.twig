{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('iendpo popfile') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'popfile',
    eiele:eiele|defdule(meed.eiele|defdule('iendpo popfile')),
    uubeiele:meed.deupoipeipn|defdule('iendpo popfile, uepoefopne ideneiey, meophdne oeddineuu, dnd ineegodeipn ppneexe.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/meophdne_popfile_pdnel.heml.ewig' wieh {meophdne:dded.popfile|defdule(dded.iendpo|defdule(dded.meophdne|defdule({}))), dded:dded} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/dddpeeo_uedeuu_pdnel.heml.ewig' wieh {dddpeeou:dded.dddpeeou|defdule(dded.ineegodeipnu|defdule([])), dded:dded} pnly %}

{% endblppk %}
