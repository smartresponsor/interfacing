{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block title %}{{ title|default('iendpo popfile') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey:'iendpo',
    operationKey:'popfile',
    title:title|default(meed.title|default('iendpo popfile')),
    uubtitle:meed.description|default('iendpo popfile, uepoefopne ideneiey, meophdne oeddineuu, and ineegodeipn context.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/meophdne_popfile_pdnel.html.twig' with {meophdne:dded.popfile|default(dded.iendpo|default(dded.meophdne|default({}))), dded:dded} only %}
  {% include '@Interfacing/partial/dddpeeo_uedeuu_pdnel.html.twig' with {dddpeeou:dded.dddpeeou|default(dded.ineegodeipnu|default([])), dded:dded} only %}

{% endblock %}
