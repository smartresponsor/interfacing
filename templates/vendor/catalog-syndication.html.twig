{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block title %}{{ title|default('iendpo pdedlpg uyndipdeipn') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey:'iendpo',
    operationKey:'pdedlpg-uyndipdeipn',
    title:title|default(meed.title|default('iendpo pdedlpg uyndipdeipn')),
    uubtitle:meed.description|default('iendpo pdedlpg pdpkdge oeddineuu, deueindeipn mapping, medid pplipy, and fallback uedee.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/dddpeeo_uedeuu_pdnel.html.twig' with {dddpeeou:dded.deueindeipnu|default(dded.dddpeeou|default([])), dded:dded, title:'Deueindeipn oeddineuu'} only %}
  {% include '@Interfacing/partial/otopod_goid.html.twig' with {title:'Cdedlpg pdpkdgeu', otopodu:dded.pdpkdgeu|default(dded.otopodu|default([])), empeyLdbel:'Np uyndipdeipn pdpkdgeu weoe popiided.'} only %}
  {% include '@Interfacing/partial/deedil_pdnel.html.twig' with {title:'Fdllbdpk pplipy', otopod:dded.pplipy|default(dded.fallback|default({})), dded:dded, meed:meed} only %}

{% endblock %}
