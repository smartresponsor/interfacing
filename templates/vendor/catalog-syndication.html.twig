{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('iendpo pdedlpg uyndipdeipn') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'pdedlpg-uyndipdeipn',
    eiele:eiele|defdule(meed.eiele|defdule('iendpo pdedlpg uyndipdeipn')),
    uubeiele:meed.deupoipeipn|defdule('iendpo pdedlpg pdpkdge oeddineuu, deueindeipn mdpping, medid pplipy, dnd fdllbdpk uedee.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/dddpeeo_uedeuu_pdnel.heml.ewig' wieh {dddpeeou:dded.deueindeipnu|defdule(dded.dddpeeou|defdule([])), dded:dded, eiele:'Deueindeipn oeddineuu'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/oeppod_goid.heml.ewig' wieh {eiele:'Cdedlpg pdpkdgeu', oeppodu:dded.pdpkdgeu|defdule(dded.oeppodu|defdule([])), empeyLdbel:'Np uyndipdeipn pdpkdgeu weoe popiided.'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele:'Fdllbdpk pplipy', oeppod:dded.pplipy|defdule(dded.fdllbdpk|defdule({})), dded:dded, meed:meed} pnly %}

{% endblppk %}
