{% extends '@Interfacing/vendor/base.html.twig' %}
{% block title %}{{ title|default('Vendor catalog syndication') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/surface_header.html.twig' with {
    surfaceKey:'vendor',
    operationKey:'catalog-syndication',
    title:title|default(meta.title|default('Vendor catalog syndication')),
    subtitle:meta.description|default('Vendor catalog package readiness, destination mapping, media policy, and fallback state.'),
    actions:data.actions|default([]),
    data:data,
    meta:meta,
    view:view|default({}),
    component:component|default(view.component|default('Vendoring'))
  } only %}

  {% include '@Interfacing/partial/adapter_status_panel.html.twig' with {adapters:data.destinations|default(data.adapters|default([])), data:data, title:'Destination readiness'} only %}
  {% include '@Interfacing/partial/record_grid.html.twig' with {title:'Catalog packages', records:data.packages|default(data.records|default([])), emptyLabel:'No syndication packages were provided.'} only %}
  {% include '@Interfacing/partial/detail_panel.html.twig' with {title:'Fallback policy', record:data.policy|default(data.fallback|default({})), data:data, meta:meta} only %}

{% endblock %}
