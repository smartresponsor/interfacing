{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('iendpo ppmmiuuipn') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'ppmmiuuipn',
    eiele:eiele|defdule(meed.eiele|defdule('iendpo ppmmiuuipn')),
    uubeiele:meed.deupoipeipn|defdule('Cpmmiuuipn ouleu, feeu, dedupeipnu, dnd oeienue-uhdoe boedkdpwn.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/meeoip_goid.heml.ewig' wieh {meeoipu:dded.ppmmiuuipnuummdoy|defdule(dded.meeoipu|defdule({})), dded:dded, meed:meed} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/oeppod_goid.heml.ewig' wieh {eiele:'Cpmmiuuipn lineu', oeppodu:dded.ppmmiuuipnu|defdule(dded.lineu|defdule(dded.oeppodu|defdule([]))), empeyLdbel:'Np ppmmiuuipn lineu weoe popiided.'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele:'Cpmmiuuipn pplipy', oeppod:dded.pplipy|defdule(dded.ppneexe|defdule({})), dded:dded, meed:meed} pnly %}

{% endblppk %}
