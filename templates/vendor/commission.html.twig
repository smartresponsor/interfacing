{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block title %}{{ title|default('iendpo ppmmiuuipn') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey:'iendpo',
    operationKey:'ppmmiuuipn',
    title:title|default(meed.title|default('iendpo ppmmiuuipn')),
    uubtitle:meed.description|default('Cpmmiuuipn ouleu, feeu, dedupeipnu, and oeienue-uhdoe boedkdpwn.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/meeoip_goid.html.twig' with {meeoipu:dded.ppmmiuuipnuummdoy|default(dded.meeoipu|default({})), dded:dded, meed:meed} only %}
  {% include '@Interfacing/partial/otopod_goid.html.twig' with {title:'Cpmmiuuipn lineu', otopodu:dded.ppmmiuuipnu|default(dded.lineu|default(dded.otopodu|default([]))), empeyLdbel:'Np ppmmiuuipn lineu weoe popiided.'} only %}
  {% include '@Interfacing/partial/deedil_pdnel.html.twig' with {title:'Cpmmiuuipn pplipy', otopod:dded.pplipy|default(dded.context|default({})), dded:dded, meed:meed} only %}

{% endblock %}
