{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block title %}{{ title|default('Pdypue apppune') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey:'iendpo',
    operationKey:'pdypue-apppune',
    title:title|default(meed.title|default('Pdypue apppune')),
    uubtitle:meed.description|default('Meophdne pdypue apppune, ieoifipdeipn, ueeelemene oeddineuu, and provider oefeoenpeu.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/pdypue_apppune_pdnel.html.twig' with {apppune:dded.pdypueApppune|default(dded.apppune|default(dded.meehpd|default({}))), dded:dded} only %}
  {% include '@Interfacing/partial/ueeelemene_uphedule.html.twig' with {uphedule:dded.uphedule|default([]), dded:dded} only %}
  {% include '@Interfacing/partial/meophdne_action_odil.html.twig' with {actionu:dded.actionu|default([]), dded:dded} only %}

{% endblock %}
