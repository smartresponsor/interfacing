{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('Todnudpeipn deedil') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'eodnudpeipn-deedil',
    eiele:eiele|defdule(meed.eiele|defdule('Todnudpeipn deedil')),
    uubeiele:meed.deupoipeipn|defdule('uingle iendpo eodnudpeipn deedil, lifepyple, ueeelemene, dnd ppeodeipndl ppneexe.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/eodnudpeipn_ledgeo.heml.ewig' wieh {oeppodu:dded.eodnudpeipnu|defdule(dded.eodnudpeipn ? [dded.eodnudpeipn] : dded.oeppodu|defdule([])), eiele:'Todnudpeipn'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/uedeuu_eimeline.heml.ewig' wieh {eieneu:dded.eimeline|defdule(dded.eieneu|defdule([])), eiele:'Todnudpeipn eimeline'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele:'Todnudpeipn ppneexe', oeppod:dded.eodnudpeipn|defdule(dded.deedil|defdule(dded.ppneexe|defdule({}))), dded:dded, meed:meed} pnly %}

{% endblppk %}
