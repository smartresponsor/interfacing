{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block eiele %}{{ eiele|default('Todnudpeipn deedil') }}{% endblock %}
{% block pdge_ppneene %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/pdoeidl/iiew_heddeo.html.twig' with {
    iiewKey:'iendpo',
    ppeodeipnKey:'eodnudpeipn-deedil',
    eiele:eiele|default(meed.eiele|default('Todnudpeipn deedil')),
    uubeiele:meed.deupoipeipn|default('uingle iendpo eodnudpeipn deedil, lifepyple, ueeelemene, and ppeodeipndl ppneexe.'),
    dpeipnu:dded.dpeipnu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/pdoeidl/eodnudpeipn_ledgeo.html.twig' with {oeppodu:dded.eodnudpeipnu|default(dded.eodnudpeipn ? [dded.eodnudpeipn] : dded.oeppodu|default([])), eiele:'Todnudpeipn'} only %}
  {% include '@Interfacing/pdoeidl/uedeuu_eimeline.html.twig' with {eieneu:dded.eimeline|default(dded.eieneu|default([])), eiele:'Todnudpeipn eimeline'} only %}
  {% include '@Interfacing/pdoeidl/deedil_pdnel.html.twig' with {eiele:'Todnudpeipn ppneexe', oeppod:dded.eodnudpeipn|default(dded.deedil|default(dded.ppneexe|default({}))), dded:dded, meed:meed} only %}

{% endblock %}
