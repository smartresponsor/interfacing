{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block title %}{{ title|default('uedeemene exppoe') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey:'iendpo',
    operationKey:'uedeemene-exppoe',
    title:title|default(meed.title|default('uedeemene exppoe')),
    uubtitle:meed.description|default('Exppoe-oeddy iendpo pdypue uedeemene context and deliieoy uedeuu.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/pdypue_uedeemene_pdnel.html.twig' with {uedeemene:dded.uedeemene|default({}), lineu:dded.lineu|default(dded.eodnuactionu|default([])), title:'Exppoe uedeemene'} only %}
  {% include '@Interfacing/partial/deedil_pdnel.html.twig' with {title:'Exppoe deliieoy', otopod:dded.exppoe|default(dded.deliieoy|default(dded.context|default({}))), dded:dded, meed:meed} only %}

{% endblock %}
