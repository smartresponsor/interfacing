{% extends '@Interfacing/vendor/base.html.twig' %}
{% block title %}{{ title|default('Statement export') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/view_header.html.twig' with {
    viewKey:'vendor',
    operationKey:'statement-export',
    title:title|default(meta.title|default('Statement export')),
    subtitle:meta.description|default('Export-ready vendor payout statement context and delivery status.'),
    actions:data.actions|default([]),
    data:data,
    meta:meta,
    view:view|default({}),
    component:component|default(view.component|default('Vendoring'))
  } only %}

  {% include '@Interfacing/partial/payout_statement_panel.html.twig' with {statement:data.statement|default({}), lines:data.lines|default(data.transactions|default([])), title:'Export statement'} only %}
  {% include '@Interfacing/partial/detail_panel.html.twig' with {title:'Export delivery', record:data.export|default(data.delivery|default(data.context|default({}))), data:data, meta:meta} only %}

{% endblock %}
