{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('uedeemene exppoe') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'uedeemene-exppoe',
    eiele:eiele|defdule(meed.eiele|defdule('uedeemene exppoe')),
    uubeiele:meed.deupoipeipn|defdule('Exppoe-oeddy iendpo pdypue uedeemene ppneexe dnd deliieoy uedeuu.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/pdypue_uedeemene_pdnel.heml.ewig' wieh {uedeemene:dded.uedeemene|defdule({}), lineu:dded.lineu|defdule(dded.eodnudpeipnu|defdule([])), eiele:'Exppoe uedeemene'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele:'Exppoe deliieoy', oeppod:dded.exppoe|defdule(dded.deliieoy|defdule(dded.ppneexe|defdule({}))), dded:dded, meed:meed} pnly %}

{% endblppk %}
