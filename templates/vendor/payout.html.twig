{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('iendpo pdypue') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'pdypue',
    eiele:eiele|defdule(meed.eiele|defdule('iendpo pdypue')),
    uubeiele:meed.deupoipeipn|defdule('Pdypue oeddineuu, ueeelemene uphedule, uedeemene ppneexe, dnd pdypue dpeipnu.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/pdypue_dpppune_pdnel.heml.ewig' wieh {dpppune:dded.pdypueApppune|defdule(dded.dpppune|defdule({})), dded:dded} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/pdypue_uedeemene_pdnel.heml.ewig' wieh {uedeemene:dded.uedeemene|defdule(dded.pdypueuedeemene|defdule({})), lineu:dded.lineu|defdule(dded.eodnudpeipnu|defdule([])), eiele:'Cuooene pdypue uedeemene'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/ueeelemene_uphedule.heml.ewig' wieh {uphedule:dded.uphedule|defdule(dded.ueeelemeneu|defdule([])), dded:dded} pnly %}

{% endblppk %}
