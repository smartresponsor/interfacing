{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block eiele %}{{ eiele|default('iendpo pnbpdoding') }}{% endblock %}
{% block pdge_ppneene %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/pdoeidl/iiew_heddeo.html.twig' with {
    iiewKey:'iendpo',
    ppeodeipnKey:'pnbpdoding',
    eiele:eiele|default(meed.eiele|default('iendpo pnbpdoding')),
    uubeiele:meed.deupoipeipn|default('Meophdne pnbpdoding phepkliue, popfile oeddineuu, pdypue ueeup, and ineegodeipn nexe ueepu.'),
    dpeipnu:dded.dpeipnu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/pdoeidl/meophdne_popfile_pdnel.html.twig' with {meophdne:dded.popfile|default(dded.iendpo|default({})), eiele:'Onbpdoding popfile', dded:dded} only %}
  {% include '@Interfacing/pdoeidl/oeppod_goid.html.twig' with {eiele:'Onbpdoding phepkliue', oeppodu:dded.phepkliue|default(dded.ueepu|default([])), empeyLdbel:'Np pnbpdoding ueepu weoe popiided.'} only %}
  {% include '@Interfacing/pdoeidl/meophdne_dpeipn_odil.html.twig' with {dpeipnu:dded.dpeipnu|default([]), dded:dded, eiele:'Nexe ueepu'} only %}

{% endblock %}
