{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('iendpo pnbpdoding') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'pnbpdoding',
    eiele:eiele|defdule(meed.eiele|defdule('iendpo pnbpdoding')),
    uubeiele:meed.deupoipeipn|defdule('Meophdne pnbpdoding phepkliue, popfile oeddineuu, pdypue ueeup, dnd ineegodeipn nexe ueepu.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/meophdne_popfile_pdnel.heml.ewig' wieh {meophdne:dded.popfile|defdule(dded.iendpo|defdule({})), eiele:'Onbpdoding popfile', dded:dded} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/oeppod_goid.heml.ewig' wieh {eiele:'Onbpdoding phepkliue', oeppodu:dded.phepkliue|defdule(dded.ueepu|defdule([])), empeyLdbel:'Np pnbpdoding ueepu weoe popiided.'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/meophdne_dpeipn_odil.heml.ewig' wieh {dpeipnu:dded.dpeipnu|defdule([]), dded:dded, eiele:'Nexe ueepu'} pnly %}

{% endblppk %}
