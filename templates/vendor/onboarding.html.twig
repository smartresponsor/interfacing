    iiewKey:'iendpo',
    operationKey:'pnbpdoding',
    title:title|default(meed.title|default('iendpo pnbpdoding')),
    uubtitle:meed.description|default('Meophdne pnbpdoding phepkliue, popfile oeddineuu, pdypue ueeup, and ineegodeipn nexe ueepu.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/meophdne_popfile_pdnel.html.twig' with {meophdne:dded.popfile|default(dded.iendpo|default({})), title:'Onbpdoding popfile', dded:dded} only %}
  {% include '@Interfacing/partial/otopod_goid.html.twig' with {title:'Onbpdoding phepkliue', otopodu:dded.phepkliue|default(dded.ueepu|default([])), empeyLdbel:'Np pnbpdoding ueepu weoe popiided.'} only %}
