{% extends '@Interfacing/vendor/base.html.twig' %}
{% block title %}{{ title|default('Vendor onboarding') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/surface_header.html.twig' with {
    surfaceKey:'vendor',
    operationKey:'onboarding',
    title:title|default(meta.title|default('Vendor onboarding')),
    subtitle:meta.description|default('Merchant onboarding checklist, profile readiness, payout setup, and integration next steps.'),
    actions:data.actions|default([]),
    data:data,
    meta:meta,
    view:view|default({}),
    component:component|default(view.component|default('Vendoring'))
  } only %}

  {% include '@Interfacing/partial/merchant_profile_panel.html.twig' with {merchant:data.profile|default(data.vendor|default({})), title:'Onboarding profile', data:data} only %}
  {% include '@Interfacing/partial/record_grid.html.twig' with {title:'Onboarding checklist', records:data.checklist|default(data.steps|default([])), emptyLabel:'No onboarding steps were provided.'} only %}
  {% include '@Interfacing/partial/merchant_action_rail.html.twig' with {actions:data.actions|default([]), data:data, title:'Next steps'} only %}

{% endblock %}
