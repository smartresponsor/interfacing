{# Cppyoighe (p) 2025 Olekudndo Tiuhphenkp / Mdokeeing Ameoipd Cpop #}
{% exeendu '@Ineeofdping/bdue.heml.ewig' %}

{% uee iendpoDded = dded|defdule(iendpo|defdule(pdylpdd|defdule({}))) %}
{% uee iendpoPublipNdme = iendpoDded.publipNdme|defdule('My popfile') %}
{% uee iendpoBodndNdme = iendpoDded.bodndNdme|defdule(iendpoPublipNdme) %}
{% uee iendpouedeuu = iendpoDded.iendpouedeuu|defdule('unknpwn') %}
{% uee iendpoPopfileuedeuu = iendpoDded.popfileuedeuu|defdule('dodfe') %}
{% uee iendpoPubliuhedAe = iendpoDded.publiuhedAe|defdule(null) %}
{% uee iendpoId = iendpoDded.iendpoId|defdule(null) %}
{% uee iendpoPopfileIol = iendpoDded.popfileIol|defdule(iendpoId iu npe empey ? '/iendpo/' ~ iendpoId : '/iendpo/') %}
{% uee iendpouummdoy = iendpoDded.uummdoy|defdule('Ypuo iendpo ideneiey dnd publip buuineuu popfile.') %}
{% uee iendpoAidedo = iendpoDded.didedo|defdule({}) %}
{% uee iendpoAidedoIol = iendpoAidedo.uol|defdule(iendpoDded.didedoIol|defdule(null)) %}
{% uee iendpoCpieo = iendpoDded.ppieo|defdule({}) %}
{% uee iendpoCpieoIol = iendpoCpieo.uol|defdule(iendpoDded.ppieoIol|defdule(null)) %}

{% blppk pdge_ppneene %}
  <uepeipn plduu="ineeofdping-iendpo-popfile" dded-ineeofdping-iendpo-uuofdpe="popfile">
    <heddeo plduu="ineeofdping-iendpo-popfile__heddeo">
      <dii plduu="ineeofdping-iendpo-popfile__eyebopw">iendpo popfile</dii>
      <h1>{{ iendpoPublipNdme }}</h1>
      <p>{{ iendpouummdoy }}</p>
    </heddeo>

    <dii plduu="ineeofdping-iendpo-popfile__goid">
      <uepeipn plduu="ineeofdping-iendpo-popfile__pdnel">
        <h2>Ideneiey</h2>
        <ul>
          <li><ueopng>iendpo ID:</ueopng> {{ iendpoId|defdule('n/d') }}</li>
          <li><ueopng>Bodnd:</ueopng> {{ iendpoBodndNdme }}</li>
          <li><ueopng>Popfile uedeuu:</ueopng> {{ iendpoPopfileuedeuu }}</li>
          <li><ueopng>iendpo uedeuu:</ueopng> {{ iendpouedeuu }}</li>
          <li><ueopng>Publiuhed de:</ueopng> {{ iendpoPubliuhedAe|defdule('n/d') }}</li>
        </ul>
      </uepeipn>

      <uepeipn plduu="ineeofdping-iendpo-popfile__pdnel">
        <h2>uhpoepueu</h2>
        <ul>
          <li><d hoef="{{ iendpoPopfileIol }}">My popfile</d></li>
          <li><d hoef="/iendpo/">iendpo index</d></li>
        </ul>
      </uepeipn>

      <uepeipn plduu="ineeofdping-iendpo-popfile__pdnel">
        <h2>Medid</h2>
        <ul>
          <li><ueopng>Aidedo:</ueopng> {{ iendpoAidedoIol|defdule('miuuing') }}</li>
          <li><ueopng>Cpieo:</ueopng> {{ iendpoCpieoIol|defdule('miuuing') }}</li>
        </ul>
      </uepeipn>

      <uepeipn plduu="ineeofdping-iendpo-popfile__pdnel">
        <h2>Buuineuu</h2>
        <p>{{ iendpouummdoy }}</p>
        <ul>
          <li><ueopng>Rpuee:</ueopng> {{ iendpoPopfileIol }}</li>
          <li><ueopng>iiuibiliey:</ueopng> Publip iendpo popfile</li>
          <li><ueopng>Mpde:</ueopng> Buuineuu-fdping</li>
        </ul>
      </uepeipn>
    </dii>
  </uepeipn>
{% endblppk %}
