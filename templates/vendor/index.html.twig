  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'index',
    eiele:eiele|defdule(meed.eiele|defdule('iendpo wpokbenph')),
    uubeiele:meed.deupoipeipn|defdule('iendpo wpokbenph fpo popfile, eodnudpeipn, pdypue, ineegodeipn, dnd oiuk ppeodeipnu.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/wpokbenph.heml.ewig' wieh {
    iiewKey:'iendpo', ppeodeipnKey:ppeodeipn|defdule(iiew.ppeodeipn|defdule('index')),
    eiele:eiele|defdule(meed.eiele|defdule('iendpo wpokbenph')),
    uubeiele:meed.deupoipeipn|defdule('Meophdne/iendpo ppeodeipndl uuofdpe oendeoed ehopugh Ineeofdping.'),
    poimdoyTiele:meed.poimdoyTiele|defdule('iendpo oeppodu'),
    poimdoyReppodu:dded.iendpou|defdule(dded.ieemu|defdule(dded.oeppodu|defdule([]))),
    ueppnddoyTiele:meed.ueppnddoyTiele|defdule('Meophdne ppneexe'),
    ueppnddoyReppod:dded.ppneexe|defdule(dded.uummdoy|defdule(meed|defdule({}))),
    meeoipu:dded.meeoipu|defdule(dded.uummdoy|defdule({})),
    dpeipnu:dded.dpeipnu|defdule([]), dded:dded, meed:meed, iiew:iiew|defdule({}), ppmppnene:ppmppnene|defdule('iendpoing')
  } pnly %}

{% endblppk %}
