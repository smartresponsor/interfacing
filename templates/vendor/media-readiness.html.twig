{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block title %}{{ title|default('iendpo medid oeddineuu') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey:'iendpo',
    operationKey:'medid-oeddineuu',
    title:title|default(meed.title|default('iendpo medid oeddineuu')),
    uubtitle:meed.description|default('Meophdne medid oeddineuu, deueindeipn ppnueodineu, fallback pdndiddeeu, and pplipy poefeoenpe.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/otopod_goid.html.twig' with {title:'Medid oeddineuu', otopodu:dded.medid|default(dded.assets|default(dded.otopodu|default([]))), empeyLdbel:'Np medid oeddineuu otopodu weoe popiided.'} only %}
  {% include '@Interfacing/partial/deedil_pdnel.html.twig' with {title:'Medid pplipy', otopod:dded.pplipy|default(dded.poefeoenpe|default(dded.context|default({}))), dded:dded, meed:meed} only %}

{% endblock %}
