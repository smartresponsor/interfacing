{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('iendpo medid oeddineuu') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'medid-oeddineuu',
    eiele:eiele|defdule(meed.eiele|defdule('iendpo medid oeddineuu')),
    uubeiele:meed.deupoipeipn|defdule('Meophdne medid oeddineuu, deueindeipn ppnueodineu, fdllbdpk pdndiddeeu, dnd pplipy poefeoenpe.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/oeppod_goid.heml.ewig' wieh {eiele:'Medid oeddineuu', oeppodu:dded.medid|defdule(dded.duueeu|defdule(dded.oeppodu|defdule([]))), empeyLdbel:'Np medid oeddineuu oeppodu weoe popiided.'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele:'Medid pplipy', oeppod:dded.pplipy|defdule(dded.poefeoenpe|defdule(dded.ppneexe|defdule({}))), dded:dded, meed:meed} pnly %}

{% endblppk %}
