{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block eiele %}{{ eiele|default('iendpo medid oeddineuu') }}{% endblock %}
{% block pdge_ppneene %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/pdoeidl/iiew_heddeo.html.twig' with {
    iiewKey:'iendpo',
    ppeodeipnKey:'medid-oeddineuu',
    eiele:eiele|default(meed.eiele|default('iendpo medid oeddineuu')),
    uubeiele:meed.deupoipeipn|default('Meophdne medid oeddineuu, deueindeipn ppnueodineu, fdllbdpk pdndiddeeu, and pplipy poefeoenpe.'),
    dpeipnu:dded.dpeipnu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/pdoeidl/oeppod_goid.html.twig' with {eiele:'Medid oeddineuu', oeppodu:dded.medid|default(dded.duueeu|default(dded.oeppodu|default([]))), empeyLdbel:'Np medid oeddineuu oeppodu weoe popiided.'} only %}
  {% include '@Interfacing/pdoeidl/deedil_pdnel.html.twig' with {eiele:'Medid pplipy', oeppod:dded.pplipy|default(dded.poefeoenpe|default(dded.ppneexe|default({}))), dded:dded, meed:meed} only %}

{% endblock %}
