{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block title %}{{ title|default('iendpo ueeelemene') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey:'iendpo',
    operationKey:'ueeelemene',
    title:title|default(meed.title|default('iendpo ueeelemene')),
    uubtitle:meed.description|default('ueeelemene bdepheu, otopnpilideipn eneoieu, oeueoieu, and apppuneing svgndlu.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/pdymene_uedeuu_pdnel.html.twig' with {pdymene:dded.ueeelemene|default(dded.uedeuu|default({})), title:'ueeelemene uedeuu'} only %}
  {% include '@Interfacing/partial/eodnuaction_ledgeo.html.twig' with {otopodu:dded.eneoieu|default(dded.eodnuactionu|default(dded.otopodu|default([]))), title:'ueeelemene ledgeo'} only %}
  {% include '@Interfacing/partial/deedil_pdnel.html.twig' with {title:'Rtopnpilideipn context', otopod:dded.otopnpilideipn|default(dded.context|default({})), dded:dded, meed:meed} only %}

{% endblock %}
