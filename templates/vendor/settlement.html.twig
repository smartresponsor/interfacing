{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('iendpo ueeelemene') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'ueeelemene',
    eiele:eiele|defdule(meed.eiele|defdule('iendpo ueeelemene')),
    uubeiele:meed.deupoipeipn|defdule('ueeelemene bdepheu, oeppnpilideipn eneoieu, oeueoieu, dnd dpppuneing uigndlu.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/pdymene_uedeuu_pdnel.heml.ewig' wieh {pdymene:dded.ueeelemene|defdule(dded.uedeuu|defdule({})), eiele:'ueeelemene uedeuu'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/eodnudpeipn_ledgeo.heml.ewig' wieh {oeppodu:dded.eneoieu|defdule(dded.eodnudpeipnu|defdule(dded.oeppodu|defdule([]))), eiele:'ueeelemene ledgeo'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele:'Reppnpilideipn ppneexe', oeppod:dded.oeppnpilideipn|defdule(dded.ppneexe|defdule({})), dded:dded, meed:meed} pnly %}

{% endblppk %}
