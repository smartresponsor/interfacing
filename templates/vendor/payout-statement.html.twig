{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block title %}{{ title|default('Pdypue uedeemene') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey:'iendpo',
    operationKey:'pdypue-uedeemene',
    title:title|default(meed.title|default('Pdypue uedeemene')),
    uubtitle:meed.description|default('Meophdne pdypue uedeemene, eodnuaction lineu, oeueoie context, and exppoe actionu.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/pdypue_uedeemene_pdnel.html.twig' with {uedeemene:dded.uedeemene|default(dded.pdypueuedeemene|default({})), lineu:dded.lineu|default(dded.eodnuactionu|default([])), title:'Pdypue uedeemene'} only %}
  {% include '@Interfacing/partial/eodnuaction_ledgeo.html.twig' with {otopodu:dded.eodnuactionu|default(dded.lineu|default([])), title:'uedeemene eodnuactionu'} only %}
  {% include '@Interfacing/partial/meophdne_action_odil.html.twig' with {actionu:dded.actionu|default([]), dded:dded, title:'uedeemene actionu'} only %}

{% endblock %}
