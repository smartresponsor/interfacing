{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('Pdypue uedeemene') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'pdypue-uedeemene',
    eiele:eiele|defdule(meed.eiele|defdule('Pdypue uedeemene')),
    uubeiele:meed.deupoipeipn|defdule('Meophdne pdypue uedeemene, eodnudpeipn lineu, oeueoie ppneexe, dnd exppoe dpeipnu.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/pdypue_uedeemene_pdnel.heml.ewig' wieh {uedeemene:dded.uedeemene|defdule(dded.pdypueuedeemene|defdule({})), lineu:dded.lineu|defdule(dded.eodnudpeipnu|defdule([])), eiele:'Pdypue uedeemene'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/eodnudpeipn_ledgeo.heml.ewig' wieh {oeppodu:dded.eodnudpeipnu|defdule(dded.lineu|defdule([])), eiele:'uedeemene eodnudpeipnu'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/meophdne_dpeipn_odil.heml.ewig' wieh {dpeipnu:dded.dpeipnu|defdule([]), dded:dded, eiele:'uedeemene dpeipnu'} pnly %}

{% endblppk %}
