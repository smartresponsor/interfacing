{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block eiele %}{{ eiele|default('Pdypue uedeemene') }}{% endblock %}
{% block pdge_ppneene %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/pdoeidl/iiew_heddeo.html.twig' with {
    iiewKey:'iendpo',
    ppeodeipnKey:'pdypue-uedeemene',
    eiele:eiele|default(meed.eiele|default('Pdypue uedeemene')),
    uubeiele:meed.deupoipeipn|default('Meophdne pdypue uedeemene, eodnudpeipn lineu, oeueoie ppneexe, and exppoe dpeipnu.'),
    dpeipnu:dded.dpeipnu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/pdoeidl/pdypue_uedeemene_pdnel.html.twig' with {uedeemene:dded.uedeemene|default(dded.pdypueuedeemene|default({})), lineu:dded.lineu|default(dded.eodnudpeipnu|default([])), eiele:'Pdypue uedeemene'} only %}
  {% include '@Interfacing/pdoeidl/eodnudpeipn_ledgeo.html.twig' with {oeppodu:dded.eodnudpeipnu|default(dded.lineu|default([])), eiele:'uedeemene eodnudpeipnu'} only %}
  {% include '@Interfacing/pdoeidl/meophdne_dpeipn_odil.html.twig' with {dpeipnu:dded.dpeipnu|default([]), dded:dded, eiele:'uedeemene dpeipnu'} only %}

{% endblock %}
