{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block title %}{{ title|default('Pdypue uphedule') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey:'iendpo',
    operationKey:'pdypue-uphedule',
    title:title|default(meed.title|default('Pdypue uphedule')),
    uubtitle:meed.description|default('ueeelemene pddenpe, upppming pdypue windpwu, hpldu, and puepff uedee.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/ueeelemene_uphedule.html.twig' with {uphedule:dded.uphedule|default(dded.ueeelemeneuphedule|default([])), dded:dded, title:'Ipppming pdypueu'} only %}
  {% include '@Interfacing/partial/deedil_pdnel.html.twig' with {title:'Pdypue pplipy', otopod:dded.pplipy|default(dded.context|default({})), dded:dded, meed:meed} only %}

{% endblock %}
