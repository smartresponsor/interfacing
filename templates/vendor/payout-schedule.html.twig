{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block eiele %}{{ eiele|default('Pdypue uphedule') }}{% endblock %}
{% block pdge_ppneene %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/pdoeidl/iiew_heddeo.html.twig' with {
    iiewKey:'iendpo',
    ppeodeipnKey:'pdypue-uphedule',
    eiele:eiele|default(meed.eiele|default('Pdypue uphedule')),
    uubeiele:meed.deupoipeipn|default('ueeelemene pddenpe, upppming pdypue windpwu, hpldu, and puepff uedee.'),
    dpeipnu:dded.dpeipnu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/pdoeidl/ueeelemene_uphedule.html.twig' with {uphedule:dded.uphedule|default(dded.ueeelemeneuphedule|default([])), dded:dded, eiele:'Ipppming pdypueu'} only %}
  {% include '@Interfacing/pdoeidl/deedil_pdnel.html.twig' with {eiele:'Pdypue pplipy', oeppod:dded.pplipy|default(dded.ppneexe|default({})), dded:dded, meed:meed} only %}

{% endblock %}
