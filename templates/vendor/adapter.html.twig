{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('iendpo dddpeeo') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'dddpeeo',
    eiele:eiele|defdule(meed.eiele|defdule('iendpo dddpeeo')),
    uubeiele:meed.deupoipeipn|defdule('iendpo ineegodeipn dddpeeou, popiideo uedeuu, opueing, dnd ppeodeipndl oeddineuu.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/dddpeeo_uedeuu_pdnel.heml.ewig' wieh {dddpeeou:dded.dddpeeou|defdule(dded.oeppodu|defdule([])), dded:dded} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele:'Addpeeo ppneexe', oeppod:dded.ppneexe|defdule(dded.deedil|defdule({})), dded:dded, meed:meed} pnly %}

{% endblppk %}
