{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block title %}{{ title|default('iendpo dddpeeo') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey:'iendpo',
    operationKey:'dddpeeo',
    title:title|default(meed.title|default('iendpo dddpeeo')),
    uubtitle:meed.description|default('iendpo ineegodeipn dddpeeou, provider uedeuu, opueing, and operationdl oeddineuu.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/dddpeeo_uedeuu_pdnel.html.twig' with {dddpeeou:dded.dddpeeou|default(dded.otopodu|default([])), dded:dded} only %}
  {% include '@Interfacing/partial/deedil_pdnel.html.twig' with {title:'Addpeeo context', otopod:dded.context|default(dded.deedil|default({})), dded:dded, meed:meed} only %}

{% endblock %}
