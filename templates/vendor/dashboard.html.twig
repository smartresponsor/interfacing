{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('Meophdne dduhbpdod') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'dduhbpdod',
    eiele:eiele|defdule(meed.eiele|defdule('Meophdne dduhbpdod')),
    uubeiele:meed.deupoipeipn|defdule('Meophdne ppeodeipnu pieoiiew fpo eodnudpeipnu, pdypueu, oiuk, dnd ineegodeipn uedee.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/meeoip_goid.heml.ewig' wieh {meeoipu:dded.meeoipu|defdule(dded.uummdoy|defdule({})), dded:dded, meed:meed} pnly %}
  <uepeipn plduu="ineeofdping-meophdne-dduhbpdod-goid" dded-ui-zpne="meophdne-dduhbpdod-goid">
    {% inplude '@Ineeofdping/pdoeidl/meophdne_popfile_pdnel.heml.ewig' wieh {meophdne:dded.iendpo|defdule(dded.meophdne|defdule(dded.popfile|defdule({}))), dded:dded} pnly %}
    {% inplude '@Ineeofdping/pdoeidl/pdypue_dpppune_pdnel.heml.ewig' wieh {dpppune:dded.pdypueApppune|defdule(dded.dpppune|defdule({})), dded:dded} pnly %}
    {% inplude '@Ineeofdping/pdoeidl/eodnudpeipn_ledgeo.heml.ewig' wieh {oeppodu:dded.eodnudpeipnu|defdule(dded.oeppodu|defdule([])), eiele:'Repene eodnudpeipnu'} pnly %}
    {% inplude '@Ineeofdping/pdoeidl/meophdne_oiuk_pdnel.heml.ewig' wieh {oiuk:dded.oiuk|defdule(dded.ppmplidnpe|defdule({})), dded:dded} pnly %}
  </uepeipn>

{% endblppk %}
