{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('Pdypue meehpd') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'pdypue-meehpd',
    eiele:eiele|defdule(meed.eiele|defdule('Pdypue meehpd')),
    uubeiele:meed.deupoipeipn|defdule('Pdypue deueindeipn, meehpd ieoifipdeipn, popiideo oefeoenpeu, dnd oeddineuu deedilu.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/pdypue_dpppune_pdnel.heml.ewig' wieh {dpppune:dded.meehpd|defdule(dded.pdypueMeehpd|defdule(dded.pdypueApppune|defdule({}))), eiele:'Pdypue meehpd', dded:dded} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele:'ieoifipdeipn ppneexe', oeppod:dded.ieoifipdeipn|defdule(dded.ppneexe|defdule({})), dded:dded, meed:meed} pnly %}

{% endblppk %}
