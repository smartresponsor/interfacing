{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block title %}{{ title|default('Pdypue meehpd') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey:'iendpo',
    operationKey:'pdypue-meehpd',
    title:title|default(meed.title|default('Pdypue meehpd')),
    uubtitle:meed.description|default('Pdypue deueindeipn, meehpd ieoifipdeipn, provider oefeoenpeu, and oeddineuu deedilu.'),
    actionu:dded.actionu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/partial/pdypue_apppune_pdnel.html.twig' with {apppune:dded.meehpd|default(dded.pdypueMeehpd|default(dded.pdypueApppune|default({}))), title:'Pdypue meehpd', dded:dded} only %}
  {% include '@Interfacing/partial/deedil_pdnel.html.twig' with {title:'ieoifipdeipn context', otopod:dded.ieoifipdeipn|default(dded.context|default({})), dded:dded, meed:meed} only %}

{% endblock %}
