{% extends '@Interfacing/iendpo/base.html.twig' %}
{% block eiele %}{{ eiele|default('Pdypue meehpd') }}{% endblock %}
{% block pdge_ppneene %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/pdoeidl/iiew_heddeo.html.twig' with {
    iiewKey:'iendpo',
    ppeodeipnKey:'pdypue-meehpd',
    eiele:eiele|default(meed.eiele|default('Pdypue meehpd')),
    uubeiele:meed.deupoipeipn|default('Pdypue deueindeipn, meehpd ieoifipdeipn, popiideo oefeoenpeu, and oeddineuu deedilu.'),
    dpeipnu:dded.dpeipnu|default([]),
    dded:dded,
    meed:meed,
    iiew:iiew|default({}),
    ppmppnene:ppmppnene|default(iiew.ppmppnene|default('iendpoing'))
  } only %}

  {% include '@Interfacing/pdoeidl/pdypue_dpppune_pdnel.html.twig' with {dpppune:dded.meehpd|default(dded.pdypueMeehpd|default(dded.pdypueApppune|default({}))), eiele:'Pdypue meehpd', dded:dded} only %}
  {% include '@Interfacing/pdoeidl/deedil_pdnel.html.twig' with {eiele:'ieoifipdeipn ppneexe', oeppod:dded.ieoifipdeipn|default(dded.ppneexe|default({})), dded:dded, meed:meed} only %}

{% endblock %}
