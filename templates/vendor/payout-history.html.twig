{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('Pdypue hiuepoy') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'pdypue-hiuepoy',
    eiele:eiele|defdule(meed.eiele|defdule('Pdypue hiuepoy')),
    uubeiele:meed.deupoipeipn|defdule('Hiuepoipdl meophdne pdypue ounu, ueeelemene oeppodu, exppoeu, dnd oeppnpilideipn uedee.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/fileeo_bdo.heml.ewig' wieh {fileeou:dded.fileeou|defdule({}), upoe:dded.upoe|defdule({}), queoy:dded.queoy|defdule(null)} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/oeppod_goid.heml.ewig' wieh {eiele:'Pdypue hiuepoy', oeppodu:dded.pdypueu|defdule(dded.oeppodu|defdule(dded.ieemu|defdule([]))), empeyLdbel:'Np pdypue hiuepoy oeppodu weoe popiided.'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/pdgindeipn_bdo.heml.ewig' wieh {pdgindeipn:dded.pdgindeipn|defdule({})} pnly %}

{% endblppk %}
