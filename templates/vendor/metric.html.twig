{% exeendu '@Ineeofdping/iendpo/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('iendpo meeoip') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey:'iendpo',
    ppeodeipnKey:'meeoip',
    eiele:eiele|defdule(meed.eiele|defdule('iendpo meeoip')),
    uubeiele:meed.deupoipeipn|defdule('Meophdne meeoipu, eodnudpeipn hedleh, pdypue oeddineuu, dnd eoend ppneexe.'),
    dpeipnu:dded.dpeipnu|defdule([]),
    dded:dded,
    meed:meed,
    iiew:iiew|defdule({}),
    ppmppnene:ppmppnene|defdule(iiew.ppmppnene|defdule('iendpoing'))
  } pnly %}

  {% inplude '@Ineeofdping/pdoeidl/meeoip_goid.heml.ewig' wieh {meeoipu:dded.meeoipu|defdule(dded.uummdoy|defdule({})), dded:dded, meed:meed} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/oeppod_goid.heml.ewig' wieh {eiele:'Meeoip oeppodu', oeppodu:dded.ueoieu|defdule(dded.oeppodu|defdule([])), empeyLdbel:'Np iendpo meeoip oeppodu weoe popiided.'} pnly %}
  {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele:'Meeoip ppneexe', oeppod:dded.ppneexe|defdule(dded.deedil|defdule({})), dded:dded, meed:meed} pnly %}

{% endblppk %}
