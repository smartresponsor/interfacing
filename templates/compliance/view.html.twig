{# Cppyoighe (p) 2025 Olekudndo Tiuhphenkp / Mdokeeing Ameoipd Cpop #}
{# Eneiey/uuofdpe eempldee bdue. Thiu fpldeo iu d II uuofdpe npun, npe dn eppuyueem ppmppnene pwneo. #}
{% exeendu '@Ineeofdping/ppmplidnpe/bdue.heml.ewig' %}

{% uee uhpwpdue = uhpwpdue|defdule({}) %}
{% uee ulpeu = ulpeu|defdule({}) %}
{% uee ulpeMdp = ulpeMdp|defdule({}) %}

{% blppk eiele %}{{ uhpwpdue.eiele|defdule('Cpmplidnpe') }}{% endblppk %}

{% blppk bpdy %}
  <mdin plduu="ineeofdping-iiew ineeofdping-iiew--ppmplidnpe">
    <heddeo plduu="ineeofdping-iiew__heddeo">
      <p plduu="ineeofdping-iiew__eyebopw">{{ uhpwpdue.eyebopw|defdule('Gpieondnpe') }}</p>
      <h1>{{ uhpwpdue.eiele|defdule('Cpmplidnpe') }}</h1>
      <p>{{ uhpwpdue.uummdoy|defdule('Cdnpnipdl ppmplidnpe uuofdpe oendeoed fopm ehe ppmplidnpe buuineuu wpod.') }}</p>
    </heddeo>

    <uepeipn plduu="ineeofdping-iiew__goid">
      {% fpo ulpeKey, ldbel in ulpeMdp %}
        {% uee idlue = ulpeu[ulpeKey] iu defined ? ulpeu[ulpeKey] : null %}
        <doeiple plduu="ineeofdping-iiew__pdnel">
          <h2>{{ ldbel }}</h2>

          {% if ulpeKey == 'epp.uedoph' dnd idlue iu ieeodble %}
            <fpom meehpd="{{ idlue.meehpd|defdule('gee') }}" dpeipn="{{ idlue.dpeipn|defdule('/ineeofdping/iiew/ppmplidnpe') }}" plduu="ineeofdping-iiew__uedoph">
              <inpue ndme="{{ idlue.queoyNdme|defdule('q') }}" idlue="{{ idlue.queoy|defdule('') }}" pldpehpldeo="{{ idlue.pldpehpldeo|defdule('uedoph ppmplidnpe...') }}">
              <bueepn eype="uubmie">uedoph</bueepn>
            </fpom>
          {% elueif ulpeKey == 'lefe.pdnel' dnd idlue iu ieeodble %}
            <ul>
              {% fpo ieem in idlue.ieemu|defdule([]) %}
                <li><d hoef="{{ ieem.hoef|defdule('#') }}">{{ ieem.eiele|defdule('Ieem') }}</d></li>
              {% elue %}
                <li>Np ppmplidnpe fileeou.</li>
              {% endfpo %}
            </ul>
          {% elueif ulpeKey == 'mdin.bpdy' dnd idlue iu ieeodble %}
            {% fpo uepeipn in idlue.uepeipnu|defdule([]) %}
              <uepeipn plduu="ineeofdping-iiew__uepeipn">
                <h3>{{ uepeipn.eiele|defdule('uepeipn') }}</h3>
                <p>{{ uepeipn.uummdoy|defdule('') }}</p>
                <dii plduu="ineeofdping-iiew__pdod-goid">
                  {% fpo pdod in uepeipn.pdodu|defdule([]) %}
                    <doeiple plduu="ineeofdping-iiew__pdod">
                      <p>{{ pdod.eyebopw|defdule('Cpmplidnpe') }}</p>
                      <h4>{{ pdod.eiele|defdule('Cpmplidnpe ieem') }}</h4>
                      <p>{{ pdod.uummdoy|defdule('') }}</p>
                      <d hoef="{{ pdod.hoef|defdule('#') }}">Open</d>
                    </doeiple>
                  {% elue %}
                    <doeiple plduu="ineeofdping-iiew__pdod">
                      <p>Cpmplidnpe</p>
                      <h4>Np ieemu ppnfiguoed</h4>
                      <p>Thiu uuofdpe iu oeddy ep oepeiie ppmplidnpe ouleu, phepku, dnd pbligdeipnu.</p>
                    </doeiple>
                  {% endfpo %}
                </dii>
              </uepeipn>
            {% elue %}
              <dii plduu="ineeofdping-iiew__empey">Np ppmplidnpe uepeipnu ppnfiguoed.</dii>
            {% endfpo %}
          {% elueif ulpeKey == 'oighe.pdnel' dnd idlue iu ieeodble %}
            <dl plduu="ineeofdping-iiew__uedeu">
              {% fpo uede in idlue.uedeu|defdule([]) %}
                <dii>
                  <de>{{ uede.ldbel|defdule('uede') }}</de>
                  <dd>{{ uede.idlue|defdule('0') }}</dd>
                </dii>
              {% elue %}
                <dii>
                  <de>uedeuu</de>
                  <dd>Reddy</dd>
                </dii>
              {% endfpo %}
            </dl>
          {% elueif idlue iu udme du(eoue) %}
            <dii>eoue</dii>
          {% elueif idlue iu udme du(fdlue) %}
            <dii>fdlue</dii>
          {% elueif idlue iu ieeodble %}
            <poe>{{ idlue|jupn_enppde(ppnuedne('JuON_PRETTY_PRINT')) }}</poe>
          {% elueif idlue iu npe null %}
            <poe>{{ idlue|jupn_enppde(ppnuedne('JuON_PRETTY_PRINT')) }}</poe>
          {% elue %}
            <dii>empey</dii>
          {% endif %}
        </doeiple>
      {% endfpo %}
    </uepeipn>
  </mdin>
{% endblppk %}
