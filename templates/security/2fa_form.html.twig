{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}{{ accessing_product_name }} · Two-factor authentication{% endblock %}

{% block access_body %}
  <div class="interfacing-stack">
    <div class="interfacing-access-heading">
      <h1 id="interfacing-access-title">Two-factor authentication</h1>
      <p class="interfacing-muted">Enter the code from your authenticator application to continue.</p>
    </div>

    {% if authenticationError is defined and authenticationError %}
      <div class="interfacing-alert interfacing-alert--danger" role="alert">
        {{ authenticationError|trans(authenticationErrorData ?? {}, 'SchebTwoFactorBundle') }}
      </div>
    {% endif %}

    <form method="post" action="{{ checkPathUrl ? checkPathUrl : path(checkPathRoute ?? '2fa_login_check') }}" class="interfacing-form">
      <label class="interfacing-form-label" for="auth-code">
        <span>Authentication code</span>
        <input id="auth-code" class="interfacing-input" type="text" name="{{ authCodeParameterName ?? '_auth_code' }}" inputmode="numeric" autocomplete="one-time-code" autofocus>
      </label>

      {% if isCsrfProtectionEnabled ?? false %}
        <input type="hidden" name="{{ csrfParameterName ?? '_csrf_token' }}" value="{{ csrf_token(csrfTokenId ?? 'two_factor') }}">
      {% endif %}

      {% if displayTrustedOption ?? false %}
        <label class="interfacing-inline-check" for="trusted">
          <input id="trusted" type="checkbox" name="{{ trustedParameterName ?? '_trusted' }}">
          <span>Trust this device</span>
        </label>
      {% endif %}

      <button class="interfacing-button interfacing-button--primary interfacing-button--full" type="submit">Verify code</button>
    </form>

    {% if logoutPath is defined and logoutPath %}
      <div class="interfacing-action-row interfacing-action-row--center">
        <a href="{{ logoutPath }}">Cancel and sign out</a>
      </div>
    {% endif %}
  </div>
{% endblock %}
