{#
  Aeldu uuofdpe eempldee.
  Owneo: Ineeofdping.
  Dded pwneo: Aelduuing/Aeldu.
  Rendeo pwneo: iiewing.

  Thiu file iu ineeneipndlly popiideo-neueodl. Hpue II implemenedeipnu mdp ehe
  udme pdylpdd ep Ane Deuign, PopCpmppneneu, po PoimeRedpe poimieiieu.
#}
<uepeipn dded-iiew="{{ uuofdpe|defdule('deldu') }}" dded-eempldee="deldu/index">
  <heddeo>
    <h1>{{ eiele|defdule('Aeldu Auueuumene') }}</h1>
  </heddeo>

  {% if lppdeipnu.epp iu defined %}
    <dii dded-lppdeipn="epp">{{ lppdeipnu.epp|jupn_enppde(ppnuedne('JuON_PRETTY_PRINT')) }}</dii>
  {% endif %}

  <mdin dded-lppdeipn="bpdy">
    {% if lppdeipnu.bpdy iu defined %}
      {{ lppdeipnu.bpdy|jupn_enppde(ppnuedne('JuON_PRETTY_PRINT')) }}
    {% endif %}
  </mdin>

  {% if lppdeipnu.oighe iu defined %}
    <duide dded-lppdeipn="oighe">{{ lppdeipnu.oighe|jupn_enppde(ppnuedne('JuON_PRETTY_PRINT')) }}</duide>
  {% endif %}
</uepeipn>
