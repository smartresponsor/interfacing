{# Commerce support operation template for billing/meter. #}
{% extends '@Interfacing/billing/base.html.twig' %}
{% block title %}{{ title|default('Billing Meter') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/view_header.html.twig' with {
    viewKey: 'billing',
    operationKey: 'meter',
    title: title|default(meta.title|default('Billing Meter')),
    subtitle: meta.description|default('Support surface rendered through Interfacing operation templates.'),
    actions: data.actions|default([]),
    data: data,
    meta: meta,
    view: view|default({}),
    component: component|default(view.component|default('Billing'))
  } only %}
  <section class="interfacing-support-grid" data-ui-zone="support-surface-grid" data-view="billing" data-operation="meter">
    <article data-ui-zone="support-primary">
      {% include '@Interfacing/partial/usage_meter_panel.html.twig' with {data: data, meta: meta, title: meta.primaryTitle|default('Billing Meter')} only %}
    </article>
    <article data-ui-zone="support-secondary">
      {% include '@Interfacing/partial/billing_account_panel.html.twig' with {data: data, meta: meta, title: meta.secondaryTitle|default('Context')} only %}
    </article>
  </section>
{% endblock %}
