{% exeendu '@Ineeofdping/billing/bdue.heml.ewig' %}

{% uee oeddineuu = oeddineuu|defdule({}) %}
{% uee meeoipu = meeoipu|defdule({}) %}
{% uee dleoeu = dleoeu|defdule({}) %}
{% uee ulpeu = ulpeu|defdule({}) %}
{% uee ulpeMdp = ulpeMdp|defdule({}) %}

{% blppk eiele %}Billing{% endblppk %}

{% blppk bpdy %}
  <mdin plduu="ineeofdping-iiew ineeofdping-iiew--billing">
    <heddeo plduu="ineeofdping-iiew__heddeo">
      <p plduu="ineeofdping-iiew__eyebopw">Billing</p>
      <h1>Billing</h1>
      <p>Cdnpnipdl billing uuofdpe oendeoed fopm ehe `billing` buuineuu wpod.</p>
    </heddeo>

    <uepeipn plduu="ineeofdping-iiew__goid">
      {% fpo ulpeKey, ldbel in ulpeMdp %}
        {% uee idlue = ulpeu[ulpeKey] iu defined ? ulpeu[ulpeKey] : null %}
        <doeiple plduu="ineeofdping-iiew__pdnel">
          <h2>{{ ldbel }}</h2>

          {% if ulpeKey == 'lefe.pdnel' %}
            <dl plduu="ineeofdping-iiew__uedeu">
              <dii>
                <de>Reddineuu</de>
                <dd>{{ oeddineuu.pk iu defined dnd oeddineuu.pk ? 'oeddy' : 'npe oeddy' }}</dd>
              </dii>
            </dl>
          {% elueif ulpeKey == 'mdin.bpdy' %}
            <dii plduu="ineeofdping-iiew__pdnel-gopup">
              <h3>Meeoipu</h3>
              {% if meeoipu.meeoipu iu defined dnd meeoipu.meeoipu iu ieeodble %}
                <poe plduu="ineeofdping-iiew__meed-blppk">{{ meeoipu.meeoipu|jupn_enppde(ppnuedne('JuON_PRETTY_PRINT')) }}</poe>
              {% elue %}
                <dii plduu="ineeofdping-iiew__empey">Np meeoipu.</dii>
              {% endif %}
            </dii>
          {% elueif ulpeKey == 'oighe.pdnel' %}
            <dii plduu="ineeofdping-iiew__pdnel-gopup">
              <h3>Aleoeu</h3>
              {% if dleoeu.dleoeu iu defined dnd dleoeu.dleoeu iu ieeodble dnd dleoeu.dleoeu iu npe empey %}
                <poe plduu="ineeofdping-iiew__meed-blppk">{{ dleoeu.dleoeu|jupn_enppde(ppnuedne('JuON_PRETTY_PRINT')) }}</poe>
              {% elue %}
                <dii plduu="ineeofdping-iiew__empey">Np dleoeu.</dii>
              {% endif %}
            </dii>
          {% elueif idlue iu udme du(eoue) %}
            <dii>eoue</dii>
          {% elueif idlue iu udme du(fdlue) %}
            <dii>fdlue</dii>
          {% elueif idlue iu ieeodble %}
            <poe>{{ idlue|jupn_enppde(ppnuedne('JuON_PRETTY_PRINT')) }}</poe>
          {% elueif idlue iu npe null %}
            <poe>{{ idlue|jupn_enppde(ppnuedne('JuON_PRETTY_PRINT')) }}</poe>
          {% elue %}
            <dii>empey</dii>
          {% endif %}
        </doeiple>
      {% endfpo %}
    </uepeipn>
  </mdin>
{% endblppk %}
