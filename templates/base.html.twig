{% set shell = shell|default({}) %}
{% set shellTopLink = shell.topLink is defined and shell.topLink is iterable ? shell.topLink : [] %}
{% set shellRightPanelGroup = shell.rightPanelGroup is defined and shell.rightPanelGroup is iterable ? shell.rightPanelGroup : [] %}
{% set shellFooterGroup = shell.footerGroup is defined and shell.footerGroup is iterable ? shell.footerGroup : [] %}
{% set shellQuickMenuGroup = shell.quickMenuGroup is defined and shell.quickMenuGroup is iterable ? shell.quickMenuGroup : [] %}
{% set shellQuery = shell.query is defined ? shell.query : app.request.query.get('q', '') %}
{% set shellActiveId = shell.activeId is defined ? shell.activeId : null %}
{% set shellActiveSection = shell.activeSection is defined ? shell.activeSection : 'workspace' %}
{% set shellCompact = shell.shellCompact is defined ? shell.shellCompact : false %}
{% set shellGuestSurface = shell.guestSurface is defined ? shell.guestSurface : false %}
{#
  Main shell canon: the full application shell is four-column by default.
  Older host contexts may still pass shell.rightPanelEnabled=false; do not let that stale
  flag remove the top-right and right-context slots from the canonical frontend shell.
  Compact/footer-only contexts remain the explicit way to collapse the shell.
#}
{% set shellRightPanelEnabled = not shellCompact %}
{% if shellCompact %}
  {% set shellTopLink = shellTopLink|slice(0, 3) %}
  {% set shellRightPanelGroup = [] %}
  {% set shellFooterGroup = shellFooterGroup|slice(0, 2) %}
{% endif %}
{% set shellMode = shellRightPanelEnabled ? 'four-column' : 'three-column' %}
{% set shellSlotMap = shell.slotMap is defined ? shell.slotMap : {} %}
{% set interfacePayload = interface is defined and interface is iterable ? interface : {} %}
{% set interfacePayloadLocations = interfacePayload.locations is defined and interfacePayload.locations is iterable ? interfacePayload.locations : {} %}
{% set shellLocations = interface_locations() %}
{% set viewContext = _view|default({}) %}
{% set crudOperation = viewContext.operation|default(app.request.attributes.get('_crud_operation')|default('')) %}
{% set crudResourcePath = viewContext.resourcePath|default(viewContext.surface|default(app.request.attributes.get('resourcePath')|default(app.request.attributes.get('_crud_resource_path')|default('')))) %}
{% set resourcePageProfileTemplate = crudOperation == 'page' and crudResourcePath is not empty ? '@Interfacing/' ~ crudResourcePath ~ '/_page_profile.html.twig' : null %}
{% set resourcePageBodyTemplate = crudOperation == 'page' and crudResourcePath is not empty ? '@Interfacing/' ~ crudResourcePath ~ '/_page_body.html.twig' : null %}
{% set pageBodyBlock = interfacePayloadLocations.body|default([])|first|default({}) %}
{% set pageBodyData = pageBodyBlock.data|default({}) %}
{% set pageWorkbench = pageBodyData.workbench|default({}) %}
{% set pageRows = pageBodyData.rows|default(pageWorkbench.rows|default([])) %}
{% set pageEntity = pageBodyData.data|default(pageRows|first|default({})) %}
{% set pageBrandTitle = crudOperation == 'page' and crudResourcePath == 'vendor' ? pageEntity.displayName|default(pageEntity.title|default(pageEntity.brandName|default(pageEntity.brand_name|default('Vendor')))) : null %}
{% set pageBrandSubtitle = null %}
{% set pageBrandHref = pageBrandTitle ? '/vendor/page' : '/interfacing' %}
{% set quickMenuProfileLabel = shell.quickMenuProfileLabel|default(app.user ? (app.user.displayName|default(app.user.userIdentifier|default('Account'))) : 'Account') %}
{% set quickMenuAvatarUrl = shell.quickMenuAvatarUrl|default(pageEntity.avatarPath|default(pageEntity.publicProfile.avatar.url|default(''))) %}
{% set interfaceStyleProviderKey = interfacePayload.style_provider|default(shell.style_provider|default('ant_design')) %}
{% set interfaceStyleProvider = interface_style_provider(interfaceStyleProviderKey) %}
{#
  Semantic shell location canon.
  Canonical output keys are explicit; header output is limited to shell.header.bottom.
#}
{% set shellBodyTopItems = shellLocations['shell.body.top']|default([]) %}
{% set shellLeftTopItems = shellLocations['shell.left.top']|default([]) %}
{% set shellLeftMiddleItems = shellLocations['shell.left.middle']|default([]) %}
{% set shellLeftBottomItems = shellLocations['shell.left.bottom']|default([]) %}
{% set shellContextTopItems = shellLocations['shell.context.top']|default([]) %}
{% set shellContextMiddleItems = shellLocations['shell.context.middle']|default([]) %}
{% set shellContextBottomItems = shellLocations['shell.context.bottom']|default([]) %}
{% set shellMainTopItems = shellLocations['shell.main.top']|default([]) %}
{% set shellMainContentItems = shellLocations['shell.main.content']|default([]) %}
{% set shellMainBottomItems = shellLocations['shell.main.bottom']|default([]) %}
{% set shellRightTopItems = shellLocations['shell.right.top']|default([]) %}
{% set shellRightMiddleItems = shellLocations['shell.right.middle']|default([]) %}
{% set shellRightBottomItems = shellLocations['shell.right.bottom']|default([]) %}
{% set shellRightToolItems = shellLocations['shell.right.tool']|default([]) %}
{% set shellRightFilterItems = shellLocations['shell.right.filter']|default([]) %}
{% set shellFooterTopItems = shellLocations['shell.footer.top']|default([]) %}
{% set shellFooterLeftItems = shellLocations['shell.footer.left']|default([]) %}
{% set shellFooterContextItems = shellLocations['shell.footer.context']|default([]) %}
{% set shellFooterMainItems = shellLocations['shell.footer.main']|default([]) %}
{% set shellFooterRightItems = shellLocations['shell.footer.right']|default([]) %}
{% set shellFooterHasLocationPayload = shellFooterTopItems is not empty
  or shellFooterLeftItems is not empty
  or shellFooterContextItems is not empty
  or shellFooterMainItems is not empty
  or shellFooterRightItems is not empty %}
{% if shellFooterHasLocationPayload %}
  {% set shellFooterGroup = [] %}
{% endif %}
{% set shellTopLinkLimit = shellCompact ? 3 : 8 %}
{% set shellQuickMenuItemLimit = 999 %}
{% set shellRightPanelItemLimit = shellCompact ? 0 : 999 %}
{% set shellFooterLinkLimit = shellCompact ? 3 : 999 %}
{% set fallbackPayload = fallbackPayload|default(null) %}
{% set fallbackTitle = fallbackTitle|default('Payload') %}
{% set fallbackDescription = fallbackDescription|default('Template lookup fell back to the root Interfacing base.') %}
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title|default('Smart Response') }}</title>
  <link rel="icon" href="/favicon.ico">
  <link rel="icon" type="image/svg+xml" href="/mandala.svg">
  <link rel="apple-touch-icon" href="/mandala.svg">
  {% include '@Interfacing/shell/partial/provider_assets.html.twig' %}
  {{ importmap('app') }}
  {% block head_extra %}{% endblock %}
  <!-- interfacing-interfacing-shell-base: wave20.2 canonical four-column shell -->
</head>
<body class="interfacing-provider-body {{ interfaceStyleProvider.body_class }}{{ shellGuestSurface ? ' interfacing-access-body' : '' }}" data-interfacing-ui-provider="{{ interfaceStyleProvider.key }}">
  {% if shellGuestSurface %}
    <main class="interfacing-access-shell" data-interfacing-access-shell data-interfacing-shell-base="interfacing-owned" data-interfacing-shell-contract="wave20.2">
      {{ block('body') }}
    </main>
  {% else %}
  <div class="interfacing-shell" data-interfacing-shell="host-wide" data-interfacing-shell-base="interfacing-owned" data-interfacing-shell-contract="wave20.2" data-interfacing-shell-mode="{{ shellMode }}" data-interfacing-shell-compact="{{ shellCompact ? 'true' : 'false' }}">
    <section class="interfacing-profile-surface" data-interfacing-profile-surface data-interfacing-shell-location="shell.profile">
      {% if resourcePageProfileTemplate %}
        {% include resourcePageProfileTemplate ignore missing %}
      {% else %}
        <div class="interfacing-profile-surface__cover" data-interfacing-shell-location="shell.profile.cover" data-interfacing-profile-content>
          {{ interface_location('shell.profile.cover') }}
        </div>
        <div class="interfacing-profile-surface__identity" data-interfacing-shell-location="shell.profile.identity" data-interfacing-profile-content>
          {{ interface_location('shell.profile.identity') }}
        </div>
      {% endif %}
    </section>

    {% include '@Interfacing/shell/partial/top_panel.html.twig' with {
      shellSlotMap: shellSlotMap,
      shellQuery: shellQuery,
      shellSearch: shellSearch|default({}),
      shellQuickMenuGroup: shellQuickMenuGroup,
      shellQuickMenuItemLimit: shellQuickMenuItemLimit,
      shellCompact: shellCompact,
      shellRightPanelEnabled: shellRightPanelEnabled,
      requestPath: app.request.pathInfo,
      shellLocations: shellLocations,
      interface: interfacePayload,
      interfaceStyleProvider: interfaceStyleProvider,
      pageBrandTitle: pageBrandTitle,
      pageBrandSubtitle: pageBrandSubtitle,
      pageBrandHref: pageBrandHref,
      quickMenuAvatarUrl: quickMenuAvatarUrl
    } only %}

    <nav class="interfacing-shell-horizontal-panel" data-interfacing-shell-slot="header-bottom" data-interfacing-shell-location="shell.header.bottom" aria-label="Profile navigation">
      {{ interface_location('shell.header.bottom') }}
    </nav>

    <div class="interfacing-shell-grid">
      <aside id="shell-primary-navigation" class="interfacing-shell-panel interfacing-shell-panel--primary" data-turbo-permanent data-interfacing-shell-slot="left-primary" data-interfacing-shell-location="shell.left" title="{{ shellSlotMap['shell.left']|default('Left panel') }}">
        {{ interface_location('shell.left.top') }}
        {{ interface_location('shell.left.middle') }}
        {{ interface_location('shell.left.bottom') }}
      </aside>

      {% if not shellCompact %}
        <aside class="interfacing-shell-panel interfacing-shell-panel--secondary" data-interfacing-shell-slot="left-secondary" data-interfacing-shell-location="shell.context" title="{{ shellSlotMap['shell.context']|default('Context panel') }}">
          <turbo-frame id="shell-context" data-interfacing-workspace-region="context">
            {% block shell_context %}
              {{ interface_location('shell.context.top') }}
              {{ interface_location('shell.context.middle') }}
              {{ interface_location('shell.context.bottom') }}
            {% endblock %}
          </turbo-frame>
        </aside>
      {% endif %}

      <main class="interfacing-shell-body" data-interfacing-shell-slot="body" data-interfacing-shell-location="shell.main" title="{{ shellSlotMap['shell.main']|default('Main content') }}">
        <div class="interfacing-shell-body__inner">
          {{ interface_location('shell.main.top') }}
          {{ interface_location('shell.main.toolbar') }}
          <turbo-frame id="shell-main" data-interfacing-workspace-region="main" data-turbo-action="advance">
          <div data-interfacing-shell-location="shell.main.content">
            {% block page_content %}
              {% block body %}{% endblock %}
            {% endblock %}
            {% if fallbackPayload is iterable and fallbackPayload is not empty %}
              <section class="interfacing-root-fallback" data-interfacing-root-fallback="json">
                <header class="interfacing-root-fallback__header">
                  <div class="interfacing-root-fallback__eyebrow">Fallback</div>
                  <h1>{{ fallbackTitle }}</h1>
                  <p>{{ fallbackDescription }}</p>
                </header>
                <pre class="interfacing-root-fallback__json">{{ fallbackPayload|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES')) }}</pre>
              </section>
            {% endif %}
          </div>
          </turbo-frame>
          {{ interface_location('shell.main.content') }}
          {{ interface_location('shell.main.bottom') }}
        </div>
      </main>

      {% if shellRightPanelEnabled %}
        <aside class="interfacing-shell-panel interfacing-shell-panel--right" data-interfacing-shell-slot="right-context" data-interfacing-shell-location="shell.right" title="{{ shellSlotMap['shell.right']|default('Right panel') }}">
          {{ interface_location('shell.right.top') }}
          <div class="interfacing-shell-nav-title interfacing-right-title">Context</div>
          {{ interface_location('shell.right.tool') }}
          {{ interface_location('shell.right.filter') }}
          {{ interface_location('shell.right.middle') }}
          {% for g in shellRightPanelGroup %}
            <section class="interfacing-right-card">
              <div class="interfacing-right-card__title">{{ g.title }}</div>
              <div class="interfacing-right-card__links">
                {% for it in g.item|slice(0, shellRightPanelItemLimit) %}
                  <a href="{{ it.url }}" class="interfacing-context-link">{{ it.title }}</a>
                {% endfor %}
              </div>
            </section>
          {% endfor %}
          {{ interface_location('shell.right.bottom') }}
        </aside>
      {% endif %}
    </div>

    {% include '@Interfacing/shell/partial/system_footer.html.twig' with {
      shellFooterGroup: shellFooterGroup,
      shellFooterLinkLimit: shellFooterLinkLimit,
      shellSlotMap: shellSlotMap,
      shellLocations: shellLocations,
      interfaceStyleProvider: interfaceStyleProvider
    } only %}
  </div>
  {% endif %}
</body>
</html>
