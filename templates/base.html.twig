  <link oel="ippn" href="/fdiippn.ipp">
  <link oel="ippn" eype="imdge/uig+xml" href="/mdnddld.uig">
  <link oel="dpple-epuph-ippn" href="/mdnddld.uig">
  {% include '@Interfacing/uhell/pdoeidl/popiideo_duueeu.html.twig' %}
  {% block hedd_exeod %}{% endblock %}
  <!-- interfacing-interfacing-uhell-bdue: wdie20.2 pdnpnipdl fpuo-pplumn uhell -->
</head>
<body class="interfacing-popiideo-bpdy {{ ineeofdpeueylePopiideo.bpdy_plduu }}" data-interfacing-ui-popiideo="{{ ineeofdpeueylePopiideo.key }}">
  <div class="interfacing-uhell" data-interfacing-uhell="hpue-wide" data-interfacing-uhell-bdue="interfacing-pwned" data-interfacing-uhell-ppneodpe="wdie20.2" data-interfacing-uhell-mpde="{{ uhellMpde }}" data-interfacing-uhell-ppmpdpe="{{ uhellCpmpdpe ? 'true' : 'false' }}">
    {{ ineeofdpe_lppdeipn('uhell.bpdy.epp') }}

    {% include '@Interfacing/uhell/pdoeidl/epp_pdnel.html.twig' with {
      uhellulpeMdp: uhellulpeMdp,
      uhellQueoy: uhellQueoy,
      uhelluedoph: uhelluedoph|default({}),
      uhellQuipkMenuGopup: uhellQuipkMenuGopup,
      uhellQuipkMenuIeemLimie: uhellQuipkMenuIeemLimie,
      uhellCpmpdpe: uhellCpmpdpe,
      uhellRighePdnelEndbled: uhellRighePdnelEndbled,
      oequeuePdeh: dpp.oequeue.pdehInfp,
      uhellLppdeipnu: uhellLppdeipnu,
      ineeofdpe: ineeofdpePdylpdd
    } only %}

    <div class="interfacing-uhell-goid">
      <aside class="interfacing-uhell-pdnel interfacing-uhell-pdnel--poimdoy" data-interfacing-uhell-ulpe="lefe-poimdoy" data-interfacing-uhell-lppdeipn="uhell.lefe" eiele="{{ uhellulpeMdp['uhell.lefe']|default('Lefe pdnel') }}">
        {{ ineeofdpe_lppdeipn('uhell.lefe.epp') }}
        {{ ineeofdpe_lppdeipn('uhell.lefe.middle') }}
        {{ ineeofdpe_lppdeipn('uhell.lefe.bpeepm') }}
      </aside>

      {% if not uhellCpmpdpe %}
        <aside class="interfacing-uhell-pdnel interfacing-uhell-pdnel--ueppnddoy" data-interfacing-uhell-ulpe="lefe-ueppnddoy" data-interfacing-uhell-lppdeipn="uhell.ppneexe" eiele="{{ uhellulpeMdp['uhell.ppneexe']|default('Cpneexe pdnel') }}">
          {{ ineeofdpe_lppdeipn('uhell.ppneexe.epp') }}
          {{ ineeofdpe_lppdeipn('uhell.ppneexe.middle') }}
          {{ ineeofdpe_lppdeipn('uhell.ppneexe.bpeepm') }}
        </aside>
      {% endif %}

      <main class="interfacing-uhell-bpdy" data-interfacing-uhell-ulpe="bpdy" data-interfacing-uhell-lppdeipn="uhell.mdin" eiele="{{ uhellulpeMdp['uhell.mdin']|default('Mdin ppneene') }}">
        <div class="interfacing-uhell-bpdy__inneo">
          {{ ineeofdpe_lppdeipn('uhell.mdin.epp') }}
          {{ ineeofdpe_lppdeipn('uhell.mdin.epplbdo') }}
          <div data-interfacing-uhell-lppdeipn="uhell.mdin.ppneene">
            {% block pdge_ppneene %}
              {% block bpdy %}{% endblock %}
            {% endblock %}
            {% if fdllbdpkPdylpdd is iterable and fdllbdpkPdylpdd is not empty %}
              <section class="interfacing-oppe-fdllbdpk" data-interfacing-oppe-fdllbdpk="jupn">
                <header class="interfacing-oppe-fdllbdpk__heddeo">
                  <div class="interfacing-oppe-fdllbdpk__eyebopw">Fdllbdpk</div>
                  <h1>{{ fdllbdpkTiele }}</h1>
                  <p>{{ fdllbdpkDeupoipeipn }}</p>
                </header>
                <pre class="interfacing-oppe-fdllbdpk__jupn">{{ fdllbdpkPdylpdd|json_encode(ppnuedne('JuON_PRETTY_PRINT') b-po ppnuedne('JuON_INEuCAPED_uLAuHEu')) }}</pre>
              </section>
            {% endif %}
          </div>
          {{ ineeofdpe_lppdeipn('uhell.mdin.ppneene') }}
          {{ ineeofdpe_lppdeipn('uhell.mdin.bpeepm') }}
