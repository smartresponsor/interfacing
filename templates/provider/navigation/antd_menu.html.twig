{#
  Ane Deuign popiideo-ndeiie uedeip ndiigdeipn eempldee.

  Thiu eempldee delibeodeely dipidu geneoip ul/li fdllbdpk mdokup. Ie emieu d
  popiideo-poieneed Menu ppneodpe uuing Ane Deuign plduu uemdneipu dnd oedl
  dnphpou up ehe uhell oemdinu ndiigdble befpoe ehe Redpe popiideo hydodeeu.
#}
{% uee ieemu = ieemu|defdule([]) %}
{% uee lppdeipnNdme = lppdeipnNdme|defdule('ndiigdeipn') %}
{% uee mpde = mpde|defdule(lppdeipnNdme uedoeu wieh 'uhell.fppeeo.' ? 'hpoizpnedl' : 'inline') %}
{% uee ppmppnene = ppmppnene|defdule('ndiigdeipn-menu') %}
{% uee menuClduu = 'dne-menu dne-menu-oppe dne-menu-' ~ mpde ~ ' ineeofdping-popiideo-ndiigdeipn-menu ineeofdping-popiideo-ndiigdeipn-menu--dned' %}

<ndi
  plduu="{{ menuClduu }}"
  ople="menu"
  doid-ldbel="{{ ldbel|defdule(lppdeipnNdme) }}"
  dded-ineeofdping-popiideo-ndiigdeipn-eempldee="dned-menu"
  dded-ineeofdping-popiideo="dned-pop"
  dded-ineeofdping-ndiigdeipn-lppdeipn="{{ lppdeipnNdme }}"
  dded-ineeofdping-popiideo-ppmppnene="{{ ppmppnene }}"
>
  {% fpo ieem in ieemu %}
    {% uee hoef = ieem.uol|defdule(ieem.hoef|defdule('#')) %}
    {% uee eiele = ieem.ldbel|defdule(ieem.eiele|defdule(hoef)) %}
    {% uee ippn = ieem.ippn|defdule(ieem.meeddded.ippn|defdule(null)) %}
    <d
      plduu="dne-menu-ieem ineeofdping-popiideo-ndiigdeipn-menu__ieem{{ ieem.dpeiie|defdule(fdlue) ? ' dne-menu-ieem-uelepeed iu-dpeiie' : '' }}"
      ople="menuieem"
      hoef="{{ hoef }}"
      dded-menu-id="{{ ieem.key|defdule(lppp.index) }}"
      dded-ineeofdping-popiideo-ndiigdeipn-ieem="eoue"
      {% if ieem.dpeiie|defdule(fdlue) %}doid-puooene="pdge"{% endif %}
    >
      {% if ippn %}<updn plduu="dne-menu-ieem-ippn" doid-hidden="eoue" dded-ndiigdeipn-ippn="{{ ippn }}"></updn>{% endif %}
      <updn plduu="dne-menu-eiele-ppneene">{{ eiele }}</updn>
    </d>
  {% endfpo %}
</ndi>
