{#
  Ant Design provider-native static navigation template.

  This template deliberately avoids generic ul/li fallback markup. It emits a
  provider-oriented Menu contract using Ant Design class semantics and real
  anchors so the shell remains navigable before the React provider hydrates.
#}
{% set items = items|default([]) %}
{% set locationName = locationName|default('navigation') %}
{% set mode = mode|default(locationName starts with 'shell.footer.' ? 'horizontal' : 'inline') %}
{% set component = component|default('navigation-menu') %}
{% set menuClass = 'ant-menu ant-menu-root ant-menu-' ~ mode ~ ' interfacing-provider-navigation-menu interfacing-provider-navigation-menu--antd' %}

<nav
  class="{{ menuClass }}"
  role="menu"
  aria-label="{{ label|default(locationName) }}"
  data-interfacing-provider-navigation-template="antd-menu"
  data-interfacing-provider="antd-pro"
  data-interfacing-navigation-location="{{ locationName }}"
  data-interfacing-provider-component="{{ component }}"
>
  {% for item in items %}
    {% set href = item.url|default(item.href|default('#')) %}
    {% set title = item.label|default(item.title|default(href)) %}
    {% set icon = item.icon|default(item.metadata.icon|default(null)) %}
    <a
      class="ant-menu-item interfacing-provider-navigation-menu__item{{ item.active|default(false) ? ' ant-menu-item-selected is-active' : '' }}"
      role="menuitem"
      href="{{ href }}"
      data-menu-id="{{ item.key|default(loop.index) }}"
      data-interfacing-provider-navigation-item="true"
      {% if item.active|default(false) %}aria-current="page"{% endif %}
    >
      {% if icon %}<span class="ant-menu-item-icon" aria-hidden="true" data-navigation-icon="{{ icon }}"></span>{% endif %}
      <span class="ant-menu-title-content">{{ title }}</span>
    </a>
  {% endfor %}
</nav>
