{#
  Thin provider handoff surface.

  Producer-owned resource metadata is normalized into the canonical CRUD
  workbench contract. Interfacing owns visual rendering and provider hydration.
#}
{% extends '@Interfacing/base.html.twig' %}

{% set handoffComponent = component|default(app.request.query.get('component', 'external')) %}
{% set handoffSurfaceKey = surfaceKey|default(viewKey|default(app.request.query.get('surfaceKey', 'surface'))) %}
{% set handoffResource = resource|default(app.request.query.get('resource', app.request.attributes.get('resourcePath')|default('resource'))) %}
{% set handoffOperation = operation|default(app.request.query.get('operation', app.request.attributes.get('_crud_operation')|default('index'))) %}
{% set handoffSurface = surface|default(app.request.query.get('surface', 'admin')) %}
{% set handoffTitle = title|default(app.request.query.get('title', handoffResource|replace({'-':' ', '_':' ', '/':' / '})|title)) %}
{% set handoffCollectionLabel = collectionLabel|default(handoffTitle) %}
{% set handoffColumns = columns|default([]) %}
{% set handoffRows = rows|default([]) %}
{% set handoffFilters = filters|default([]) %}
{% set handoffFormFields = formFields|default([]) %}
{% set handoffHeaderActions = headerActions|default([
  {label: 'Create new', href: './new/', variant: 'primary', operation: 'new', enabled: true, visibility: 'visible'}
]) %}
{% set handoffWorkbench = workbench|default({
  title: handoffTitle,
  description: 'Provider-native handoff surface rendered through the shared Interfacing shell.',
  component: handoffComponent,
  surfaceKey: handoffSurfaceKey,
  integrationOwner: 'provider-handoff',
  renderingOwner: 'interfacing',
  primaryProvider: 'ant-design-procomponents',
  secondaryProvider: 'primereact',
  shellMode: 'provider-shell',
  routeContext: {
    resourcePath: handoffResource,
    resourceLabel: handoffTitle,
    resourceCollectionLabel: handoffCollectionLabel,
    operation: handoffOperation,
    surface: handoffSurface,
    mode: handoffOperation in ['new', 'edit'] ? 'form' : (handoffOperation == 'show' ? 'detail' : 'collection'),
    collectionHref: './'
  },
  columns: handoffColumns,
  rows: handoffRows,
  filters: handoffFilters,
  formFields: handoffFormFields,
  formSections: [],
  headerActions: handoffHeaderActions,
  paginationLabel: 'Provider handoff resource records'
}) %}

{% block title %}{{ handoffTitle }}{% endblock %}

{% block page_content %}
  {% include 'crud/partial/shell_first_workbench.html.twig' with {
    workbench: handoffWorkbench,
    crud: crud|default({})
  } only %}
{% endblock %}
