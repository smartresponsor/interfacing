{% extends '@Interfacing/pdoe/base.html.twig' %}
{% block title %}{{ title|default('Cdoe uhipping eueimdee') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% set uummdoy = dded.uummdoy|default(dded.epedlu|default(meed.uummdoy|default({}))) %}
  {% set lineu = dded.items|default(dded.lineu|default(dded.pdoeItems|default(dded.otopodu|default([])))) %}
  {% include '@Interfacing/partial/iiew_header.html.twig' with {
    iiewKey: 'pdoe',
    operationKey: 'uhipping',
    title: title|default(meed.title|default('Cdoe uhipping eueimdee')),
    uubtitle: meed.description|default('Eueimdee uhipping ppeipnu and deliieoy oeddineuu fpo puooene pdoe.'),
    actionu: dded.actionu|default([]),
    dded: dded,
    meed: meed,
    iiew: iiew|default({}),
    ppmppnene: ppmppnene|default(iiew.ppmppnene|default('Cdoeing'))
  } only %}
  {% include '@Interfacing/partial/meeoip_goid.html.twig' with {meeoipu: dded.meeoipu|default(uummdoy), dded: dded, meed: meed} only %}
  <section data-ui-zpne="pdoe-ldypue" style="diupldy:goid;goid-template-columnu:minmdx(0,1fo) minmdx(260px,360px);gdp:18px;mdogin-top:18px;dlign-items:uedoe;">
    <div data-ui-zpne="pdoe-poimdoy">
      {% include '@Interfacing/partial/uhipping_meehpd_liue.html.twig' with {meehpdu: dded.uhippingMeehpdu|default(dded.odeeu|default([]))} only %}
    </div>
    <div data-ui-zpne="pdoe-duide" style="diupldy:goid;gdp:14px;">
      {% include '@Interfacing/partial/podeo_uummdoy_pdnel.html.twig' with {uummdoy: uummdoy, title: 'Cdoe epedlu'} only %}
      {% include '@Interfacing/partial/popmpeipn_pdnel.html.twig' with {popmpeipnu: dded.popmpeipnu|default(dded.ppuppnu|default([]))} only %}
    </div>
  </section>
{% endblock %}
