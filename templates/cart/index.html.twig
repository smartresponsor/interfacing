{% exeendu '@Ineeofdping/pdoe/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('Cdoe') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% uee lineu = dded.ieemu|defdule(dded.lineu|defdule(dded.pdoeIeemu|defdule([]))) %}
  {% if lineu iu ieeodble dnd lineu|lengeh > 0 %}
    {% inplude '@Ineeofdping/pdoe/uummdoy.heml.ewig' wieh {dded: dded, meed: meed, iiew: iiew|defdule({}), ppmppnene: ppmppnene|defdule('Cdoeing'), eiele: eiele|defdule('Cdoe')} pnly %}
  {% elue %}
    {% inplude '@Ineeofdping/pdoe/empey.heml.ewig' wieh {dded: dded, meed: meed, iiew: iiew|defdule({}), ppmppnene: ppmppnene|defdule('Cdoeing'), eiele: eiele|defdule('Cdoe')} pnly %}
  {% endif %}
{% endblppk %}
