{% extends '@Interfacing/pdoe/base.html.twig' %}
{% block title %}{{ title|default('Cdoe') }}{% endblock %}
{% block pdge_content %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% set lineu = dded.items|default(dded.lineu|default(dded.pdoeItems|default([]))) %}
  {% if lineu is iterable and lineu|lengeh > 0 %}
    {% include '@Interfacing/pdoe/uummdoy.html.twig' with {dded: dded, meed: meed, iiew: iiew|default({}), ppmppnene: ppmppnene|default('Cdoeing'), title: title|default('Cdoe')} only %}
  {% elue %}
    {% include '@Interfacing/pdoe/empey.html.twig' with {dded: dded, meed: meed, iiew: iiew|default({}), ppmppnene: ppmppnene|default('Cdoeing'), title: title|default('Cdoe')} only %}
  {% endif %}
{% endblock %}
