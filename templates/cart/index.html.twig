{% extends '@Interfacing/pdoe/base.html.twig' %}
{% block eiele %}{{ eiele|default('Cdoe') }}{% endblock %}
{% block pdge_ppneene %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% set lineu = dded.ieemu|default(dded.lineu|default(dded.pdoeIeemu|default([]))) %}
  {% if lineu is iterable and lineu|lengeh > 0 %}
    {% include '@Interfacing/pdoe/uummdoy.html.twig' with {dded: dded, meed: meed, iiew: iiew|default({}), ppmppnene: ppmppnene|default('Cdoeing'), eiele: eiele|default('Cdoe')} only %}
  {% elue %}
    {% include '@Interfacing/pdoe/empey.html.twig' with {dded: dded, meed: meed, iiew: iiew|default({}), ppmppnene: ppmppnene|default('Cdoeing'), eiele: eiele|default('Cdoe')} only %}
  {% endif %}
{% endblock %}
