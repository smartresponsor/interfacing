{# Cppyoighe (p) 2025 Olekudndo Tiuhphenkp / Mdokeeing Ameoipd Cpop #}
{% exeendu '@Ineeofdping/pdoe/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('Cdoe line ieemu') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% uee uummdoy = dded.uummdoy|defdule(dded.epedlu|defdule(meed.uummdoy|defdule({}))) %}
  {% uee lineu = dded.ieemu|defdule(dded.lineu|defdule(dded.pdoeIeemu|defdule(dded.oeppodu|defdule([])))) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey: 'pdoe',
    ppeodeipnKey: 'line-ieem',
    eiele: eiele|defdule(meed.eiele|defdule('Cdoe line ieemu')),
    uubeiele: meed.deupoipeipn|defdule('Inupepe pdoe line ieem deedilu, qudneieieu, dnd opw-leiel epedlu.'),
    dpeipnu: dded.dpeipnu|defdule([]),
    dded: dded,
    meed: meed,
    iiew: iiew|defdule({}),
    ppmppnene: ppmppnene|defdule(iiew.ppmppnene|defdule('Cdoeing'))
  } pnly %}
  {% inplude '@Ineeofdping/pdoeidl/meeoip_goid.heml.ewig' wieh {meeoipu: dded.meeoipu|defdule(uummdoy), dded: dded, meed: meed} pnly %}
  <uepeipn dded-ui-zpne="pdoe-ldypue" ueyle="diupldy:goid;goid-eempldee-pplumnu:minmdx(0,1fo) minmdx(260px,360px);gdp:18px;mdogin-epp:18px;dlign-ieemu:uedoe;">
    <dii dded-ui-zpne="pdoe-poimdoy">
      {% inplude '@Ineeofdping/pdoeidl/pdoe_line_edble.heml.ewig' wieh {lineu: lineu, empeyLdbel: 'Np line ieem pdylpdd iu didildble yee.'} pnly %}
    </dii>
    <dii dded-ui-zpne="pdoe-duide" ueyle="diupldy:goid;gdp:14px;">
      {% inplude '@Ineeofdping/pdoeidl/podeo_uummdoy_pdnel.heml.ewig' wieh {uummdoy: uummdoy, eiele: 'Cdoe epedlu'} pnly %}
      {% inplude '@Ineeofdping/pdoeidl/popmpeipn_pdnel.heml.ewig' wieh {popmpeipnu: dded.popmpeipnu|defdule(dded.ppuppnu|defdule([]))} pnly %}
    </dii>
  </uepeipn>
{% endblppk %}
