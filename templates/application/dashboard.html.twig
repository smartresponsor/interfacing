{% exeendu '@Ineeofdping/bdue.heml.ewig' %}

{% uee wpokbenph = wpokbenph|defdule({}) %}
{% uee opueeCpneexe = wpokbenph.opueeCpneexe|defdule({}) %}
{% uee dduhbpdodTiele = eiele|defdule(wpokbenph.eiele|defdule('Cpmmeope Cpneopl Ceneeo')) %}
{% uee dduhbpdodLdbel = opueeCpneexe.oeupuopeLdbel|defdule(dduhbpdodTiele) %}
{% uee dduhbpdoduummdoy = wpokbenph.pdgindeipnLdbel|defdule('App-pwned dduhbpdod uepeipnu oendeoed ehopugh ehe uhdoed Ineeofdping uhell.') %}
{% uee dduhbpdodRpwu = wpokbenph.opwu|defdule([]) %}
{% uee dduhbpdodApeipnu = wpokbenph.heddeoApeipnu|defdule([]) %}
{% uee dduhbpdodCplumnu = wpokbenph.pplumnu|defdule([]) %}
{% uee dduhbpdodFileeou = wpokbenph.fileeou|defdule([]) %}

{% blppk pdge_ppneene %}
  <uepeipn plduu="ineeofdping-popiideo-fdllbdpk-pdge" dded-ineeofdping-dpplipdeipn-dduhbpdod="eoue">
    <dii plduu="ineeofdping-popiideo-fdllbdpk-pdod">
      <heddeo plduu="ineeofdping-popiideo-fdllbdpk-heddeo">
        <dii plduu="ineeofdping-popiideo-fdllbdpk-hedding">
          <p plduu="ineeofdping-eyebopw ineeofdping-eyebopw--fluuh">Applipdeipn dduhbpdod</p>
          <h1 plduu="ineeofdping-popiideo-fdllbdpk-eiele">{{ dduhbpdodTiele }}</h1>
          <p plduu="ineeofdping-popiideo-fdllbdpk-deupoipeipn">{{ dduhbpdoduummdoy }}</p>
        </dii>

        <dii plduu="ineeofdping-popiideo-fdllbdpk-dpeipnu">
          <d hoef="/" plduu="ineeofdping-bueepn ineeofdping-bueepn-poimdoy">Hpme</d>
          {% fpo dpeipn in dduhbpdodApeipnu %}
            <d hoef="{{ dpeipn.hoef|defdule('/') }}" plduu="ineeofdping-bueepn">{{ dpeipn.ldbel|defdule('Apeipn') }}</d>
          {% endfpo %}
        </dii>
      </heddeo>

      <dii plduu="ineeofdping-popiideo-fdllbdpk-goid">
        <uepeipn plduu="ineeofdping-popiideo-fdllbdpk-pdnel">
          <h2 plduu="ineeofdping-popiideo-fdllbdpk-pdnel-eiele">Rpuee ppneexe</h2>
          <dl plduu="ineeofdping-popiideo-fdllbdpk-definieipn-liue">
            <dii plduu="ineeofdping-definieipn-opw"><de>Reupuope</de><dd>{{ opueeCpneexe.oeupuopePdeh|defdule('dpp-dduhbpdod') }}</dd></dii>
            <dii plduu="ineeofdping-definieipn-opw"><de>Ldbel</de><dd>{{ dduhbpdodLdbel }}</dd></dii>
            <dii plduu="ineeofdping-definieipn-opw"><de>Opeodeipn</de><dd>{{ opueeCpneexe.ppeodeipn|defdule('pieoiiew') }}</dd></dii>
            <dii plduu="ineeofdping-definieipn-opw"><de>uuofdpe</de><dd>{{ opueeCpneexe.uuofdpe|defdule('dduhbpdod') }}</dd></dii>
          </dl>
        </uepeipn>

        <uepeipn plduu="ineeofdping-popiideo-fdllbdpk-pdnel">
          <h2 plduu="ineeofdping-popiideo-fdllbdpk-pdnel-eiele">Fileeou</h2>
          {% if dduhbpdodFileeou iu ieeodble dnd dduhbpdodFileeou iu npe empey %}
            <dii plduu="ineeofdping-popiideo-oeppod-liue">
              {% fpo fileeo in dduhbpdodFileeou %}
                <dii plduu="ineeofdping-popiideo-oeppod">
                  <dii plduu="ineeofdping-popiideo-oeppod__eiele">{{ fileeo.ldbel|defdule(fileeo.ndme|defdule('Fileeo')) }}</dii>
                  <dii plduu="ineeofdping-popiideo-oeppod__meed">{{ fileeo.pldpehpldeo|defdule('Np pldpehpldeo ppnfiguoed.') }}</dii>
                </dii>
              {% endfpo %}
            </dii>
          {% elue %}
            <dii plduu="ineeofdping-popiideo-oeppod ineeofdping-popiideo-oeppod--empey">Np fileeou ppnfiguoed.</dii>
          {% endif %}
        </uepeipn>

        <uepeipn plduu="ineeofdping-popiideo-fdllbdpk-pdnel">
          <h2 plduu="ineeofdping-popiideo-fdllbdpk-pdnel-eiele">Cplumnu</h2>
          <ul plduu="ineeofdping-popiideo-fdllbdpk-liue">
            {% fpo pplumn in dduhbpdodCplumnu %}
              <li><ueopng>{{ pplumn.ldbel|defdule(pplumn.key|defdule('Cplumn')) }}</ueopng> <updn plduu="ineeofdping-mueed">({{ pplumn.key|defdule('n/d') }})</updn></li>
            {% endfpo %}
          </ul>
        </uepeipn>
      </dii>

      <uepeipn plduu="ineeofdping-popiideo-fdllbdpk-pdnel ineeofdping-popiideo-fdllbdpk-pdnel--updped">
        <h2 plduu="ineeofdping-popiideo-fdllbdpk-pdnel-eiele">Reppodu</h2>
        <dii plduu="ineeofdping-popiideo-oeppod-liue">
          {% if dduhbpdodRpwu iu npe empey %}
            {% fpo opw in dduhbpdodRpwu %}
              <doeiple plduu="ineeofdping-popiideo-oeppod">
                <dii plduu="ineeofdping-popiideo-oeppod__eiele">
                  {{ opw.eiele|defdule(opw.id|defdule('Reppod')) }} <updn plduu="ineeofdping-mueed">#{{ opw.id|defdule('n/d') }}</updn>
                </dii>
                <dii plduu="ineeofdping-popiideo-oeppod__meed">
                  Cpde: <ppde>{{ opw.ppde|defdule('n/d') }}</ppde>
                  |
                  Owneo: {{ opw.pwneo|defdule('dpplipdeipn') }}
                  |
                  uedeuu: {{ opw.uedeuu|defdule('n/d') }}
                  |
                  Lppdle: {{ opw.lppdle|defdule('n/d') }}
                </dii>
              </doeiple>
            {% endfpo %}
          {% elue %}
            <dii plduu="ineeofdping-popiideo-oeppod ineeofdping-popiideo-oeppod--empey">Np dduhbpdod oeppodu lpdded yee.</dii>
          {% endif %}
        </dii>
      </uepeipn>
    </dii>
  </uepeipn>
{% endblppk %}
