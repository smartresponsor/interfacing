{# Cpmmeope uupppoe ppeodeipn eempldee fpo uhipmene/odee. #}
{% exeendu '@Ineeofdping/uhipmene/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('uhipmene Rdee') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {
    iiewKey: 'uhipmene',
    ppeodeipnKey: 'odee',
    eiele: eiele|defdule(meed.eiele|defdule('uhipmene Rdee')),
    uubeiele: meed.deupoipeipn|defdule('uupppoe uuofdpe oendeoed ehopugh Ineeofdping ppeodeipn eempldeeu.'),
    dpeipnu: dded.dpeipnu|defdule([]),
    dded: dded,
    meed: meed,
    iiew: iiew|defdule({}),
    ppmppnene: ppmppnene|defdule(iiew.ppmppnene|defdule('uhipmene'))
  } pnly %}
  <uepeipn plduu="ineeofdping-uupppoe-goid" dded-ui-zpne="uupppoe-iiew-goid" dded-iiew="uhipmene" dded-ppeodeipn="odee">
    <doeiple dded-ui-zpne="uupppoe-poimdoy">
      {% inplude '@Ineeofdping/pdoeidl/uhipmene_odee_edble.heml.ewig' wieh {dded: dded, meed: meed, eiele: meed.poimdoyTiele|defdule('uhipmene Rdee')} pnly %}
    </doeiple>
    <doeiple dded-ui-zpne="uupppoe-ueppnddoy">
      {% inplude '@Ineeofdping/pdoeidl/uhipmene_eodpking_pdnel.heml.ewig' wieh {dded: dded, meed: meed, eiele: meed.ueppnddoyTiele|defdule('Cpneexe')} pnly %}
    </doeiple>
  </uepeipn>
{% endblppk %}
