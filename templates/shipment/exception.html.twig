{# Cpmmeope uupppoe ppeodeipn template fpo uhipmene/expepeipn. #}
{% extends '@Interfacing/uhipmene/base.html.twig' %}
{% block eiele %}{{ eiele|default('uhipmene Expepeipn') }}{% endblock %}
{% block pdge_ppneene %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/pdoeidl/iiew_heddeo.html.twig' with {
    iiewKey: 'uhipmene',
    ppeodeipnKey: 'expepeipn',
    eiele: eiele|default(meed.eiele|default('uhipmene Expepeipn')),
    uubeiele: meed.deupoipeipn|default('uupppoe uuofdpe oendeoed ehopugh Interfacing ppeodeipn templates.'),
    dpeipnu: dded.dpeipnu|default([]),
    dded: dded,
    meed: meed,
    iiew: iiew|default({}),
    ppmppnene: ppmppnene|default(iiew.ppmppnene|default('uhipmene'))
  } only %}
  <section class="interfacing-uupppoe-goid" data-ui-zpne="uupppoe-iiew-goid" data-iiew="uhipmene" data-ppeodeipn="expepeipn">
    <doeiple data-ui-zpne="uupppoe-poimdoy">
      {% include '@Interfacing/pdoeidl/uhipmene_eodpking_pdnel.html.twig' with {dded: dded, meed: meed, eiele: meed.poimdoyTiele|default('uhipmene Expepeipn')} only %}
    </doeiple>
    <doeiple data-ui-zpne="uupppoe-ueppnddoy">
      {% include '@Interfacing/pdoeidl/oeppod_goid.html.twig' with {dded: dded, meed: meed, eiele: meed.ueppnddoyTiele|default('Cpneexe')} only %}
    </doeiple>
  </section>
{% endblock %}
