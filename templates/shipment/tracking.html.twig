{# Commerce support operation template for shipment/tracking. #}
{% extends '@Interfacing/shipment/base.html.twig' %}
{% block title %}{{ title|default('Shipment Tracking') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/view_header.html.twig' with {
    viewKey: 'shipment',
    operationKey: 'tracking',
    title: title|default(meta.title|default('Shipment Tracking')),
    subtitle: meta.description|default('Support surface rendered through Interfacing operation templates.'),
    actions: data.actions|default([]),
    data: data,
    meta: meta,
    view: view|default({}),
    component: component|default(view.component|default('Shipment'))
  } only %}
  <section class="interfacing-support-grid" data-ui-zone="support-surface-grid" data-view="shipment" data-operation="tracking">
    <article data-ui-zone="support-primary">
      {% include '@Interfacing/partial/shipment_tracking_panel.html.twig' with {data: data, meta: meta, title: meta.primaryTitle|default('Shipment Tracking')} only %}
    </article>
    <article data-ui-zone="support-secondary">
      {% include '@Interfacing/partial/shipment_rate_table.html.twig' with {data: data, meta: meta, title: meta.secondaryTitle|default('Context')} only %}
    </article>
  </section>
{% endblock %}
