<article id="{{ category.id|default('category-card') }}" class="interfacing-category-card">
  <div>
    <div class="interfacing-category-card__visual">
      <div class="interfacing-category-card__visual-title">{{ category.visual|default('Category') }}</div>
    </div>

    <p class="interfacing-card-eyebrow">{{ category.eyebrow|default('Category') }}</p>
    <h3 class="interfacing-card-title">{{ category.title|default('Category') }}</h3>
    <p class="interfacing-card-summary">{{ category.summary|default('Category storefront card') }}</p>
  </div>

  <div class="interfacing-category-card__meta">
    <div class="interfacing-tag-list">
      {% for tag in category.tags|default([]) %}
        <span class="interfacing-tag interfacing-tag--light">{{ tag }}</span>
      {% endfor %}
    </div>

    <div class="interfacing-category-card__footer">
      <div>
        <div class="interfacing-muted interfacing-text-sm">{{ category.status|default('Available') }}</div>
        <div class="interfacing-strong">{{ category.itemCount|default('0 items') }}</div>
      </div>
      <a href="{{ category.href|default('#') }}" class="interfacing-card-action">Open</a>
    </div>
  </div>
</article>
