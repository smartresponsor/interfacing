{% extends '@Interfacing/catalog/base.html.twig' %}
{% block title %}{{ title|default('Catalog merchandising') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/workbench.html.twig' with {
    surfaceKey: 'catalog',
    operationKey: 'merchandising',
    title: title|default(meta.title|default('Catalog merchandising')),
    subtitle: meta.description|default('Catalog merchandising surface for commerce workflows rendered through Viewing.'),
    primaryTitle: meta.primaryTitle|default('Catalog merchandising records'),
    primaryRecords: data.categories|default(data.items|default(data.records|default([]))),
    primaryEmptyLabel: 'No catalog merchandising records are available yet.',
    secondaryTitle: meta.secondaryTitle|default('Surface context'),
    secondaryRecord: data.context|default(data.detail|default(data.summary|default(meta|default({})))),
    metrics: data.metrics|default(data.summary|default({})),
    actions: data.actions|default([]),
    data: data,
    meta: meta,
    view: view|default({}),
    component: component|default(view.component|default('Commerce'))
  } only %}
{% endblock %}
