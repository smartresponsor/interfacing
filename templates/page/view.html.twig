{% extends '@Interfacing/page/base.html.twig' %}
{% set fallbackPayload = {} %}

{% block title %}{{ view.title|default('Page') }}{% endblock %}

{% block page_content %}
  <article class="interfacing-surface interfacing-surface--page-view" data-interfacing-surface="page" data-page-code="{{ view.code|default('') }}" data-page-version="{{ view.version|default('') }}">
    <header class="interfacing-surface__header">
      <p class="interfacing-surface__eyebrow">Paging</p>
      <h1>{{ view.title|default('Page') }}</h1>
      {% if view.publishedAt|default(null) %}
        <p class="page-view__meta">Last updated: {{ view.publishedAt|date('F j, Y') }}</p>
      {% endif %}
      {% if view.effectiveFrom|default(null) %}
        <p class="page-view__meta">Effective from: {{ view.effectiveFrom|date('F j, Y') }}</p>
      {% endif %}
    </header>

    <section class="interfacing-surface__panel page-view__body">
      {{ view.bodyHtml|default('')|raw }}
    </section>
  </article>
{% endblock %}
