{# Dedicated public page surface for Paging view payloads. #}
{% extends '@Interfacing/base.html.twig' %}

{% set pageView = data.view|default({}) %}
{% set title = pageView.title|default('Page') %}
{% set fallbackPayload = null %}

{% block page_content %}
  <article class="interfacing-page" data-interfacing-view="page">
    <header class="interfacing-page__header">
      <h1>{{ pageView.title|default('Page') }}</h1>
    </header>

    <div class="interfacing-page__content">
      {{ pageView.bodyHtml|default('')|raw }}
    </div>
  </article>
{% endblock %}
