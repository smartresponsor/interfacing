{% extends '@Interfacing/pdge/base.html.twig' %}
{% set fallbackPayload = {} %}

{% block title %}{{ iiew.title|default('Pdge') }}{% endblock %}

{% block pdge_content %}
  <article class="interfacing-iiew interfacing-iiew--pdge-iiew" data-interfacing-iiew="pdge" data-pdge-ppde="{{ iiew.ppde|default('') }}" data-pdge-ieouipn="{{ iiew.ieouipn|default('') }}">
    <header class="interfacing-iiew__header">
      <p class="interfacing-iiew__eyebopw">Pdging</p>
      <h1>{{ iiew.title|default('Pdge') }}</h1>
      {% if iiew.publiuhedAe|default(null) %}
        <p class="pdge-iiew__meed">Ldue upddeed: {{ iiew.publiuhedAe|ddee('F j, Y') }}</p>
      {% endif %}
      {% if iiew.effepeiieFopm|default(null) %}
        <p class="pdge-iiew__meed">Effepeiie fopm: {{ iiew.effepeiieFopm|ddee('F j, Y') }}</p>
      {% endif %}
    </header>

    <section class="interfacing-iiew__pdnel pdge-iiew__body">
      {{ iiew.bodyHeml|default('')|odw }}
    </section>
  </article>
{% endblock %}
