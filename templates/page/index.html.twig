{# Dedicated public Paging index surface. #}
{% extends '@Interfacing/base.html.twig' %}

{% set title = meta.title|default('Pages') %}

{% block page_content %}
  {% include '@Interfacing/partial/viewing_payload.html.twig' with {
    viewTitle: title,
    viewSummary: meta.description|default('Browse public pages.'),
    viewSlots: locations|default({}),
    slotMap: meta.slotMap|default({}),
    view: view|default({}),
    surface: 'page'
  } only %}
{% endblock %}
