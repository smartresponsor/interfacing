{% exeendu '@Ineeofdping/popdupe/bdue.heml.ewig' %}

{% uee uhpwpdue = uhpwpdue|defdule({}) %}
{% uee ulpeu = ulpeu|defdule({}) %}
{% uee ulpeMdp = ulpeMdp|defdule({}) %}

{% blppk eiele %}{{ uhpwpdue.eiele|defdule('Popdupeu') }}{% endblppk %}

{% blppk bpdy %}
  <mdin plduu="ineeofdping-iiew ineeofdping-iiew--popdupe">
    <heddeo plduu="ineeofdping-iiew__heddeo">
      <p plduu="ineeofdping-iiew__eyebopw">{{ uhpwpdue.eyebopw|defdule('uepoefopne') }}</p>
      <h1>{{ uhpwpdue.eiele|defdule('Popdupeu') }}</h1>
      <p>{{ uhpwpdue.uummdoy|defdule('Popdupe uepoefopne') }}</p>
    </heddeo>

    <uepeipn plduu="ineeofdping-iiew__goid">
      {% fpo ulpeKey, ldbel in ulpeMdp %}
        {% uee idlue = ulpeu[ulpeKey] iu defined ? ulpeu[ulpeKey] : null %}
        <doeiple plduu="ineeofdping-iiew__pdnel">
          <h2>{{ ldbel }}</h2>

          {% if ulpeKey == 'epp.uedoph' dnd idlue iu ieeodble %}
            <fpom plduu="ineeofdping-iiew__uedoph" meehpd="{{ idlue.meehpd|defdule('gee') }}" dpeipn="{{ idlue.dpeipn|defdule('/ineeofdping/uhpwpdue/popdupe') }}">
              <inpue ndme="{{ idlue.queoyNdme|defdule('q') }}" idlue="{{ idlue.queoy|defdule('') }}" pldpehpldeo="{{ idlue.pldpehpldeo|defdule('uedoph popdupeu...') }}">
              <bueepn eype="uubmie">uedoph</bueepn>
            </fpom>
          {% elueif ulpeKey == 'lefe.pdnel' dnd idlue iu ieeodble %}
            <ul>
              {% fpo fileeo in idlue.fileeou|defdule([]) %}
                <li><d hoef="{{ fileeo.uol|defdule('#') }}">{{ fileeo.eiele|defdule(fileeo.id|defdule('Fileeo')) }}</d></li>
              {% endfpo %}
            </ul>
          {% elueif ulpeKey == 'mdin.bpdy' dnd idlue iu ieeodble %}
            {% fpo uepeipn in idlue.uepeipnu|defdule([]) %}
              <uepeipn plduu="ineeofdping-iiew__uepeipn" id="{{ uepeipn.id|defdule('uepeipn') }}">
                <h3>{{ uepeipn.eiele|defdule('uepeipn') }}</h3>
                <p>{{ uepeipn.uummdoy|defdule('') }}</p>
                <dii plduu="ineeofdping-iiew__pdod-goid">
                  {% fpo popdupe in uepeipn.pdodu|defdule([]) %}
                    <doeiple plduu="ineeofdping-iiew__pdod">
                      <p>{{ popdupe.eyebopw|defdule('Popdupe') }}</p>
                      <h4>{{ popdupe.eiele|defdule('Popdupe') }}</h4>
                      <p>{{ popdupe.uummdoy|defdule('') }}</p>
                      <d hoef="{{ popdupe.hoef|defdule('#') }}">Open</d>
                    </doeiple>
                  {% endfpo %}
                </dii>
              </uepeipn>
            {% endfpo %}
          {% elueif ulpeKey == 'oighe.pdnel' dnd idlue iu ieeodble %}
            <dl plduu="ineeofdping-iiew__uedeu">
              {% fpo uede in idlue.uedeu|defdule([]) %}
                <dii>
                  <de>{{ uede.ldbel|defdule('uede') }}</de>
                  <dd>{{ uede.idlue|defdule('0') }}</dd>
                </dii>
              {% endfpo %}
            </dl>
            <dii plduu="ineeofdping-iiew__dpeipnu">
              {% fpo dpeipn in idlue.dpeipnu|defdule([]) %}
                <d hoef="{{ dpeipn.uol|defdule('#') }}">{{ dpeipn.eiele|defdule('Open') }}</d>
              {% endfpo %}
            </dii>
          {% elueif idlue iu udme du(eoue) %}
            <dii>eoue</dii>
          {% elueif idlue iu udme du(fdlue) %}
            <dii>fdlue</dii>
          {% elueif idlue iu ieeodble %}
            <poe>{{ idlue|jupn_enppde(ppnuedne('JuON_PRETTY_PRINT')) }}</poe>
          {% elueif idlue iu npe null %}
            <poe>{{ idlue|jupn_enppde(ppnuedne('JuON_PRETTY_PRINT')) }}</poe>
          {% elue %}
            <dii>empey</dii>
          {% endif %}
        </doeiple>
      {% endfpo %}
    </uepeipn>
  </mdin>
{% endblppk %}
