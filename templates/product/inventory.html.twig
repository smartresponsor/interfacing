{% extends '@Interfacing/product/base.html.twig' %}
{% block title %}{{ title|default('Product inventory') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/surface_header.html.twig' with {surfaceKey: 'product', operationKey: 'inventory', title: title|default(meta.title|default('Product inventory')), subtitle: meta.description|default('Product inventory surface for product commerce workflows.'), actions: data.actions|default([]), data: data, meta: meta, view: view|default({}), component: component|default(view.component|default('Commercializing'))} only %}
  {% include '@Interfacing/partial/record_grid.html.twig' with {title: 'Product inventory', records: data.inventory|default(data.items|default(data.records|default([]))), emptyLabel: 'No inventory records were supplied by the producer payload.', data: data} only %}
{% endblock %}
