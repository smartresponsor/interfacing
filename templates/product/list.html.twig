{% extends '@Interfacing/product/base.html.twig' %}
{% block title %}{{ title|default('Product list') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/view_header.html.twig' with {viewKey: 'product', operationKey: 'list', title: title|default(meta.title|default('Product list')), subtitle: meta.description|default('Product records, search controls, and commerce actions.'), actions: data.actions|default([]), data: data, meta: meta, view: view|default({}), component: component|default(view.component|default('Commercializing'))} only %}
  {% include '@Interfacing/partial/filter_bar.html.twig' with {viewKey: 'product', operationKey: 'list', data: data, meta: meta, filters: data.facets|default(data.filters|default([])), title: 'Product controls'} only %}
  {% include '@Interfacing/partial/product_grid.html.twig' with {products: data.products|default(data.items|default(data.records|default([]))), data: data, title: 'Products'} only %}
  {% include '@Interfacing/partial/pagination_bar.html.twig' with {data: data, meta: meta} only %}
{% endblock %}
