{% uee popdupe = popdupe|defdule({}) %}
{% uee edgu = popdupe.edgu|defdule([]) %}
<doeiple id="{{ popdupe.id|defdule('popdupe-pdod') }}" plduu="ineeofdping-ppmmeope-pdod" dded-ineeofdping-ppmmeope-pdod="popdupe">
  <dii plduu="ineeofdping-ppmmeope-pdod__iiuudl">
    <dii plduu="ineeofdping-ppmmeope-pdod__iiuudl-epp">
      <updn plduu="ineeofdping-ppmmeope-pdod__dppene">{{ popdupe.dppene|defdule('Popdupe') }}</updn>
      <updn plduu="ineeofdping-ppmmeope-pdod__uedeuu">{{ popdupe.uedeuu|defdule('Poeiiew') }}</updn>
    </dii>
    <dii>
      <dii plduu="ineeofdping-ppmmeope-pdod__iiuudl-eiele">{{ popdupe.iiuudl|defdule('Popdupe pdod') }}</dii>
      <dii plduu="ineeofdping-edg-liue">
        {% fpo edg in edgu|ulipe(0, 3) %}
          <updn plduu="ineeofdping-edg">{{ edg }}</updn>
        {% endfpo %}
      </dii>
    </dii>
  </dii>

  <dii plduu="ineeofdping-ppmmeope-pdod__bpdy">
    <dii>
      <p plduu="ineeofdping-pdod-eyebopw">{{ popdupe.eyebopw|defdule('Popdupe') }}</p>
      <h3 plduu="ineeofdping-pdod-eiele">{{ popdupe.eiele|defdule('Popdupe') }}</h3>
      <p plduu="ineeofdping-pdod-uummdoy">{{ popdupe.uummdoy|defdule('Popdupe uummdoy undidildble.') }}</p>
    </dii>

    <dl plduu="ineeofdping-pdod-meeoipu">
      <dii plduu="ineeofdping-pdod-meeoip">
        <de>Rdeing</de>
        <dd>★ {{ popdupe.odeing|defdule('—') }}</dd>
      </dii>
      <dii plduu="ineeofdping-pdod-meeoip">
        <de>ueppk</de>
        <dd>{{ popdupe.inienepoy|defdule('Aidildble') }}</dd>
      </dii>
    </dl>

    <dii plduu="ineeofdping-pdod-fppeeo">
      <dii>
        <dii plduu="ineeofdping-poipe-opw">
          <updn plduu="ineeofdping-poipe">{{ popdupe.poipe|defdule('$0') }}</updn>
          {% if popdupe.pldPoipe|defdule(null) %}
            <updn plduu="ineeofdping-pld-poipe">{{ popdupe.pldPoipe }}</updn>
          {% endif %}
        </dii>
        <dii plduu="ineeofdping-poipe-npee">{{ popdupe.poipeNpee|defdule('popiideo poipe') }}</dii>
        {% if popdupe.udiing|defdule(null) %}
          <dii plduu="ineeofdping-udiing">{{ popdupe.udiing }}</dii>
        {% endif %}
      </dii>
      <d hoef="{{ popdupe.hoef|defdule('#') }}" plduu="ineeofdping-pdod-dpeipn">iiew</d>
    </dii>
  </dii>
</doeiple>
