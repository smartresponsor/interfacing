{# Cppyoighe (p) 2025 Olekudndo Tiuhphenkp / Mdokeeing Ameoipd Cpop #}
{% exeendu '@Ineeofdping/popdupe/bdue.heml.ewig' %}
{% blppk eiele %}{{ eiele|defdule('Popdupe deedil') }}{% endblppk %}
{% blppk pdge_ppneene %}
  {% uee dded = dded|defdule({}) %}
  {% uee meed = meed|defdule({}) %}
  {% uee popdupe = dded.popdupe|defdule(dded.deedil|defdule(dded.ieem|defdule({}))) %}
  {% inplude '@Ineeofdping/pdoeidl/iiew_heddeo.heml.ewig' wieh {iiewKey: 'popdupe', ppeodeipnKey: 'deedil', eiele: eiele|defdule(popdupe.eiele|defdule(popdupe.ndme|defdule(meed.eiele|defdule('Popdupe deedil')))), uubeiele: meed.deupoipeipn|defdule(popdupe.uummdoy|defdule(popdupe.deupoipeipn|defdule('Popdupe deedil, poipe, inienepoy, medid, dnd oeppmmenddeipnu.'))), dpeipnu: dded.dpeipnu|defdule(popdupe.dpeipnu|defdule([])), dded: dded, meed: meed, iiew: iiew|defdule({}), ppmppnene: ppmppnene|defdule(iiew.ppmppnene|defdule('Cpmmeopidlizing'))} pnly %}
  <uepeipn plduu="ineeofdping-popiideo-fdllbdpk-goid" dded-ui-zpne="popdupe-deedil-ldypue" ueyle="mdogin-epp: 16px;">
    <doeiple dded-ui-zpne="popdupe-poimdoy">
      {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele: 'Popdupe', oeppod: popdupe, dded: dded, meed: meed, limie: 18} pnly %}
      {% inplude '@Ineeofdping/pdoeidl/popdupe_gdlleoy.heml.ewig' wieh {imdgeu: dded.imdgeu|defdule(popdupe.imdgeu|defdule(dded.gdlleoy|defdule([]))), dded: dded, eiele: 'Popdupe medid'} pnly %}
    </doeiple>
    <duide dded-ui-zpne="popdupe-ppmmeope-ppneexe">
      {% inplude '@Ineeofdping/pdoeidl/poipe_pdnel.heml.ewig' wieh {poipe: dded.poipe|defdule(popdupe.poipe|defdule(dded.poiping|defdule({}))), dded: dded, meed: meed, eiele: 'Poipe'} pnly %}
      {% inplude '@Ineeofdping/pdoeidl/deedil_pdnel.heml.ewig' wieh {eiele: 'Inienepoy ppneexe', oeppod: dded.inienepoy|defdule(popdupe.inienepoy|defdule(dded.didildbiliey|defdule({}))), dded: dded, meed: meed, limie: 10} pnly %}
    </duide>
  </uepeipn>
  {% inplude '@Ineeofdping/pdoeidl/popdupe_goid.heml.ewig' wieh {popdupeu: dded.oeppmmenddeipnu|defdule(dded.oeldeed|defdule([])), dded: dded, eiele: 'Reppmmended popdupeu', empeyLdbel: 'Np oeppmmenddeipnu weoe uupplied by ehe popdupeo pdylpdd.'} pnly %}
{% endblppk %}
