{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}Account Overview | {{ accessing_product_name }}{% endblock %}

{% block body %}
  <main class="interfacing-provider-fallback-page" data-interfacing-access-page="account-overview">
    <div class="interfacing-page-toolbar">
      <div>
        <h1>Account overview</h1>
        <p class="interfacing-muted">Registration, trust, recovery, and active session state for {{ account.emailAddress }}.</p>
      </div>
      <a class="interfacing-button interfacing-button--secondary-outline" href="{{ path('accessing_account_password') }}">Change password</a>
    </div>

    <section class="interfacing-stat-grid interfacing-stat-grid--four">
      <article class="interfacing-stat-card"><div class="interfacing-stat-card__label">Email</div><div class="interfacing-stat-card__value">{{ account.emailVerified ? 'Verified' : 'Pending' }}</div></article>
      <article class="interfacing-stat-card"><div class="interfacing-stat-card__label">Phone</div><div class="interfacing-stat-card__value">{{ account.phoneVerified ? 'Verified' : 'Pending' }}</div></article>
      <article class="interfacing-stat-card"><div class="interfacing-stat-card__label">Second factor</div><div class="interfacing-stat-card__value">{{ account.secondFactor and account.secondFactor.enabled ? 'Enabled' : 'Disabled' }}</div></article>
      <article class="interfacing-stat-card"><div class="interfacing-stat-card__label">Current lock state</div><div class="interfacing-stat-card__value">{{ account.locked ? 'Locked' : 'Open' }}</div></article>
    </section>

    <section class="interfacing-content-grid interfacing-content-grid--two interfacing-content-grid--wide-main">
      <article class="interfacing-card">
        <div class="interfacing-card__body interfacing-stack">
          <h2>Lifecycle status</h2>
          <table class="interfacing-table interfacing-table--definition">
            <tbody>
              <tr><th scope="row">Display name</th><td>{{ account.displayName }}</td></tr>
              <tr><th scope="row">Registered</th><td>{{ account.registeredAt|date('Y-m-d H:i') }}</td></tr>
              <tr><th scope="row">Last sign in</th><td>{{ account.lastSignInAt ? account.lastSignInAt|date('Y-m-d H:i') : 'Never' }}</td></tr>
              <tr><th scope="row">Phone number</th><td>{{ account.phoneNumber ?: 'Not provided' }}</td></tr>
              <tr><th scope="row">Recovery codes</th><td>{{ account.recoveryCodes|length }}</td></tr>
              <tr><th scope="row">Tracked sessions</th><td>{{ account.accountSessions|length }}</td></tr>
            </tbody>
          </table>
        </div>
      </article>
      <article class="interfacing-card">
        <div class="interfacing-card__body interfacing-stack">
          <h2>Recent security events</h2>
          <ul class="interfacing-record-list interfacing-record-list--flush">
            {% for event in events %}
              <li class="interfacing-record interfacing-record--flat">
                <div class="interfacing-strong">{{ event.eventType.value }}</div>
                <div class="interfacing-muted interfacing-text-small">{{ event.occurredAt|date('Y-m-d H:i') }}{% if event.ipAddress %} from {{ event.ipAddress }}{% endif %}</div>
              </li>
            {% else %}
              <li class="interfacing-record interfacing-record--flat interfacing-muted">No security events recorded yet.</li>
            {% endfor %}
          </ul>
        </div>
      </article>
    </section>
  </main>
{% endblock %}
