{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}Second Factor Challenge | {{ accessing_product_name }}{% endblock %}

{% block access_body %}
  <div class="interfacing-stack">
    <div class="interfacing-access-heading">
      <h1 id="interfacing-access-title">Second factor challenge</h1>
      <p class="interfacing-muted">Enter the current authenticator code or one of your saved recovery codes for {{ account.emailAddress }}.</p>
    </div>
    {{ form_start(form, { attr: { class: 'interfacing-form' } }) }}
      {{ form_row(form.code) }}
      <button class="interfacing-button interfacing-button--primary" type="submit">Verify second factor</button>
    {{ form_end(form) }}
  </div>
{% endblock %}
