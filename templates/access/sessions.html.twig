{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}Sessions | {{ accessing_product_name }}{% endblock %}

{% block body %}
  <main class="interfacing-provider-fallback-page" data-interfacing-access-page="account-sessions">
    <div class="interfacing-page-toolbar">
      <div>
        <h1>Tracked sessions</h1>
        <p class="interfacing-muted">Visibility into account session activity and one-click invalidation for other active sessions.</p>
      </div>
      <form method="post" action="{{ path('accessing_sessions_invalidate_others') }}">
        <button class="interfacing-button interfacing-button--danger-outline" type="submit">Invalidate other sessions</button>
      </form>
    </div>

    <section class="interfacing-card interfacing-card--flush">
      <div class="interfacing-table-wrap">
        <table class="interfacing-table interfacing-table--striped">
          <thead>
            <tr>
              <th>Session</th>
              <th>Created</th>
              <th>Last seen</th>
              <th>State</th>
            </tr>
          </thead>
          <tbody>
            {% for session in account.accountSessions %}
              <tr>
                <td>
                  <div>{{ session.ipAddress ?: 'Unknown IP' }}</div>
                  <div class="interfacing-muted interfacing-text-small">{{ session.userAgent ?: 'Unknown agent' }}</div>
                </td>
                <td>{{ session.createdAt|date('Y-m-d H:i') }}</td>
                <td>{{ session.lastSeenAt|date('Y-m-d H:i') }}</td>
                <td>{{ session.active ? 'Active' : 'Invalidated' }}</td>
              </tr>
            {% else %}
              <tr><td colspan="4" class="interfacing-muted">No tracked sessions found.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  </main>
{% endblock %}
