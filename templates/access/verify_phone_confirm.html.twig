{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}Confirm Phone Verification | {{ accessing_product_name }}{% endblock %}

{% block access_body %}
  <div class="interfacing-stack">
    <div class="interfacing-access-heading">
      <h1 id="interfacing-access-title">Confirm phone verification</h1>
    </div>
    {{ form_start(form, { attr: { class: 'interfacing-form' } }) }}
      {{ form_row(form.code) }}
      <button class="interfacing-button interfacing-button--primary" type="submit">Confirm phone ownership</button>
    {{ form_end(form) }}
  </div>
{% endblock %}
