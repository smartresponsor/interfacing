{% extends '@Interfacing/access/base.html.twig' %}

{% block access_body %}
  <div class="interfacing-access-stack">
    <div>
      <p class="interfacing-eyebrow">Account exit</p>
      <h2>You are leaving the workspace</h2>
      <p class="interfacing-muted">This page is a footer-only visual endpoint. The actual logout action should be handled by the access/security component through its own route and CSRF policy.</p>
    </div>

    <div class="interfacing-action-row">
      <a class="interfacing-link-button interfacing-link-button--primary" href="/access/signin">Return to sign in</a>
      <a class="interfacing-link-button" href="/interfacing">Open public workspace</a>
    </div>
  </div>
{% endblock %}
