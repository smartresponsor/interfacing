{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}{{ accessing_product_name }} · New password{% endblock %}

{% block access_body %}
  <div class="interfacing-stack">
    <div class="interfacing-access-heading">
      <h1 id="interfacing-access-title">New password</h1>
      <p class="interfacing-muted">Set a fresh password to complete the recovery flow.</p>
    </div>

    {{ form_start(reset_form, { action: path('accessing_forgot_password_reset_plain'), attr: { class: 'interfacing-form' } }) }}
      {{ form_row(reset_form.plainPassword.first) }}
      {{ form_row(reset_form.plainPassword.second) }}
      <button class="interfacing-button interfacing-button--primary" type="submit">Reset password</button>
    {{ form_end(reset_form) }}
  </div>
{% endblock %}
