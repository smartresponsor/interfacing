{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}Verify Email | {{ accessing_product_name }}{% endblock %}

{% block access_body %}
  <div class="interfacing-stack">
    <div class="interfacing-access-heading">
      <h1 id="interfacing-access-title">Verify email ownership</h1>
      <p class="interfacing-muted">Confirm {{ account.emailAddress }} with the most recent email verification code.</p>
    </div>

    {{ form_start(form, { attr: { class: 'interfacing-form' } }) }}
      {{ form_row(form.code) }}
      <button class="interfacing-button interfacing-button--primary" type="submit">Complete email verification</button>
    {{ form_end(form) }}

    <form method="post" action="{{ path('accessing_verify_email_resend') }}" class="interfacing-form interfacing-form--inline-start">
      <button class="interfacing-button interfacing-button--secondary-outline" type="submit">Resend code</button>
    </form>
  </div>
{% endblock %}
