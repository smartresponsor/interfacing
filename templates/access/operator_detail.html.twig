{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}Operator Account Detail | {{ accessing_product_name }}{% endblock %}

{% block body %}
  <main class="interfacing-provider-fallback-page" data-interfacing-access-page="operator-account-detail">
    <div class="interfacing-page-toolbar">
      <div>
        <a href="{{ path('accessing_operator_accounts') }}">Back to accounts</a>
        <h1>{{ account.emailAddress }}</h1>
      </div>
    </div>

    <section class="interfacing-content-grid interfacing-content-grid--two interfacing-content-grid--wide-secondary">
      <article class="interfacing-card">
        <div class="interfacing-card__body interfacing-stack">
          <h2>Account trust posture</h2>
          <table class="interfacing-table interfacing-table--definition">
            <tbody>
              <tr><th>Display name</th><td>{{ account.displayName }}</td></tr>
              <tr><th>Email verified</th><td>{{ account.emailVerified ? 'Yes' : 'No' }}</td></tr>
              <tr><th>Phone verified</th><td>{{ account.phoneVerified ? 'Yes' : 'No' }}</td></tr>
              <tr><th>Second factor</th><td>{{ account.secondFactor and account.secondFactor.enabled ? 'Enabled' : 'Disabled' }}</td></tr>
              <tr><th>Sessions</th><td>{{ account.accountSessions|length }}</td></tr>
              <tr><th>Recovery codes</th><td>{{ account.recoveryCodes|length }}</td></tr>
            </tbody>
          </table>
        </div>
      </article>
      <article class="interfacing-card">
        <div class="interfacing-card__body interfacing-stack">
          <h2>Recent security events</h2>
          <ul class="interfacing-record-list interfacing-record-list--flush">
            {% for event in events %}
              <li class="interfacing-record interfacing-record--flat">
                <div class="interfacing-strong">{{ event.eventType.value }}</div>
                <div class="interfacing-muted interfacing-text-small">{{ event.occurredAt|date('Y-m-d H:i') }} · {{ event.severity.value }}</div>
              </li>
            {% else %}
              <li class="interfacing-record interfacing-record--flat interfacing-muted">No security events for this account.</li>
            {% endfor %}
          </ul>
        </div>
      </article>
    </section>
  </main>
{% endblock %}
