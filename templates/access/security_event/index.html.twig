{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}{{ accessing_product_name }} · Security events{% endblock %}

{% block body %}
  <main class="interfacing-provider-fallback-page" data-interfacing-access-page="security-events">
    <section class="interfacing-card">
      <div class="interfacing-card__body interfacing-stack">
        <div class="interfacing-page-toolbar interfacing-page-toolbar--flush">
          <div>
            <h1>Security events</h1>
          </div>
          <span class="interfacing-badge">Latest 50</span>
        </div>

        {% if events is empty %}
          <div class="interfacing-alert interfacing-alert--neutral" role="status">No security events recorded yet.</div>
        {% else %}
          <div class="interfacing-table-wrap">
            <table class="interfacing-table">
              <thead>
                <tr>
                  <th>Occurred at</th>
                  <th>Type</th>
                  <th>IP</th>
                </tr>
              </thead>
              <tbody>
                {% for event in events %}
                  <tr>
                    <td>{{ event.occurredAt|date('Y-m-d H:i:s') }}</td>
                    <td><code>{{ event.eventType }}</code></td>
                    <td>{{ event.ipAddress ?: '—' }}</td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
      </div>
    </section>
  </main>
{% endblock %}
