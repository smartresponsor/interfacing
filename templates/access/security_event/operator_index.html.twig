{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}Operator Security Events | {{ accessing_product_name }}{% endblock %}

{% block body %}
  <main class="interfacing-provider-fallback-page" data-interfacing-access-page="operator-security-events">
    <div class="interfacing-page-toolbar">
      <div>
        <a href="{{ path('accessing_operator_accounts') }}">Back to operator accounts</a>
        <h1>Global security events</h1>
      </div>
    </div>

    <section class="interfacing-card interfacing-card--flush">
      <div class="interfacing-table-wrap">
        <table class="interfacing-table interfacing-table--striped">
          <thead>
            <tr>
              <th>Account</th>
              <th>Event</th>
              <th>Severity</th>
              <th>Occurred</th>
            </tr>
          </thead>
          <tbody>
            {% for event in events %}
              <tr>
                <td>{{ event.account ? event.account.emailAddress : 'Unknown' }}</td>
                <td>{{ event.eventType.value }}</td>
                <td>{{ event.severity.value }}</td>
                <td>{{ event.occurredAt|date('Y-m-d H:i') }}</td>
              </tr>
            {% else %}
              <tr><td colspan="4" class="interfacing-muted">No global security events recorded.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  </main>
{% endblock %}
