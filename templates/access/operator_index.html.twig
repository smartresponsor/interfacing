{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}Operator Accounts | {{ accessing_product_name }}{% endblock %}

{% block body %}
  <main class="interfacing-provider-fallback-page" data-interfacing-access-page="operator-accounts">
    <div class="interfacing-page-toolbar">
      <div>
        <h1>Operator account view</h1>
        <p class="interfacing-muted">Support-facing visibility into account trust posture.</p>
      </div>
      <a class="interfacing-button interfacing-button--secondary-outline" href="{{ path('accessing_operator_security_events') }}">Global security events</a>
    </div>

    <section class="interfacing-card interfacing-card--flush">
      <div class="interfacing-table-wrap">
        <table class="interfacing-table interfacing-table--hover">
          <thead>
            <tr>
              <th>Email</th>
              <th>Verification</th>
              <th>Second factor</th>
              <th>Last sign in</th>
            </tr>
          </thead>
          <tbody>
            {% for account in accounts %}
              <tr onclick="location.href='{{ path('accessing_operator_account_detail', {id: account.id}) }}'" class="interfacing-clickable-row">
                <td>{{ account.emailAddress }}</td>
                <td>{{ account.emailVerified ? 'Email ok' : 'Email pending' }} / {{ account.phoneVerified ? 'Phone ok' : 'Phone pending' }}</td>
                <td>{{ account.secondFactor and account.secondFactor.enabled ? 'Enabled' : 'Disabled' }}</td>
                <td>{{ account.lastSignInAt ? account.lastSignInAt|date('Y-m-d H:i') : 'Never' }}</td>
              </tr>
            {% else %}
              <tr><td colspan="4" class="interfacing-muted">No accounts available.</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  </main>
{% endblock %}
