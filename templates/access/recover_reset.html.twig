{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}{{ accessing_product_name }} · Reset password{% endblock %}

{% block access_body %}
  <div class="interfacing-stack">
    <div class="interfacing-access-heading">
      <h1 id="interfacing-access-title">Reset password</h1>
      <p class="interfacing-muted">Complete the recovery flow using the issued email address and recovery code.</p>
    </div>

    {{ form_start(form, { action: path('accessing_recover_reset'), attr: { class: 'interfacing-form' } }) }}
      {{ form_row(form.emailAddress) }}
      {{ form_row(form.code) }}
      {{ form_row(form.newPassword) }}
      <div class="interfacing-action-row interfacing-action-row--between">
        <button class="interfacing-button interfacing-button--primary" type="submit">Reset password</button>
        <a href="/access/signin">Back to sign in</a>
      </div>
    {{ form_end(form) }}
  </div>
{% endblock %}
