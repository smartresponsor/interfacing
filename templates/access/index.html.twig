{% extends '@Interfacing/access/base.html.twig' %}

{% block access_body %}
  <div class="interfacing-access-stack">
    <div>
      <p class="interfacing-eyebrow">Public access</p>
      <h2>Welcome to Smart Responsor</h2>
      <p class="interfacing-muted">Continue with an existing account or create a new one.</p>
