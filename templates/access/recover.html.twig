{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}{{ accessing_product_name }} · Recover access{% endblock %}

{% block access_body %}
  <div class="interfacing-stack">
    <div class="interfacing-access-heading">
      <h1 id="interfacing-access-title">Recover account</h1>
      <p class="interfacing-muted">Request a password recovery code for an existing account.</p>
    </div>

    {{ form_start(form, { action: path('accessing_recover'), attr: { class: 'interfacing-form' } }) }}
      {{ form_row(form.emailAddress) }}
      <div class="interfacing-action-row interfacing-action-row--between">
        <button class="interfacing-button interfacing-button--primary" type="submit">Continue</button>
        <a href="/access/signin">Back to sign in</a>
      </div>
    {{ form_end(form) }}
  </div>
{% endblock %}
