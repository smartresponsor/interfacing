{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}Password | {{ accessing_product_name }}{% endblock %}

{% block access_body %}
  <div class="interfacing-stack">
    <div class="interfacing-access-heading">
      <h1 id="interfacing-access-title">Change password</h1>
    </div>
    {{ form_start(form, { action: path('accessing_account_password'), attr: { class: 'interfacing-form' } }) }}
      {{ form_row(form.currentPassword) }}
      {{ form_row(form.newPassword) }}
      <div class="interfacing-action-row interfacing-action-row--between">
        <button class="interfacing-button interfacing-button--primary" type="submit">Update password</button>
        <a href="{{ path('accessing_home') }}">Back to overview</a>
      </div>
    {{ form_end(form) }}
  </div>
{% endblock %}
