{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}{{ accessing_product_name }} · Forgot password{% endblock %}

{% block access_body %}
  <div class="interfacing-stack">
    <div class="interfacing-access-heading">
      <h1 id="interfacing-access-title">Forgot password</h1>
      <p class="interfacing-muted">Request a password reset link for an existing account.</p>
    </div>

    {{ form_start(request_form, { action: path('accessing_forgot_password'), attr: { class: 'interfacing-form' } }) }}
      {{ form_row(request_form.email) }}
      <button class="interfacing-button interfacing-button--primary" type="submit">Issue recovery code</button>
    {{ form_end(request_form) }}
  </div>
{% endblock %}
