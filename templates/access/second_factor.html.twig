{% extends '@Interfacing/access/base.html.twig' %}

{% block title %}{{ accessing_product_name }} · Second factor{% endblock %}

{% block body %}
  <main class="interfacing-provider-fallback-page" data-interfacing-access-page="second-factor">
    <section class="interfacing-card">
      <div class="interfacing-card__body interfacing-stack">
        <div>
          <h1>Second factor</h1>
          <p class="interfacing-muted">Configure and confirm TOTP for your account.</p>
        </div>

        <dl class="interfacing-definition-grid">
          <div class="interfacing-definition-row"><dt>Account</dt><dd>{{ account.emailAddress }}</dd></div>
          <div class="interfacing-definition-row"><dt>Enabled</dt><dd>{{ enabled ? 'Yes' : 'No' }}</dd></div>
          <div class="interfacing-definition-row"><dt>Secret</dt><dd><code>{{ enrollment ? enrollment.secret : (account.secondFactor ? account.secondFactor.secret : 'Not prepared') }}</code></dd></div>
        </dl>

        <label class="interfacing-form-label" for="provisioning-uri">Provisioning URI</label>
        <textarea id="provisioning-uri" class="interfacing-input" rows="4" readonly>{{ enrollment ? enrollment.provisioningUri : 'Enrollment already enabled.' }}</textarea>

        {% if not enabled %}
          {{ form_start(form, { attr: { class: 'interfacing-form' } }) }}
            {{ form_row(form.code, { label: 'Authenticator code' }) }}
            <button class="interfacing-button interfacing-button--primary" type="submit">Enable second factor</button>
          {{ form_end(form) }}
        {% endif %}

        {% if showRecoveryCodes and enrollment and enrollment.recoveryCodes is not empty %}
          <div class="interfacing-alert interfacing-alert--warning" role="alert">
            Save these recovery codes now. They are shown only once.
          </div>
          <ul class="interfacing-record-list">
            {% for recoveryCode in enrollment.recoveryCodes %}
              <li class="interfacing-record"><code>{{ recoveryCode }}</code></li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if enabled %}
          <form method="post" action="{{ path('accessing_second_factor_disable') }}">
            <button class="interfacing-button interfacing-button--danger-outline" type="submit">Disable second factor</button>
          </form>
        {% endif %}
      </div>
    </section>
  </main>
{% endblock %}
