{# Dedicated Viewing surface for Cruding-backed category collections. #}
{% extends '@Interfacing/base.html.twig' %}

{% set title = meta.title|default('Category') %}

{% block page_content %}
  {% include '@Interfacing/partial/viewing_payload.html.twig' with {
    viewTitle: title,
    viewSummary: meta.description|default('Browse and manage categories.'),
    viewSlots: locations|default({}),
    slotMap: meta.slotMap|default({}),
    view: view|default({}),
    surface: 'category'
  } only %}
{% endblock %}
