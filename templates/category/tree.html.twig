{% extends '@Interfacing/category/base.html.twig' %}
{% block title %}{{ title|default('Category tree') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/surface_header.html.twig' with {surfaceKey: 'category', operationKey: 'tree', title: title|default(meta.title|default('Category tree')), subtitle: meta.description|default('Tree navigation, hierarchy status, and catalog coverage.'), actions: data.actions|default([]), data: data, meta: meta, view: view|default({}), component: component|default(view.component|default('Cataloging'))} only %}
  {% include '@Interfacing/partial/filter_bar.html.twig' with {surfaceKey: 'category', operationKey: 'tree', data: data, meta: meta, filters: data.filters|default([]), title: 'Tree controls'} only %}
  {% include '@Interfacing/partial/category_grid.html.twig' with {categories: data.tree|default(data.categories|default(data.items|default([]))), data: data, title: 'Tree nodes', emptyLabel: 'No category tree nodes were supplied by the producer payload.'} only %}
{% endblock %}
