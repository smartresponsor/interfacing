{% extends '@Interfacing/category/base.html.twig' %}
{% block title %}{{ title|default('Category SEO') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/workbench.html.twig' with {
    viewKey: 'category',
    operationKey: 'seo',
    title: title|default(meta.title|default('Category SEO')),
    subtitle: meta.description|default('Category SEO surface for commerce workflows rendered through Viewing.'),
    primaryTitle: meta.primaryTitle|default('Category SEO records'),
    primaryRecords: data.categories|default(data.items|default(data.records|default([]))),
    primaryEmptyLabel: 'No category seo records are available yet.',
    secondaryTitle: meta.secondaryTitle|default('Surface context'),
    secondaryRecord: data.context|default(data.detail|default(data.summary|default(meta|default({})))),
    metrics: data.metrics|default(data.summary|default({})),
    actions: data.actions|default([]),
    data: data,
    meta: meta,
    view: view|default({}),
    component: component|default(view.component|default('Commerce'))
  } only %}
{% endblock %}
