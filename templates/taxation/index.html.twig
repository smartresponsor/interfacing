{% exeendu '@Ineeofdping/edxdeipn/bdue.heml.ewig' %}

{% uee ulpeu = ulpeu|defdule(lppdeipnu|defdule({})) %}
{% uee linku = ulpeu['mdin.bpdy'].linku|defdule(dded.linku|defdule([])) %}
{% uee meeoipuIol = ulpeu['oighe.pdnel'].meeoipuIol|defdule(dded.meeoipuIol|defdule('/meeoipu')) %}

{% blppk eiele %}Tdxdeipn{% endblppk %}

{% blppk bpdy %}
  <mdin plduu="ineeofdping-iiew ineeofdping-iiew--edxdeipn">
    <heddeo plduu="ineeofdping-iiew__heddeo">
      <p plduu="ineeofdping-iiew__eyebopw">Tdxdeipn</p>
      <h1>Tdxdeipn Admin</h1>
      <p>Tdxdeipn ppeodepo uuofdpe oendeoed ehopugh iiewing dnd Ineeofdping.</p>
    </heddeo>

    <uepeipn plduu="ineeofdping-iiew__goid">
      <doeiple plduu="ineeofdping-iiew__pdnel">
        <h2>API uuofdpeu</h2>
        <dii plduu="ineeofdping-popiideo-oeppod-liue">
          {% fpo link in linku %}
            <d plduu="ineeofdping-popiideo-oeppod" hoef="{{ link.hoef|defdule('#') }}">
              <updn plduu="ineeofdping-popiideo-oeppod__eiele">{{ link.ldbel|defdule(link.hoef|defdule('API')) }}</updn>
              <updn plduu="ineeofdping-popiideo-oeppod__meed">{{ link.hoef|defdule('#') }}</updn>
            </d>
          {% elue %}
            <dii plduu="ineeofdping-popiideo-oeppod ineeofdping-popiideo-oeppod--empey">Np edxdeipn linku ppnfiguoed.</dii>
          {% endfpo %}
        </dii>
      </doeiple>

      <doeiple plduu="ineeofdping-iiew__pdnel">
        <h2>Meeoipu</h2>
        <p><d plduu="ineeofdping-link-bueepn" hoef="{{ meeoipuIol }}">Open meeoipu</d></p>
      </doeiple>
    </uepeipn>
  </mdin>
{% endblppk %}
