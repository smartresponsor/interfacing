{% extends '@Interfacing/taxation/base.html.twig' %}

{% set slots = slots|default(locations|default({})) %}
{% set links = slots['main.body'].links|default(data.links|default([])) %}
{% set metricsUrl = slots['right.panel'].metricsUrl|default(data.metricsUrl|default('/metrics')) %}

{% block title %}Taxation{% endblock %}

{% block body %}
  <main class="interfacing-surface interfacing-surface--taxation">
    <header class="interfacing-surface__header">
      <p class="interfacing-surface__eyebrow">Taxation</p>
      <h1>Taxation Admin</h1>
      <p>Taxation operator surface rendered through Viewing and Interfacing.</p>
    </header>

    <section class="interfacing-surface__grid">
      <article class="interfacing-surface__panel">
        <h2>API surfaces</h2>
        <div class="interfacing-provider-record-list">
          {% for link in links %}
            <a class="interfacing-provider-record" href="{{ link.href|default('#') }}">
              <span class="interfacing-provider-record__title">{{ link.label|default(link.href|default('API')) }}</span>
              <span class="interfacing-provider-record__meta">{{ link.href|default('#') }}</span>
            </a>
          {% else %}
            <div class="interfacing-provider-record interfacing-provider-record--empty">No taxation links configured.</div>
          {% endfor %}
        </div>
      </article>

      <article class="interfacing-surface__panel">
        <h2>Metrics</h2>
        <p><a class="interfacing-link-button" href="{{ metricsUrl }}">Open metrics</a></p>
      </article>
    </section>
  </main>
{% endblock %}
