{% extends '@Interfacing/access/base.html.twig' %}

{% block access_body %}
  <div class="interfacing-access-stack">
    <div>
      <p class="interfacing-eyebrow">Account access</p>
      <h1>Sign in to continue</h1>
      <p class="interfacing-muted">This Interfacing page owns the visual shell only. The actual credential check remains in the Accessing/security component.</p>
    </div>

    <form method="post" action="/access/signin" class="interfacing-form" data-interfacing-access-form="sign-in">
      <label class="interfacing-form-label">Email
        <input name="account_sign_in[emailAddress]" type="email" autocomplete="email" required>
      </label>
      <label class="interfacing-form-label">Password
        <input name="account_sign_in[plainPassword]" type="password" autocomplete="current-password" required>
      </label>
      <div class="interfacing-inline-row">
        <label class="interfacing-inline-check"><input name="account_sign_in[rememberMe]" type="checkbox"> Remember me</label>
        <a href="#reset-password">Forgot password?</a>
      </div>
      <button class="interfacing-button-primary" type="submit">Sign in</button>
    </form>

    <p class="interfacing-muted">New here? <a href="/access/sign-up">Create an account</a>.</p>
  </div>
{% endblock %}
