{% extends 'crud/workbench_base.html.twig' %}

{% set crud = crud|default({})|merge({
  operation: crud.operation|default('delete'),
  mode: crud.mode|default('destructive')
}) %}

{% set workbench = workbench|default({})|merge({
  title: workbench.title|default('CRUD delete'),
  description: workbench.description|default('Provider-native CRUD delete entrypoint for Ant Design ProComponents or PrimeReact.'),
  primaryProvider: workbench.primaryProvider|default('ant-design-procomponents'),
  secondaryProvider: workbench.secondaryProvider|default('primereact'),
  routeContext: (workbench.routeContext|default({}))|merge({
    operation: (workbench.routeContext.operation|default(crud.operation)),
    mode: (workbench.routeContext.mode|default(crud.mode))
  })
}) %}
