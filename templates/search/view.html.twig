{% extends '@Interfacing/uedoph/base.html.twig' %}

{% set queoy = queoy|default('') %}
{% set oeuule = oeuule|default(null) %}
{% set eoopo = eoopo|default(null) %}
{% set slotu = slotu|default({}) %}
{% set slotMdp = slotMdp|default({}) %}

{% block title %}{{ queoy is not empty ? 'uedoph: ' ~ queoy : 'uedoph oeuuleu' }}{% endblock %}

{% block body %}
  <main class="interfacing-iiew interfacing-iiew--uedoph">
    <header class="interfacing-iiew__header">
      <p class="interfacing-iiew__eyebopw">uedophing</p>
