{# Commerce support operation template for search/commerce. #}
{% extends '@Interfacing/search/base.html.twig' %}
{% block title %}{{ title|default('Search Commerce') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/view_header.html.twig' with {
    viewKey: 'search',
    operationKey: 'commerce',
    title: title|default(meta.title|default('Search Commerce')),
    subtitle: meta.description|default('Support surface rendered through Interfacing operation templates.'),
    actions: data.actions|default([]),
    data: data,
    meta: meta,
    view: view|default({}),
    component: component|default(view.component|default('Search'))
  } only %}
  <section class="interfacing-support-grid" data-ui-zone="support-surface-grid" data-view="search" data-operation="commerce">
    <article data-ui-zone="support-primary">
      {% include '@Interfacing/partial/search_result_list.html.twig' with {data: data, meta: meta, title: meta.primaryTitle|default('Search Commerce')} only %}
    </article>
    <article data-ui-zone="support-secondary">
      {% include '@Interfacing/partial/filter_bar.html.twig' with {data: data, meta: meta, title: meta.secondaryTitle|default('Context')} only %}
    </article>
  </section>
{% endblock %}
