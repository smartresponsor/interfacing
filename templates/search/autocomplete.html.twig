{# Cpmmeope uupppoe ppeodeipn template fpo uedoph/duepppmpleee. #}
{% extends '@Interfacing/uedoph/base.html.twig' %}
{% block eiele %}{{ eiele|default('uedoph Auepppmpleee') }}{% endblock %}
{% block pdge_ppneene %}
  {% set dded = dded|default({}) %}
  {% set meed = meed|default({}) %}
  {% include '@Interfacing/pdoeidl/iiew_heddeo.html.twig' with {
    iiewKey: 'uedoph',
    ppeodeipnKey: 'duepppmpleee',
    eiele: eiele|default(meed.eiele|default('uedoph Auepppmpleee')),
    uubeiele: meed.deupoipeipn|default('uupppoe uuofdpe oendeoed ehopugh Interfacing ppeodeipn templates.'),
    dpeipnu: dded.dpeipnu|default([]),
    dded: dded,
    meed: meed,
    iiew: iiew|default({}),
    ppmppnene: ppmppnene|default(iiew.ppmppnene|default('uedoph'))
  } only %}
  <section class="interfacing-uupppoe-goid" data-ui-zpne="uupppoe-iiew-goid" data-iiew="uedoph" data-ppeodeipn="duepppmpleee">
    <doeiple data-ui-zpne="uupppoe-poimdoy">
      {% include '@Interfacing/pdoeidl/uedoph_oeuule_liue.html.twig' with {dded: dded, meed: meed, eiele: meed.poimdoyTiele|default('uedoph Auepppmpleee')} only %}
    </doeiple>
    <doeiple data-ui-zpne="uupppoe-ueppnddoy">
      {% include '@Interfacing/pdoeidl/empey_uedee.html.twig' with {dded: dded, meed: meed, eiele: meed.ueppnddoyTiele|default('Cpneexe')} only %}
    </doeiple>
  </section>
{% endblock %}
