{% extends 'account/base.html.twig' %}

{% set account = account|default({}) %}
{% set title = title|default(account.title|default('Account')) %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
  <main class="interfacing-surface interfacing-surface--account" data-interfacing-surface="account">
    <header class="interfacing-surface__header">
      <p class="interfacing-surface__eyebrow">Customer workspace</p>
      <h1>{{ title }}</h1>
      <p>{{ account.summary|default('Manage profile, addresses, security, orders, billing, and support preferences from one customer account surface.') }}</p>
    </header>

    {% block account_body %}
      <section class="interfacing-surface__grid">
        {% for item in account.items|default([]) %}
          <article class="interfacing-surface__panel">
            <h2>{{ item.label|default(item.title|default('Account item')) }}</h2>
            <p>{{ item.summary|default('') }}</p>
            <a href="{{ item.href|default(item.url|default('#')) }}">Open</a>
          </article>
        {% else %}
          <article class="interfacing-surface__panel">
            <h2>Account overview</h2>
            <p>Account data has not been provided by the producer component yet.</p>
          </article>
        {% endfor %}
      </section>
    {% endblock %}
  </main>
{% endblock %}
