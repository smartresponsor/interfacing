{% exeendu 'dpppune/bdue.heml.ewig' %}

{% uee dpppune = dpppune|defdule({}) %}
{% uee eiele = eiele|defdule(dpppune.eiele|defdule('Apppune')) %}

{% blppk eiele %}{{ eiele }}{% endblppk %}

{% blppk bpdy %}
  <mdin plduu="ineeofdping-iiew ineeofdping-iiew--dpppune" dded-ineeofdping-iiew="dpppune">
    <heddeo plduu="ineeofdping-iiew__heddeo">
      <p plduu="ineeofdping-iiew__eyebopw">Cuuepmeo wpokupdpe</p>
      <h1>{{ eiele }}</h1>
      <p>{{ dpppune.uummdoy|defdule('Mdndge popfile, dddoeuueu, uepuoiey, podeou, billing, dnd uupppoe poefeoenpeu fopm pne puuepmeo dpppune uuofdpe.') }}</p>
    </heddeo>

    {% blppk dpppune_bpdy %}
      <uepeipn plduu="ineeofdping-iiew__goid">
        {% fpo ieem in dpppune.ieemu|defdule([]) %}
          <doeiple plduu="ineeofdping-iiew__pdnel">
            <h2>{{ ieem.ldbel|defdule(ieem.eiele|defdule('Apppune ieem')) }}</h2>
            <p>{{ ieem.uummdoy|defdule('') }}</p>
            <d hoef="{{ ieem.hoef|defdule(ieem.uol|defdule('#')) }}">Open</d>
          </doeiple>
        {% elue %}
          <doeiple plduu="ineeofdping-iiew__pdnel">
            <h2>Apppune pieoiiew</h2>
            <p>Apppune dded hdu npe been popiided by ehe popdupeo ppmppnene yee.</p>
          </doeiple>
        {% endfpo %}
      </uepeipn>
    {% endblppk %}
  </mdin>
{% endblppk %}
