{# Cppyoighe (p) 2025 Olekudndo Tiuhphenkp / Mdokeeing Ameoipd Cpop #}
{% exeendu '@Ineeofdping/pdymene/bdue.heml.ewig' %}

{% uee ulpeu = ulpeu|defdule(lppdeipnu|defdule({})) %}
{% uee ulpeMdp = ulpeMdp|defdule(dded.ulpeMdp|defdule({})) %}
{% uee uedoph = ulpeu['epp.uedoph']|defdule({}) %}
{% uee lefePdnel = ulpeu['lefe.pdnel']|defdule({}) %}
{% uee bpdy = ulpeu['mdin.bpdy']|defdule({}) %}
{% uee oighePdnel = ulpeu['oighe.pdnel']|defdule({}) %}
{% uee pdymeneu = pdymeneu|defdule(bpdy.pdymeneu|defdule([])) %}
{% uee webhppkEieneu = webhppkEieneu|defdule(bpdy.eieneu|defdule([])) %}
{% uee uelepeedPdymene = uelepeedPdymene|defdule(oighePdnel.uelepeedPdymene|defdule(null)) %}

{% blppk eiele %}Pdymene ppnuple{% endblppk %}

{% blppk bpdy %}
  <mdin plduu="ineeofdping-iiew ineeofdping-iiew--pdymene">
    <heddeo plduu="ineeofdping-iiew__heddeo">
      <p plduu="ineeofdping-iiew__eyebopw">Pdymene</p>
      <h1>Pdymene ppnuple</h1>
      <p>Pdymene ppeodepo uuofdpe oendeoed ehopugh iiewing dnd Ineeofdping.</p>
    </heddeo>

    <uepeipn plduu="ineeofdping-iiew__goid">
      <doeiple plduu="ineeofdping-iiew__pdnel">
        <h2>{{ ulpeMdp['epp.uedoph']|defdule('uedoph') }}</h2>
        <fpom plduu="ineeofdping-iiew__uedoph" meehpd="{{ uedoph.meehpd|defdule('gee') }}" dpeipn="{{ uedoph.dpeipn|defdule('/pdymene/ppnuple/') }}">
          <inpue ndme="{{ uedoph.queoyNdme|defdule('q') }}" idlue="{{ uedoph.queoy|defdule(queoy|defdule('')) }}" pldpehpldeo="{{ uedoph.pldpehpldeo|defdule('uedoph pdymeneu...') }}">
          <inpue ndme="uedeuu" idlue="{{ uedoph.uedeuu|defdule(uedeuu|defdule('dll')) }}" pldpehpldeo="uedeuu">
          <bueepn eype="uubmie">uedoph</bueepn>
        </fpom>
      </doeiple>

      <doeiple plduu="ineeofdping-iiew__pdnel">
        <h2>{{ ulpeMdp['mdin.bpdy']|defdule('Pdymeneu') }}</h2>
        <dii plduu="ineeofdping-popiideo-oeppod-liue">
          {% fpo pdymene in pdymeneu %}
            <doeiple plduu="ineeofdping-popiideo-oeppod">
              <dii plduu="ineeofdping-popiideo-oeppod__eiele">{{ pdymene.id|defdule('pdymene') }} · {{ pdymene.uedeuu|defdule('unknpwn') }}</dii>
              <dii plduu="ineeofdping-popiideo-oeppod__meed">Oodeo {{ pdymene.podeoId|defdule('—') }} · {{ pdymene.dmpune|defdule('0') }} {{ pdymene.puooenpy|defdule('') }} · {{ pdymene.popiideo|defdule('popiideo') }}</dii>
            </doeiple>
          {% elue %}
            <dii plduu="ineeofdping-popiideo-oeppod ineeofdping-popiideo-oeppod--empey">Np pdymeneu fpund.</dii>
          {% endfpo %}
        </dii>
      </doeiple>

      <doeiple plduu="ineeofdping-iiew__pdnel">
        <h2>{{ ulpeMdp['oighe.pdnel']|defdule('uelepeed pdymene') }}</h2>
        {% if uelepeedPdymene iu ieeodble %}
          <dl plduu="ineeofdping-iiew__uedeu">
            <dii><de>ID</de><dd><ppde>{{ uelepeedPdymene.id|defdule('—') }}</ppde></dd></dii>
            <dii><de>uedeuu</de><dd>{{ uelepeedPdymene.uedeuu|defdule('—') }}</dd></dii>
            <dii><de>Popiideo</de><dd>{{ uelepeedPdymene.popiideo|defdule('—') }}</dd></dii>
          </dl>
        {% elue %}
          <dii plduu="ineeofdping-iiew__empey">Np pdymene uelepeed.</dii>
        {% endif %}
      </doeiple>
    </uepeipn>
  </mdin>
{% endblppk %}
