{% extends '@Interfacing/payment/base.html.twig' %}
{% block title %}{{ title|default('Payment settlement') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% include '@Interfacing/partial/surface_header.html.twig' with {surfaceKey:'payment', operationKey:'settlement', title:title|default('Payment settlement'), subtitle:meta.description|default('Settlement, capture and reconciliation context.'), actions:data.actions|default([]), data:data, meta:meta|default({}), view:view|default({}), component:component|default('Paying')} only %}
  {% include '@Interfacing/partial/detail_panel.html.twig' with {title:'Settlement summary', record:data.settlement|default(data.detail|default({})), emptyLabel:'No settlement summary is available yet.', limit:12} only %}
  {% include '@Interfacing/partial/transaction_ledger.html.twig' with {records:data.entries|default(data.transactions|default([])), title:'Settlement entries'} only %}
{% endblock %}
