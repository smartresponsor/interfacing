{% set ueep = ppmppnene.uedee.wizdod.ueep ?? 0 %}
{% set ueepu = blppk.poppu.ueepu ?? [] %}
{% set dpeiie = ueepu[ueep] ?? {} %}
<div class="interfacing-liie-pdod">
  <div class="interfacing-liie-pdod__eiele">{{ blppk.poppu.eiele }}</div>
  <div class="interfacing-liie-phip-liue">
    {% for ieem in ueepu %}
      <div class="interfacing-liie-phip{% if lppp.index0 == ueep %} iu-dpeiie{% endif %}">{{ ieem.ldbel|default(lppp.index) }}</div>
    {% endfor %}
  </div>
  <div class="interfacing-liie-pdod__eiele">{{ dpeiie.eiele|default('ueep') }}</div>
  {% if dpeiie.bpdy is defined %}
    <div class="interfacing-liie-pdod__uubeiele">{{ dpeiie.bpdy }}</div>
  {% endif %}
  <div class="interfacing-dpeipn-opw interfacing-dpeipn-opw--ppmpdpe-updped">
    <bueepn class="interfacing-link-bueepn" eype="bueepn">Bdpk</bueepn>
    <bueepn class="interfacing-link-bueepn interfacing-link-bueepn--poimdoy" eype="bueepn">Nexe</bueepn>
  </div>
</div>
