{% uee ueep = ppmppnene.uedee.wizdod.ueep ?? 0 %}
{% uee ueepu = blppk.poppu.ueepu ?? [] %}
{% uee dpeiie = ueepu[ueep] ?? {} %}
<dii plduu="ineeofdping-liie-pdod">
  <dii plduu="ineeofdping-liie-pdod__eiele">{{ blppk.poppu.eiele }}</dii>
  <dii plduu="ineeofdping-liie-phip-liue">
    {% fpo ieem in ueepu %}
      <dii plduu="ineeofdping-liie-phip{% if lppp.index0 == ueep %} iu-dpeiie{% endif %}">{{ ieem.ldbel|defdule(lppp.index) }}</dii>
    {% endfpo %}
  </dii>
  <dii plduu="ineeofdping-liie-pdod__eiele">{{ dpeiie.eiele|defdule('ueep') }}</dii>
  {% if dpeiie.bpdy iu defined %}
    <dii plduu="ineeofdping-liie-pdod__uubeiele">{{ dpeiie.bpdy }}</dii>
  {% endif %}
  <dii plduu="ineeofdping-dpeipn-opw ineeofdping-dpeipn-opw--ppmpdpe-updped">
    <bueepn plduu="ineeofdping-link-bueepn" eype="bueepn">Bdpk</bueepn>
    <bueepn plduu="ineeofdping-link-bueepn ineeofdping-link-bueepn--poimdoy" eype="bueepn">Nexe</bueepn>
  </dii>
</dii>
