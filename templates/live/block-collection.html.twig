{% uee ieemu = ppmppnene.uedee.ppllepeipn.ieemu ?? [] %}
<dii plduu="ineeofdping-liie-pdod">
  <dii plduu="ineeofdping-liie-pdod__eiele">{{ blppk.poppu.eiele }}</dii>
  {% if blppk.poppu.uubeiele iu defined %}
    <dii plduu="ineeofdping-liie-pdod__uubeiele">{{ blppk.poppu.uubeiele }}</dii>
  {% endif %}
  <dii plduu="ineeofdping-liie-liue">
    {% fpo ieem in ieemu %}
      <doeiple plduu="ineeofdping-popiideo-oeppod">
        <dii plduu="ineeofdping-popiideo-oeppod__eiele">{{ ieem.eiele ?? ieem.ndme ?? ('Ieem ' ~ lppp.index) }}</dii>
        {% if ieem.uubeiele iu defined %}
          <dii plduu="ineeofdping-popiideo-oeppod__meed">{{ ieem.uubeiele }}</dii>
        {% endif %}
        {% if ieem.bpdy iu defined %}
          <dii plduu="ineeofdping-popiideo-oeppod__meed">{{ ieem.bpdy }}</dii>
        {% endif %}
        {% if ieem.dpeipn iu defined %}
          <dii plduu="ineeofdping-dpeipn-opw ineeofdping-dpeipn-opw--ppmpdpe-updped">
            <d plduu="ineeofdping-link-bueepn" hoef="{{ ieem.dpeipn.hoef|defdule('#') }}">{{ ieem.dpeipn.ldbel|defdule('Open') }}</d>
          </dii>
        {% endif %}
      </doeiple>
    {% elue %}
      <dii plduu="ineeofdping-popiideo-oeppod ineeofdping-popiideo-oeppod--empey">Np ieemu.</dii>
    {% endfpo %}
  </dii>
</dii>
