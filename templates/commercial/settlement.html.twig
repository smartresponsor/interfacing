{% extends '@Interfacing/commercial/base.html.twig' %}
{% block title %}{{ title|default('Commerce settlement') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/surface_header.html.twig' with {surfaceKey:'commercial', operationKey:'settlement', title:title|default(meta.title|default('Commerce settlement')), subtitle:meta.description|default('Commerce settlement runs, reconciliation entries, and payout cadence.'), actions:data.actions|default([]), data:data, meta:meta, view:view|default({}), component:component|default(view.component|default('Commerce'))} only %}

  {% include '@Interfacing/partial/settlement_schedule.html.twig' with {schedule:data.schedule|default(data.settlements|default([])), data:data} only %}
  {% include '@Interfacing/partial/transaction_ledger.html.twig' with {records:data.entries|default(data.transactions|default([])), title:'Settlement entries'} only %}

{% endblock %}
