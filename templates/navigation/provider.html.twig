{#
  Provider-native navigation mount contract.

  Interfacing owns the mount node and provider schema. Navigating owns the
  filtered navigation payload. Concrete Ant Design / PrimeReact renderers may
  hydrate this mount; the static output is provider-specific and not a generic Twig list fallback.
#}
{% set provider = provider|default('antd-pro') %}
{% set secondaryProvider = secondaryProvider|default('primereact') %}
{% set component = component|default('navigation-menu') %}
{% set navigation = navigation|default({}) %}
{% set locations = locations|default(navigation.locations|default({})) %}
{% set locationName = locationName|default(null) %}
{% set items = items|default(locationName ? locations[locationName]|default([]) : []) %}
{% set schema = {
  schema: 'interfacing.navigation.provider.v1',
  version: '1.0',
  owner: 'interfacing',
  provider: provider,
  secondaryProvider: secondaryProvider,
  component: component,
  surface: 'navigation',
  providerTargets: {
    primary: 'AntDesign.Menu',
    secondary: 'PrimeReact.PanelMenu',
    fallback: null
  },
  navigation: {
    locationName: locationName,
    locations: locationName ? {(locationName): items} : locations,
    active: navigation.active|default({})
  },
  rendering: {
    mode: 'provider-native-only',
    primaryProviderRole: 'contract-business-workbench',
    secondaryProviderRole: 'rich-facade',
    fallbackAllowed: false
  }
} %}

<section
  class="interfacing-navigation-provider"
  data-interfacing-navigation-provider-mount="true"
  data-interfacing-provider="{{ provider }}"
  data-interfacing-secondary-provider="{{ secondaryProvider }}"
  data-interfacing-provider-component="{{ component }}"
  data-interfacing-navigation-location="{{ locationName|default('all') }}"
  data-interfacing-provider-target-primary="AntDesign.Menu"
  data-interfacing-provider-target-secondary="PrimeReact.PanelMenu"
  data-interfacing-provider-fallback="none"
>
  <script type="application/json" data-interfacing-navigation-provider-schema="true">{{ schema|json_encode(constant('JSON_UNESCAPED_SLASHES'))|raw }}</script>
  {% if items is iterable and items is not empty %}
    {% if provider == 'primereact' %}
      {% include '@Interfacing/provider/navigation/primereact_panel_menu.html.twig' with {
        items: items,
        locationName: locationName|default('navigation'),
        component: component,
        label: component
      } only %}
    {% else %}
      {% include '@Interfacing/provider/navigation/antd_menu.html.twig' with {
        items: items,
        locationName: locationName|default('navigation'),
        component: component,
        label: component,
        mode: locationName is not null and locationName starts with 'shell.footer.' ? 'horizontal' : 'inline'
      } only %}
    {% endif %}
  {% endif %}
</section>
