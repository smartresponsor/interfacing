{% extends '@Interfacing/order/base.html.twig' %}
{% block title %}{{ title|default('Order invoice') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% include '@Interfacing/partial/surface_header.html.twig' with {surfaceKey:'order', operationKey:'invoice', title:title|default('Order invoice'), subtitle:meta.description|default('Invoice summary and billing lines for the order.'), actions:data.actions|default([]), data:data, meta:meta|default({}), view:view|default({}), component:component|default('Ordering')} only %}
  {% include '@Interfacing/partial/invoice_panel.html.twig' with {invoice:data.invoice|default(data.detail|default({})), title:'Invoice'} only %}
  {% include '@Interfacing/partial/record_grid.html.twig' with {title:'Invoice lines', records:data.lines|default(data.lineItems|default([])), emptyLabel:'No invoice lines are available yet.', limit:12} only %}
{% endblock %}
