{% extends '@Interfacing/order/base.html.twig' %}
{% block title %}{{ title|default('Order refunds') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% include '@Interfacing/partial/surface_header.html.twig' with {surfaceKey:'order', operationKey:'refund', title:title|default('Order refunds'), subtitle:meta.description|default('Refund requests and refund lifecycle for an order.'), actions:data.actions|default([]), data:data, meta:meta|default({}), view:view|default({}), component:component|default('Ordering')} only %}
  {% include '@Interfacing/partial/refund_panel.html.twig' with {refunds:data.refunds|default(data.records|default([])), title:'Refund history'} only %}
  {% include '@Interfacing/partial/status_timeline.html.twig' with {events:data.timeline|default([]), title:'Refund timeline'} only %}
{% endblock %}
