{% extends '@Interfacing/order/base.html.twig' %}
{% block title %}{{ title|default('Order detail') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set order = data.order|default(data.detail|default({})) %}
  {% include '@Interfacing/partial/view_header.html.twig' with {viewKey:'order', operationKey:'detail', title:title|default('Order detail'), subtitle:meta.description|default('Customer order, lines, payment and fulfillment context.'), actions:data.actions|default([]), data:data, meta:meta|default({}), view:view|default({}), component:component|default('Ordering')} only %}
  <section class="interfacing-provider-fallback-grid" data-ui-zone="order-detail-layout">
    {% include '@Interfacing/partial/detail_panel.html.twig' with {title:'Order summary', record:order, emptyLabel:'No order detail was provided yet.', limit:14} only %}
    {% include '@Interfacing/partial/record_grid.html.twig' with {title:'Line items', records:data.lineItems|default(data.lines|default(data.items|default([]))), emptyLabel:'No line items are available for this order.', limit:12} only %}
    {% include '@Interfacing/partial/payment_status_panel.html.twig' with {payment:data.paymentSummary|default(data.payment|default({})), title:'Payment'} only %}
    {% include '@Interfacing/partial/detail_panel.html.twig' with {title:'Shipment', record:data.shipmentSummary|default(data.shipment|default({})), emptyLabel:'No shipment information is available yet.', limit:10} only %}
  </section>
{% endblock %}
