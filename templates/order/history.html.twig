{% extends '@Interfacing/order/base.html.twig' %}
{% block title %}{{ title|default('Order history') }}{% endblock %}
{% block page_content %}
  {% set data = data|default({}) %}
  {% set meta = meta|default({}) %}
  {% include '@Interfacing/partial/workbench.html.twig' with {
    viewKey: 'order',
    operationKey: 'history',
    title: title|default(meta.title|default('Order history')),
    subtitle: meta.description|default('Order history surface for commerce workflows rendered through Viewing.'),
    primaryTitle: meta.primaryTitle|default('Order history records'),
    primaryRecords: data.orders|default(data.items|default(data.records|default([]))),
    primaryEmptyLabel: 'No order history records are available yet.',
    secondaryTitle: meta.secondaryTitle|default('Surface context'),
    secondaryRecord: data.context|default(data.detail|default(data.summary|default(meta|default({})))),
    metrics: data.metrics|default(data.summary|default({})),
    actions: data.actions|default([]),
    data: data,
    meta: meta,
    view: view|default({}),
    component: component|default(view.component|default('Commerce'))
  } only %}
{% endblock %}
