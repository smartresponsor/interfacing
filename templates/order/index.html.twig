{% extends '@Interfacing/order/base.html.twig' %}

{% set data = data|default({}) %}
{% set meta = meta|default({}) %}
{% set view = view|default({}) %}

{% block title %}{{ title|default(meta.title|default('Order workbench')) }}{% endblock %}

{% block page_content %}
  {% include '@Interfacing/partial/workbench.html.twig' with {
    viewKey: 'order',
    operationKey: operation|default(view.operation|default('index')),
    title: title|default(meta.title|default('Order workbench')),
    subtitle: meta.description|default('Order surface rendered through shared Interfacing partials.'),
    primaryTitle: meta.primaryTitle|default('Orders'),
    primaryRecords: data.items|default(data.records|default(data.rows|default([]))),
    primaryEmptyLabel: 'No orders were found.',
    secondaryTitle: meta.secondaryTitle|default('Order context'),
    secondaryRecord: data.context|default(data.detail|default(data.summary|default(meta))),
    metrics: data.metrics|default(data.summary|default({})),
    actions: data.actions|default([]),
    data: data,
    meta: meta,
    view: view,
    component: component|default(view.component|default('Ordering'))
  } only %}
{% endblock %}
